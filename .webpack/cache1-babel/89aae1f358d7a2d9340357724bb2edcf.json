rd\"));\n        copyButton.setAttribute(\"src\", addon.self.getResource(\"/copy.svg\")) /* rewritten by pull.js */;\n\n        copyButton.classList.add(\"sa-copy-reporter-icon\");\n        addon.tab.displayNoneWhileDisabled(copyButton);\n\n        copyButton.onclick = () => navigator.clipboard.writeText(value);\n        valueReportBox.appendChild(copyButton);\n      }\n    }\n\n    contentDiv.appendChild(valueReportBox);\n    ScratchBlocks.DropDownDiv.setColour(\n      ScratchBlocks.Colours.valueReportBackground,\n      isError \n        ? ScratchBlocks.Colours.blockError \n        : ScratchBlocks.Colours.valueReportBorder\n    );\n    ScratchBlocks.DropDownDiv.showPositionedByBlock(this, block);\n  };\n}\n"],"mappings":"AAAA,eAAe,gBAAAA,IAAA,EAAyC;EAAA,IAAzB;IAAEC,KAAK;IAAEC,OAAO;IAAEC;EAAI,CAAC,GAAAH,IAAA;EACpDC,KAAK,CAACG,GAAG,CAACC,uBAAuB,CAC9BC,GAAG,IAAK;IACP,MAAMC,SAAS,GAAGD,GAAG,CAACE,IAAI,KAAK,eAAe,GAAG,qBAAqB,GAAG,eAAe;IACxF,MAAMC,OAAO,GAAGH,GAAG,CAACI,MAAM,CAACC,aAAa,aAAAC,MAAA,CAAaL,SAAS,QAAK,CAAC;IAEpE,IAAIE,OAAO,CAACI,SAAS,CAACC,MAAM,KAAK,CAAC,EAAE;MAClCC,SAAS,CAACC,SAAS,CAACC,SAAS,CAACR,OAAO,CAACI,SAAS,CAAC;IAClD;EACF,CAAC,EACD;IACEN,SAAS,EAAE,MAAM;IACjBW,KAAK,EAAE,CAAC,iBAAiB,EAAE,eAAe,EAAE,gBAAgB,CAAC;IAC7DC,QAAQ,EAAE,SAAS;IACnBC,KAAK,EAAE,CAAC;IACRC,KAAK,EAAElB,GAAG,CAAC,YAAY;EACzB,CACF,CAAC;;EAED;EACA,MAAMmB,aAAa,GAAG,MAAMrB,KAAK,CAACG,GAAG,CAACmB,KAAK,CAACC,UAAU,CAAC,CAAC;;EAExD;EACAF,aAAa,CAACG,YAAY,CAACC,SAAS,CAACC,WAAW,GAAG,UAASC,EAAE,EAAEC,KAAK,EAAEC,OAAO,EAAE;IAC9E,IAAIC,KAAK,GAAG,IAAI,CAACC,YAAY,CAACJ,EAAE,CAAC;IACjC,IAAI,CAACG,KAAK,EAAE;MACV,MAAM,qDAAqD;IAC7D;IACAT,aAAa,CAACW,WAAW,CAACC,oBAAoB,CAAC,CAAC;IAChDZ,aAAa,CAACW,WAAW,CAACE,YAAY,CAAC,CAAC;IACxC,IAAIC,UAAU,GAAGd,aAAa,CAACW,WAAW,CAACI,aAAa,CAAC,CAAC;IAE1D,IAAIC,cAAc,GAAGhB,aAAa,CAACiB,IAAI,CAACC,GAAG,CAACC,aAAa,CAAC,KAAK,CAAC;IAChEH,cAAc,CAACI,YAAY,CAAC,OAAO,EAAE,gBAAgB,CAAC;IACtD,IAAI,OAAOb,KAAK,KAAK,QAAQ,IAAIA,KAAK,KAAK,IAAI,IAAI,OAAOA,KAAK,CAACc,iBAAiB,KAAK,UAAU,EAAE;MAChGL,cAAc,C