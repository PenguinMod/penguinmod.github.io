ectTitle: {\n        id: 'tw.gui.defaultProjectTitle',\n        description: 'Default title for project',\n        defaultMessage: 'Project'\n    }\n});\n\n/* Higher Order Component to get and set the project title\n * @param {React.Component} WrappedComponent component to receive project title related props\n * @returns {React.Component} component with project loading behavior\n */\nconst TitledHOC = function (WrappedComponent) {\n    class TitledComponent extends React.Component {\n        componentDidMount () {\n            this.handleReceivedProjectTitle(this.props.projectTitle);\n        }\n        componentDidUpdate (prevProps) {\n            if (this.props.projectTitle !== prevProps.projectTitle) {\n                this.handleReceivedProjectTitle(this.props.projectTitle);\n            }\n            // if project is a new default project, and has loaded,\n            if (this.props.isShowingWithoutId && prevProps.isAnyCreatingNewState) {\n                // reset title to default\n                const defaultProjectTitle = this.handleReceivedProjectTitle();\n                this.props.onUpdateProjectTitle(defaultProjectTitle, true);\n            }\n            // if the projectTitle hasn't changed, but the reduxProjectTitle\n            // HAS changed, we need to report that change to the projectTitle's owner\n            if (this.props.reduxProjectTitle !== prevProps.reduxProjectTitle &&\n                this.props.reduxProjectTitle !== this.props.projectTitle) {\n                const defaultProjectTitle = this.props.intl.formatMessage(messages.defaultProjectTitle);\n                this.props.onUpdateProjectTitle(this.props.reduxProjectTitle, this.props.reduxProjectTitle === defaultProjectTitle);\n            }\n        }\n        handleReceivedProjectTitle (requestedTitle) {\n            let newTitle = requestedTitle;\n            let isDefault = false;\n            if (newTitle === null || typeof newTitle === 'undefined') {\n                newTitle = this.props.intl.formatMessage(messages.defaultProjectTitle);\n                isDefault = true;\n            }\n            this.props.onChangedProjectTitle(newTitle, isDefault);\n            return newTitle;\n        }\n        render () {\n            const {\n                /* eslint-disable no-unused-vars */\n                intl,\n                isAnyCreatingNewState,\n                isShowingWithoutId,\n                onChangedProjectTitle,\n                // for children, we replace onUpdateProjectTitle with our own\n                onUpdateProjectTitle,\n                // we don't pass projectTitle prop to children -- they must use\n                // redux value\n                projectTitle,\n                reduxProjectTitle,\n                /* eslint-enable no-unused-vars */\n                ...componentProps\n            } = this.props;\n            return (\n                <WrappedComponent\n                    {...componentProps}\n                />\n            );\n        }\n    }\n\n    TitledComponent.propTypes = {\n        intl: intlShape,\n        isAnyCreatingNewState: PropTypes.bool,\n        isShowingWithoutId: PropTypes.bool,\n        onChangedProjectTitle: PropTypes.func,\n        onUpdateProjectTitle: PropTypes.func,\n        projectTitle: PropTypes.string,\n        reduxProjectTitle: PropTypes.string\n    };\n\n    TitledComponent.defaultProps = {\n        onUpdateProjectTitle: () => {}\n    };\n\n    const mapStateToProps = state => {\n        const loadingState = state.scratchGui.projectState.loadingState;\n        return {\n            isAnyCreatingNewState: getIsAnyCreatingNewState(loadingState),\n            isShowingWithoutId: getIsShowingWithoutId(loadingState),\n            reduxProjectTitle: state.scratchGui.projectTitle\n        };\n    };\n\n    const mapDispatchToProps = dispatch => ({\n        onChangedProjectTitle: title => dispatch(setProjectTitle(title))\n    });\n\n    return injectIntl(connect(\n        mapStateToProps,\n        mapDispatchToProps,\n    )(TitledComponent));\n};\n\nexport {\n    TitledHOC as default\n};\n"],"mappings":";;;AAAA,OAAOA,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,SAAQC,OAAO,QAAO,aAAa;AACnC,SAAQC,cAAc,EAAEC,UAAU,EAAEC,SAAS,QAAO,YAAY;AAEhE,SACIC,wBAAwB,EACxBC,qBAAqB,QAClB,2BAA2B;AAClC,SAAQC,eAAe,QAAO,2BAA2B;AAEzD,MAAMC,QAAQ,GAAGN,cAAc,CAAC;EAC5BO,mBAAmB;IAAA;IAAA;EAAA;AAKvB,CAAC,CAAC;;AAEF;AACA;AACA;AACA;AACA,MAAMC,SAAS,GAAG,SAAZA,SAASA,CAAaC,gBAAgB,EAAE;EAC1C,MAAMC,eAAe,SAASZ,KAAK,CAACa,SAAS,CAAC;IAC1CC,iBAAiBA,CAAA,EAAI;MACjB,IAAI,CAACC,0BAA0B,CAAC,IAAI,CAACC,KAAK,CAACC,YAAY,CAAC;IAC5D;IACAC,kBAAkBA,CAAEC,SAAS,EAAE;MAC3B,IAAI,IAAI,CAACH,KAAK,CAACC,YAAY,KAAKE,SAAS,CAACF,YAAY,EAAE;QACpD,IAAI,CAACF,0BAA0B,CAAC,IAAI,CAACC,KAAK,CAACC,YAAY,CAAC;MAC5D;MACA;MACA,IAAI,IAAI,CAACD,KAAK,CAACI,kBAAkB,IAAID,SAAS,CAACE,qBAAqB,EAAE;QAClE;QACA,MAAMZ,mBAAmB,GAAG,IAAI,CAACM,0BAA0B,CAAC,CAAC;QAC7D,IAAI,CAACC,KAAK,CAACM,oBAAoB,CAACb,mBAAmB,EAAE,IAAI,CAAC;MAC9D;MACA;MACA;MACA,IAAI,IAAI,CAACO,KAAK,CAACO,iBAAiB,KAAKJ,SAAS,CAACI,iBAAiB,IAC5D,IAAI,CAACP,KAAK,CAACO,iBAAiB,KAAK,IAAI,CAACP,KAAK,CAACC,YAAY,EAAE;QAC1D,MAAMR,mBAAmB,GAAG,IAAI,CAACO,KAAK,CAACQ,IAAI,CAACC,aAAa,CAACjB,QAAQ,CAACC,mBAAmB,CAAC;QACvF,IAAI,CAACO,KAAK,CAACM,oBAAoB,CAAC,IAAI,CAACN,KAAK,CAACO,iBAAiB,EAAE,IAAI,CAACP,KAAK,CAACO,iBAAiB,KAAKd,mBAAmB,CAAC;MACvH;IACJ;IACAM,0BAA0BA,CAAEW,cAAc,EAAE;MACxC,IAAIC,QAAQ,GAAGD,cAAc;MAC7B,IAAIE,SAAS,GAAG,KAAK;MACrB,IAAID,QAAQ,KAAK,IAAI,IAAI,OAAOA,QAAQ,KAAK,WAAW,EAAE;QACtDA,QAAQ,GAAG,IAAI,CAACX,KAAK,CAACQ,IAAI,CAACC,aAAa,CAACjB,QAAQ,CAACC,mBAAmB,CAAC;QACtEmB,SAAS,GAAG,IAAI;MACpB;MACA,IAAI,CAACZ,KAAK,CAACa,qBAAqB,CAACF,QAAQ,EAAEC,SAAS,CAAC;MACrD,OAAOD,QAAQ;IACnB;IACAG,MAAMA,CAAA,EAAI;MACN,MAAAC,WAAA,GAcI,IAAI,CAACf,KAAK;QAdR;UACF;UACAQ,IAAI;UACJH,qBAAqB;UACrBD,kBAAkB;UAClBS,qBAAqB;UACrB;UACAP,oBAAoB;UACpB;UACA;UACAL,YAAY;UACZM;UACA;QAEJ,CAAC,GAAAQ,WAAA;QADMC,cAAc,GAAAC,wBAAA,CAAAF,WAAA,EAAAG,SAAA;MAErB,oBACIlC,KAAA,CAAAmC,aAAA,CAACxB,gBAAgB,EACTqB,cACP,CAAC;IAEV;EACJ;E