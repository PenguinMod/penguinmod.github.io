ouseDown}\n                onTrimStartMouseDown={this.handleTrimStartMouseDown}\n            />\n        );\n    }\n}\n\nAudioTrimmer.propTypes = {\n    onSetTrimEnd: PropTypes.func,\n    onSetTrimStart: PropTypes.func,\n    playhead: PropTypes.number,\n    trimEnd: PropTypes.number,\n    trimStart: PropTypes.number\n};\n\nexport default AudioTrimmer;\n"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,OAAO,MAAM,gBAAgB;AACpC,OAAOC,qBAAqB,MAAM,+CAA+C;AACjF,OAAOC,cAAc,MAAM,wBAAwB;AAEnD,MAAMC,UAAU,GAAG,IAAI,CAAC,CAAC;;AAEzB,MAAMC,YAAY,SAASN,KAAK,CAACO,SAAS,CAAC;EACvCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZP,OAAO,CAAC,IAAI,EAAE,CACV,0BAA0B,EAC1B,wBAAwB,EACxB,0BAA0B,EAC1B,wBAAwB,EACxB,UAAU,CACb,CAAC;IACF,IAAI,CAACQ,uBAAuB,GAAG,IAAIN,cAAc,CAAC;MAC9CO,MAAM,EAAE,IAAI,CAACC,wBAAwB;MACrCC,cAAc,EAAE,EAAE;MAClBC,iBAAiB,EAAE;IACvB,CAAC,CAAC;IACF,IAAI,CAACC,qBAAqB,GAAG,IAAIX,cAAc,CAAC;MAC5CO,MAAM,EAAE,IAAI,CAACK,sBAAsB;MACnCH,cAAc,EAAE,EAAE;MAClBC,iBAAiB,EAAE;IACvB,CAAC,CAAC;EAEN;EACAF,wBAAwBA,CAAEK,aAAa,EAAEC,aAAa,EAAE;IACpD,MAAMC,EAAE,GAAG,CAACF,aAAa,CAACG,CAAC,GAAGF,aAAa,CAACE,CAAC,IAAI,IAAI,CAACC,aAAa;IACnE,MAAMC,OAAO,GAAGC,IAAI,CAACC,GAAG,CAAC,CAAC,EAAED,IAAI,CAACE,GAAG,CAAC,IAAI,CAAChB,KAAK,CAACiB,OAAO,GAAGrB,UAAU,EAAE,IAAI,CAACsB,WAAW,GAAGR,EAAE,CAAC,CAAC;IAC7F,IAAI,CAACV,KAAK,CAACmB,cAAc,CAACN,OAAO,CAAC;EACtC;EACAN,sBAAsBA,CAAEC,aAAa,EAAEC,aAAa,EAAE;IAClD,MAAMC,EAAE,GAAG,CAACF,aAAa,CAACG,CAAC,GAAGF,aAAa,CAACE,CAAC,IAAI,IAAI,CAACC,aAAa;IACnE,MAAMC,OAAO,GAAGC,IAAI,CAACE,GAAG,CAAC,CAAC,EAAEF,IAAI,CAACC,GAAG,CAAC,IAAI,CAACf,KAAK,CAACoB,SAAS,GAAGxB,UAAU,EAAE,IAAI,CAACsB,WAAW,GAAGR,EAAE,CAAC,CAAC;IAC/F,IAAI,CAACV,KAAK,CAACqB,YAAY,CAACR,OAAO,CAAC;EACpC;EACAS,wBAAwBA,CAAEC,CAAC,EAAE;IACzB,IAAI,CAACX,aAAa,GAAG,IAAI,CAACY,gBAAgB,CAACC,qBAAqB,CAAC,CAAC,CAACC,KAAK;IACxE,IAAI,CAACzB,uBAAuB,CAAC0B,KAAK,CAACJ,CAAC,CAAC;IACrC,IAAI,CAACL,WAAW,GAAG,IAAI,CAAClB,KAAK,CAACoB,SAAS;EAC3C;EACAQ,sBAAsBA,CAAEL,CAAC,EAAE;IACvB,IAAI,CAACX,aAAa,GAAG,IAAI,CA