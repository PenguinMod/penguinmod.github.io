n;\n                canvas.height = (maxDimension / image.width) * image.height;\n            }\n            ctx.drawImage(image, 0, 0, canvas.width, canvas.height);\n        }\n\n        // TW: PNG allows using transparency while JPEG does not.\n        // A white background looks quite ugly in dark mode.\n        const dataURL = canvas.toDataURL('image/png').replace('data:image/png;base64,', '');\n        resolve(dataURL);\n    };\n    image.onerror = err => {\n        reject(err);\n    };\n    image.src = dataUrl;\n});\n\nexport default jpegThumbnail;\n"],"mappings":"AAAA,MAAMA,aAAa,GAAGC,OAAO,IAAI,IAAIC,OAAO,CAAC,CAACC,OAAO,EAAEC,MAAM,KAAK;EAC9D,MAAMC,KAAK,GAAG,IAAIC,KAAK,CAAC,CAAC;EACzBD,KAAK,CAACE,MAAM,GAAG,MAAM;IACjB,MAAMC,MAAM,GAAGC,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;IAC/C,MAAMC,GAAG,GAAGH,MAAM,CAACI,UAAU,CAAC,IAAI,CAAC;IAEnC,MAAMC,YAAY,GAAG,EAAE,CAAC,CAAC;;IAEzB;;IAEA,IAAIR,KAAK,CAACS,MAAM,GAAG,CAAC,IAAIT,KAAK,CAACU,KAAK,GAAG,CAAC,EAAE;MACrCP,MAAM,CAACO,KAAK,GAAGP,MAAM,CAACM,MAAM,GAAGD,YAAY;MAC3C;MACA;IACJ,CAAC,MAAM;MACH,IAAIR,KAAK,CAACS,MAAM,GAAGT,KAAK,CAACU,KAAK,EAAE;QAC5BP,MAAM,CAACM,MAAM,GAAGD,YAAY;QAC5BL,MAAM,CAACO,KAAK,GAAIF,YAAY,GAAGR,KAAK,CAACS,MAAM,GAAIT,KAAK,CAACU,KAAK;MAC9D,CAAC,MAAM;QACHP,MAAM,CAACO,KAAK,GAAGF,YAAY;QAC3BL,MAAM,CAACM,MAAM,GAAID,YAAY,GAAGR,KAAK,CAACU,KAAK,GAAIV,KAAK,CAACS,MAAM;MAC/D;MACAH,GAAG,CAACK,SAAS,CAACX,KAAK,EAAE,CAAC,EAAE,CAAC,EAAEG,MAAM,CAACO,KAAK,EAAEP,MAAM,CAACM,MAAM,CAAC;IAC3D;;IAEA;IACA;IACA,MAAMG,OAAO,GAAGT,MAAM,CAACU,SAAS,CAAC,WAAW,CAAC,CAACC,OAAO,CAAC,wBAAwB,EAAE,EAAE,CAAC;IACnFhB,OAAO,CAACc,OAAO,CAAC;EACpB,CAAC;EACDZ,KAAK,CAACe,OAAO,GAAGC,GAAG,IAAI;IACnBjB,MAAM,CAACiB,GAAG,CAAC;EACf,CAAC;EACDhB,KAAK,CAACiB,GAAG,GAAGrB,OAAO;AACvB,CAAC,CAAC;AAEF,eAAeD,aAAa","ignoreList":[]}]}