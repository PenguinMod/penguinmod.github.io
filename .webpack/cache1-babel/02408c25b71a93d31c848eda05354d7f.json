\n});\n\nclass ChangeUsername extends React.Component {\n    constructor (props) {\n        super(props);\n        bindAll(this, [\n            'changeUsername'\n        ]);\n    }\n    changeUsername () {\n        if (this.props.running && !isScratchDesktop()) {\n            // eslint-disable-next-line no-alert\n            alert(this.props.intl.formatMessage(messages.cannotChangeWhileRunning));\n            return;\n        }\n        this.props.onOpenUsernameModal();\n    }\n    render () {\n        return this.props.children(this.changeUsername);\n    }\n}\n\nChangeUsername.propTypes = {\n    children: PropTypes.func,\n    onOpenUsernameModal: PropTypes.func,\n    running: PropTypes.bool,\n    intl: intlShape\n};\n\nconst mapStateToProps = state => ({\n    running: state.scratchGui.vmStatus.running\n});\n\nconst mapDispatchToProps = dispatch => ({\n    onOpenUsernameModal: () => {\n        dispatch(openUsernameModal());\n        dispatch(closeEditMenu());\n    }\n});\n\nexport default injectIntl(connect(\n    mapStateToProps,\n    mapDispatchToProps\n)(ChangeUsername));\n"],"mappings":"AAAA,OAAOA,OAAO,MAAM,gBAAgB;AACpC,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,SAAQC,OAAO,QAAO,aAAa;AACnC,SAAQC,cAAc,EAAEC,UAAU,EAAEC,SAAS,QAAO,YAAY;AAChE,SAAQC,iBAAiB,QAAO,oBAAoB;AACpD,SAAQC,aAAa,QAAO,mBAAmB;AAC/C,OAAOC,gBAAgB,MAAM,yBAAyB;AAEtD,MAAMC,QAAQ,GAAGN,cAAc,CAAC;EAC5BO,wBAAwB;IAAA;IAAA;EAAA;AAK5B,CAAC,CAAC;AAEF,MAAMC,cAAc,SAASV,KAAK,CAACW,SAAS,CAAC;EACzCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZf,OAAO,CAAC,IAAI,EAAE,CACV,gBAAgB,CACnB,CAAC;EACN;EACAgB,cAAcA,CAAA,EAAI;IACd,IAAI,IAAI,CAACD,KAAK,CAACE,OAAO,IAAI,CAACR,gBAAgB,CAAC,CAAC,EAAE;MAC3C;MACAS,KAAK,CAAC,IAAI,CAACH,KAAK,CAACI,IAAI,CAACC,aAAa,CAACV,QAAQ,CAACC,wBAAwB,CAAC,CAAC;MACvE;IACJ;IACA,IAAI,CAACI,KAAK,CAACM,mBAAmB,CAAC,CAAC;EACpC;EACAC,MAAMA,CAAA,EAAI;IACN,OAAO,IAAI,CAACP,KAAK,CAACQ,QAAQ,CAAC,IAAI,CAACP,cAAc,CAAC;EACnD;AACJ;AAEAJ,cAAc,CAACY,SAAS,GAAG;EACvBD,QAAQ,EAAEtB,SAAS,CAACwB,IAAI;EACxBJ