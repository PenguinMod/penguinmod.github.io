     className={styles.container}\n                height={height}\n                width={width}\n            >\n                {Array(nBars).fill(0)\n                    .map((value, index) => (\n                        <rect\n                            className={index < nGreen ? styles.green :\n                                (index < nGreen + nYellow ? styles.yellow : styles.red)}\n                            height={barHeight}\n                            key={index}\n                            rx={barRounding}\n                            ry={barRounding}\n                            width={width - 2}\n                            x={1}\n                            y={height - ((barSpacing + barHeight) * (index + 1))}\n                        />\n                    ))}\n            </svg>\n            <div\n                className={styles.mask}\n                style={{\n                    transform: `scaleY(${scale})`\n                }}\n            />\n        </div>\n    );\n};\n\nMeter.propTypes = {\n    height: PropTypes.number,\n    level: PropTypes.number,\n    width: PropTypes.number\n};\n\nexport default Meter;\n"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,MAAM,MAAM,aAAa;AAEhC,MAAMC,KAAK,GAAGC,KAAK,IAAI;EACnB,MAAM;IACFC,KAAK;IACLC,KAAK;IACLC;EACJ,CAAC,GAAGH,KAAK;EAET,MAAMI,MAAM,GAAG,EAAE;EACjB,MAAMC,OAAO,GAAG,CAAC;EACjB,MAAMC,IAAI,GAAG,CAAC;EAEd,MAAMC,KAAK,GAAGH,MAAM,GAAGC,OAAO,GAAGC,IAAI;EAErC,MAAME,UAAU,GAAG,GAAG;EACtB,MAAMC,WAAW,GAAG,CAAC;EACrB,MAAMC,SAAS,GAAG,CAACP,MAAM,GAAIK,UAAU,IAAID,KAAK,GAAG,CAAC,CAAE,IAAIA,KAAK;EAE/D,MAAMI,WAAW,GAAGJ,KAAK,GAAGK,IAAI,CAACC,KAAK,CAACZ,KAAK,GAAGM,KAAK,CAAC;EACrD,MAAMO,KAAK,GAAG,CAAEH,WAAW,IAAID,SAAS,GAAGF,UAAU,CAAC,GAAKA,UAAU,GAAG,CAAE,IAAIL,MAAM;EAEpF,oBACIP,KAAA,CAAAmB,aAAA;IACIC,SAAS,EAAElB,MAAM,CAACmB,aAAc;IAChCC,KAAK,EAAE;MAACf,MAAM,KAAAgB,MAAA,CAAKhB,MAAM;IAAI;EAAE,gBAE/BP,KAAA,CAAAmB,aAAA;IACIC,SAAS,EAAElB,MAAM,CAACsB,SAAU;IAC5BjB,MAAM,EAAEA,MAAO;IACfD,KAAK,EAAE