{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\playground\\credits\\credits.jsx","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\playground\\credits\\credits.jsx","mtime":1777076889447},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["React","ReactDOM","PropTypes","appTarget","styles","getInitialDarkMode","UserData","document","documentElement","lang","User","_ref","image","text","href","createElement","target","rel","className","user","userImage","src","width","height","userInfo","propTypes","string","isRequired","UserList","_ref2","users","map","data","index","_extends","key","arrayOf","object","Credits","main","headerContainer","headerText","pmDevelopers","pmPullRequestDevelopers","pmCodeUsedFrom","pmCostumeSubmittors","pmSoundSubmittors","extensionDevelopers","pmExtensionDevelopers","addonDevelopers","pmTranslators","body","setAttribute","render"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/src/playground/credits/credits.jsx"],"sourcesContent":["import React from 'react';\nimport ReactDOM from 'react-dom';\nimport PropTypes from 'prop-types';\nimport appTarget from '../app-target';\nimport styles from './credits.css';\nimport { getInitialDarkMode } from '../../lib/tw-theme-hoc.jsx';\n\n// import fosshostLogo from './fosshost-light.png';\nimport UserData from './users';\n\n/* eslint-disable react/jsx-no-literals */\n\ndocument.documentElement.lang = 'en';\n\nconst User = ({ image, text, href }) => (\n    <a\n        href={href}\n        target=\"_blank\"\n        rel=\"noreferrer\"\n        className={styles.user}\n    >\n        <img\n            className={styles.userImage}\n            src={image}\n            width=\"60\"\n            height=\"60\"\n        />\n        <div className={styles.userInfo}>\n            {text}\n        </div>\n    </a>\n);\nUser.propTypes = {\n    image: PropTypes.string.isRequired,\n    text: PropTypes.string.isRequired,\n    href: PropTypes.string\n};\n\nconst UserList = ({ users }) => (\n    <div className={styles.users}>\n        {users.map((data, index) => (\n            <User\n                key={index}\n                {...data}\n            />\n        ))}\n    </div>\n);\nUserList.propTypes = {\n    users: PropTypes.arrayOf(PropTypes.object)\n};\n\nconst Credits = () => (\n    <main className={styles.main}>\n        <header className={styles.headerContainer}>\n            <h1 className={styles.headerText}>\n                GaiaMod Credits\n            </h1>\n        </header>\n        <section>\n            <h1>GaiaMod</h1>\n        </section>\n        <section>\n            <h2>Thank you</h2>\n            <p>\n                Without PenguinMod and TurboWarp, GaiaMod may have never existed.\n                Thank you to everyone who worked on Scratch, TurboWarp, and PenguinMod\n                you have made many people finally be able to make whatever they can imagine.\n            </p>\n            <a href=\"https://scratch.mit.edu/donate\">\n                Donate to support Scratch.\n            </a>\n            <br></br><br></br>\n            <a href=\"https://github.com/sponsors/GarboMuffin\">\n                Donate to support TurboWarp.\n            </a>\n            <h2>Contributors</h2>\n            <p>\n                GaiaMod is made by only one developer (Gaia herself).\n                A list is below, but you can also check <a href=\"https://github.com/orgs/GaiaMod-Main/people\">our GitHub</a> incase this one is out of date.\n            </p>\n            <UserList users={UserData.pmDevelopers} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n            <p>There are even community members who have helped develop PenguinMod. People like <i>you!</i></p>\n            <UserList users={UserData.pmPullRequestDevelopers} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n            <p>\n                We've also included work from other open-source projects inside of PenguinMod.\n                Here's a list of some other projects you should check out:\n            </p>\n            <UserList users={UserData.pmCodeUsedFrom} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n            <ul>\n                <li>Code for \"Center\" option in Costume editor is from <a href=\"https://github.com/Nitro-Bolt/scratch-paint/blob/develop/src/containers/mode-tools.jsx#L203-L216\">Cubester@Nitro-Bolt</a></li>\n            </ul>\n        </section>\n        <section>\n            <h2>GitHub Pages</h2>\n            <p>We currently use <a href=\"https://pages.github.com/\">GitHub Pages</a> to host GaiaMod.</p>\n            <a href=\"https://pages.github.com/\">\n                <img\n                    src=\"https://raw.githubusercontent.com/github/explore/80688e429a7d4ef2fca1e82350fe8e3517d3494d/collections/github-pages-examples/github-pages-examples.png\"\n                    width=\"160\"\n                    height=\"160\"\n                />\n            </a>\n            <h2>Costumes</h2>\n            <p>\n                All PenguinMod and GaiaMod costumes are downloaded or created from:\n                <ul>\n                    <li><a href=\"https://publicdomainvectors.org/\">https://publicdomainvectors.org/</a></li>\n                    <li><a href=\"https://discord.gg/NZ9MBMYTZh\">User-submissions from the PenguinMod Discord Server</a></li>\n                    <li>The PenguinMod Developers</li>\n                </ul>\n                All costumes exclusive to PenguinMod are included under Public Domain licenses or licenses such as MIT and CC0.\n            </p>\n            <p>This is the current list of user-submitted costume creators:</p>\n            <UserList users={UserData.pmCostumeSubmittors} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n            <h2>Sound Effects</h2>\n            <p>\n                All PenguinMod and GaiaMod sounds are downloaded or created from:\n                <ul>\n                    <li><a href=\"https://freesound.org/\">https://freesound.org/</a></li>\n                    <li><a href=\"https://opengameart.org/\">https://opengameart.org/</a> (only Public Domain ones)</li>\n                    <li><a href=\"https://archive.org/\">https://archive.org/</a></li>\n                    <li><a href=\"https://discord.gg/NZ9MBMYTZh\">User-submissions from the PenguinMod Discord Server</a></li>\n                    <li>The PenguinMod Developers</li>\n                </ul>\n                All sounds exclusive to PenguinMod are included under Public Domain licenses or licenses such as MIT and CC0.\n            </p>\n            <p>This is the current list of user-submitted sound creators:</p>\n            <UserList users={UserData.pmSoundSubmittors} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n        </section>\n        <section>\n            <h1>GaiaMod, PenguinMod & TurboWarp</h1>\n        </section>\n        <section>\n            <h2>Extensions</h2>\n            <p><i>\n                If you are an extension developer who wants their extension removed from GaiaMod's extensions list,\n                contact us as soon as you can. We'll get it removed as soon as we are able to.\n            </i></p>\n            <p>\n                We use some MIT licensed extensions from TurboWarp as they are really useful!\n                Check out the full list of TurboWarp extensions <a href=\"https://extensions.turbowarp.org/\">here</a>,\n                and see individual contributors below:\n            </p>\n            <UserList users={UserData.extensionDevelopers} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n            <p>\n                GaiaMod also has a few people who made and submitted extensions too!\n                This list may get outdated sometimes, but here they are listed below:\n            </p>\n            <UserList users={UserData.pmExtensionDevelopers} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n        </section>\n        <section>\n            <h2>Addons</h2>\n            <p>\n                Here are the developers that made the addons from <a href=\"https://scratchaddons.com/\">Scratch Addons</a> available.\n            </p>\n            <UserList users={UserData.addonDevelopers} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n            <p>PenguinMod-exclusive addons are created by the contributors listed in the Contributors section.</p>\n        </section>\n        <section>\n            <h1>TurboWarp</h1>\n        </section>\n        <section>\n            <p>\n                The TurboWarp project is made possible by the work of many volunteers.\n                <br></br>\n                You can check out TurboWarp's individual credits <a href=\"https://turbowarp.org/credits.html\">here</a>.\n                <br></br>\n                <a href=\"https://github.com/sponsors/GarboMuffin\">\n                    Donate to support TurboWarp.\n                </a>\n            </p>\n        </section>\n        <section>\n            <h2>Scratch</h2>\n            <p>\n                TurboWarp is based on the work of the <a href=\"https://scratch.mit.edu/credits\">Scratch contributors</a> but is not endorsed by Scratch in any way.\n            </p>\n            <p>\n                <a href=\"https://scratch.mit.edu/donate\">\n                    Donate to support Scratch.\n                </a>\n            </p>\n        </section>\n        <section>\n            <h2>Translators</h2>\n            <p>\n                More than 100 people have helped translate TurboWarp and its addons into many languages —\n                far more than we could hope to list here.\n            </p>\n            <p>\n                PenguinMod is also (very very slowly) getting translated into other languages, in the future\n                hopefully the same number of languages can be supported. It'll take a while until we get there though.\n            </p>\n            <p>Here is the current list of PenguinMod Translators:</p>\n            <UserList users={UserData.pmTranslators} />\n            <p><i>The list order is randomized on each refresh.</i></p>\n        </section>\n        <section>\n            <p>\n                <i>\n                    Individual contributors are listed in no particular order.\n                    The order is randomized each visit.\n                </i>\n            </p>\n        </section>\n    </main>\n);\n\ndocument.body.setAttribute('theme', getInitialDarkMode() ? 'dark' : 'light');\n\nReactDOM.render((\n    <Credits />\n), appTarget);\n"],"mappings":";AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,QAAQ,MAAM,WAAW;AAChC,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,SAAS,MAAM,eAAe;AACrC,OAAOC,MAAM,MAAM,eAAe;AAClC,SAASC,kBAAkB,QAAQ,4BAA4B;;AAE/D;AACA,OAAOC,QAAQ,MAAM,SAAS;;AAE9B;;AAEAC,QAAQ,CAACC,eAAe,CAACC,IAAI,GAAG,IAAI;AAEpC,MAAMC,IAAI,GAAGC,IAAA;EAAA,IAAC;IAAEC,KAAK;IAAEC,IAAI;IAAEC;EAAK,CAAC,GAAAH,IAAA;EAAA,oBAC/BX,KAAA,CAAAe,aAAA;IACID,IAAI,EAAEA,IAAK;IACXE,MAAM,EAAC,QAAQ;IACfC,GAAG,EAAC,YAAY;IAChBC,SAAS,EAAEd,MAAM,CAACe;EAAK,gBAEvBnB,KAAA,CAAAe,aAAA;IACIG,SAAS,EAAEd,MAAM,CAACgB,SAAU;IAC5BC,GAAG,EAAET,KAAM;IACXU,KAAK,EAAC,IAAI;IACVC,MAAM,EAAC;EAAI,CACd,CAAC,eACFvB,KAAA,CAAAe,aAAA;IAAKG,SAAS,EAAEd,MAAM,CAACoB;EAAS,GAC3BX,IACA,CACN,CAAC;AAAA,CACP;AACDH,IAAI,CAACe,SAAS,GAAG;EACbb,KAAK,EAAEV,SAAS,CAACwB,MAAM,CAACC