U_ERRORS);\nconst errorsMenuOpen = state => state.scratchGui.menus[MENU_ERRORS];\n\nexport {\n    reducer as default,\n    initialState as menuInitialState,\n    openAboutMenu,\n    closeAboutMenu,\n    aboutMenuOpen,\n    openAccountMenu,\n    closeAccountMenu,\n    accountMenuOpen,\n    openThemeMenu,\n    closeThemeMenu,\n    themeMenuOpen,\n    openFileMenu,\n    closeFileMenu,\n    fileMenuOpen,\n    openEditMenu,\n    closeEditMenu,\n    editMenuOpen,\n    openLanguageMenu,\n    closeLanguageMenu,\n    languageMenuOpen,\n    openLoginMenu,\n    closeLoginMenu,\n    loginMenuOpen,\n    openErrorsMenu,\n    closeErrorsMenu,\n    errorsMenuOpen\n};\n"],"mappings":"AAAA,MAAMA,SAAS,GAAG,6BAA6B;AAC/C,MAAMC,UAAU,GAAG,8BAA8B;AAEjD,MAAMC,UAAU,GAAG,WAAW;AAC9B,MAAMC,YAAY,GAAG,aAAa;AAClC,MAAMC,UAAU,GAAG,WAAW;AAC9B,MAAMC,SAAS,GAAG,UAAU;AAC5B,MAAMC,SAAS,GAAG,UAAU;AAC5B,MAAMC,aAAa,GAAG,cAAc;AACpC,MAAMC,UAAU,GAAG,WAAW;AAC9B,MAAMC,WAAW,GAAG,WAAW;AAG/B,MAAMC,YAAY,GAAG;EACjB,CAACR,UAAU,GAAG,KAAK;EACnB,CAACC,YAAY,GAAG,KAAK;EACrB,CAACC,UAAU,GAAG,KAAK;EACnB,CAACC,SAAS,GAAG,KAAK;EAClB,CAACC,SAAS,GAAG,KAAK;EAClB,CAACC,aAAa,GAAG,KAAK;EACtB,CAACC,UAAU,GAAG,KAAK;EACnB,CAACC,WAAW,GAAG;AACnB,CAAC;AAED,MAAME,OAAO,GAAG,SAAVA,OAAOA,CAAaC,KAAK,EAAEC,MAAM,EAAE;EACrC,IAAI,OAAOD,KAAK,KAAK,WAAW,EAAEA,KAAK,GAAGF,YAAY;EACtD,QAAQG,MAAM,CAACC,IAAI;IACnB,KAAKd,SAAS;MACV,OAAOe,MAAM,CAACC,MAAM,CAAC,CAAC,CAAC,EAAEJ,KAAK,EAAE;QAC5B,CAACC,MAAM,CAACI,IAAI,GAAG;MACnB,CAAC,CAAC;IACN,KAAKhB,UAAU;MACX,OAAOc,MAAM,CAACC,MAAM,CAAC,CAAC,CAAC,EAAEJ,KAAK,EAAE;QAC5B,CAACC,MAAM,CAACI,IAAI,GAAG;MACnB,CAAC,CAAC;IACN;MACI,OAAOL,KAAK;EAChB;AACJ,CAAC;AACD,MAAMM,QAAQ,GAAGD,IAAI,KAAK;EACtBH,IAAI,EAAEd,SAAS;EACfiB,IAAI,EAAEA;AACV,CAAC,CAAC;AACF,MAAME,SAAS,GAAGF,IAAI,KAAK;EACvBH,IAAI,EAAEb,UAAU;EAChBgB,IAAI,EAAEA;AACV,CAAC,CAAC;AACF,MAAMG,aAAa,GAAGA,CAAA,KAAMF,QAAQ,CAAChB,UAAU,CAAC;AAChD,MAAMmB,cAAc,GAAGA,CAAA,KAAMF,SAAS,CAACjB,UAAU,CAAC;AAClD,MAAMoB,aAAa,GAAGV,KAAK,IAAIA,KAAK,CAACW,UAAU,CAACC,KAAK,CAACtB,UAAU,CAAC;AACjE,MAAMuB