{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\lib\\monitor-adapter.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\lib\\monitor-adapter.js","mtime":1777076888965},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["OpcodeLabels","isUndefined","a","_ref","id","spriteName","opcode","params","value","vm","label","category","labelFn","runtime","getLabelForOpcode","getLabel","concat","Number","toFixed","toString","Array","isArray","slice","i","length","item","toListItem","toMonitorContent","toReporterContent","isHTML"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/src/lib/monitor-adapter.js"],"sourcesContent":["import OpcodeLabels from './opcode-labels.js';\n\nconst isUndefined = a => typeof a === 'undefined';\n\n/**\n * Convert monitors from VM format to what the GUI needs to render.\n * - Convert opcode to a label and a category\n * @param {string} block.id - The id of the monitor block\n * @param {string} block.spriteName - Present only if the monitor applies only to the sprite\n *     with given target ID. The name of the target sprite when the monitor was created\n * @param {string} block.opcode - The opcode of the monitor\n * @param {object} block.params - Extra params to the monitor block\n * @param {string|number|Array} block.value - The monitor value\n * @param {VirtualMachine} block.vm - the VM instance which owns the block\n * @return {object} The adapted monitor with label and category\n */\nexport default function ({id, spriteName, opcode, params, value, vm}) {\n    // Extension monitors get their labels from the Runtime through `getLabelForOpcode`.\n    // Other monitors' labels are hard-coded in `OpcodeLabels`.\n    let {label, category, labelFn} = (vm && vm.runtime.getLabelForOpcode(opcode)) || OpcodeLabels.getLabel(opcode);\n\n    // Use labelFn if provided for dynamic labelling (e.g. variables)\n    if (!isUndefined(labelFn)) label = labelFn(params);\n\n    // Append sprite name for sprite-specific monitors\n    if (spriteName) {\n        label = `${spriteName}: ${label}`;\n    }\n\n    // Parse null to a string\n    if (value === null) {\n        value = 'null';\n    }\n\n    // Parse undefined to a string\n    if (isUndefined(value)) {\n        value = 'undefined';\n    }\n\n    // If value is a number, round it to six decimal places\n    if (typeof value === 'number') {\n        value = Number(value.toFixed(6));\n    }\n\n    // Turn the value to a string, for handle boolean values\n    if (typeof value === 'boolean') {\n        value = value.toString();\n    }\n    \n    // Lists can contain booleans, which should also be turned to strings\n    if (Array.isArray(value)) {\n        value = value.slice();\n        for (let i = 0; i < value.length; i++) {\n            const item = value[i];\n            if (typeof item === 'boolean') {\n                value[i] = item.toString();\n            }\n            if (typeof item === 'object' && item !== null) {\n                // check if this is a pure object or custom display\n                if (typeof (item.toListItem || value.toMonitorContent || item.toReporterContent) === 'function') {\n                    value[i].isHTML = true;\n                }\n            }\n        }\n    }\n\n    let isHTML = false;\n    if (typeof value === 'object' && value !== null) {\n        // check if this is a pure object or custom display\n        if (typeof (value.toMonitorContent || value.toReporterContent) === 'function') {\n            value = value.toMonitorContent\n              ? value.toMonitorContent() : value.toReporterContent();\n            isHTML = true;\n        }\n    }\n\n    return {id, label, category, value, isHTML};\n}\n"],"mappings":"AAAA,OAAOA,YAAY,MAAM,oBAAoB;AAE7C,MAAMC,WAAW,GAAGC,CAAC,IAAI,OAAOA,CAAC,KAAK,WAAW;;AAEjD;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,eAAe,UAAAC,IAAA,EAAuD;EAAA,IAA7C;IAACC,EAAE;IAAEC,UAAU;IAAEC,MAAM;IAAEC,MAAM;IAAEC,KAAK;IAAEC;EAAE,CAAC,GAAAN,IAAA;EAChE;EACA;EACA,IAAI;IAACO,KAAK;IAAEC,QAAQ;IAAEC;EAAO,CAAC,GAAIH,EAAE,IAAIA,EAAE,CAACI,OAAO,CAACC,iBAAiB,CAACR,MAAM,CAAC,IAAKN,YAAY,CAACe,QAAQ,CAACT,MAAM,CAAC;;EAE9G;EACA,IAAI,CAACL,WAAW,CAACW,OAAO,CAAC,EAAEF,KAAK,GAAGE,OAAO,CAACL,MAAM,CAAC;;EAElD;EACA,IAAIF,UAAU,EAAE;IACZK,KAAK,MAAAM,MAAA,CAAMX,UAAU,QAAAW,MAAA,CAAKN,KAAK,CAAE;EACrC;;EAEA;EACA,IAAIF,KAAK,KAAK,IAAI,EAAE;IAChBA,KAAK,GAAG,MAAM;EAClB;;EAEA;EACA,IAAIP,WAAW,CAACO,KAAK,CAAC,EAAE;IACpBA,KAAK,GAAG,WAAW;EACvB;;EAEA;EACA,IAAI,OAAOA,KAAK,KAAK,QAAQ,EAAE;IAC3BA,KAAK,GAAGS,MAAM,CAACT,KAAK,CAACU,OAAO,CAAC,CAAC,CAAC,CAAC;EACpC;;EAEA;EACA,IAAI,OAAOV,KAAK,KAAK,SAAS,EAAE;IAC5BA,KAAK,GAAGA,KAAK,CAACW,QAAQ,CAAC,CAAC;EAC5B;;EAEA;EACA,IAAIC,KAAK,CAACC,OAAO,CAACb,KAAK,CAAC,EAAE;IACtBA,KAAK,GAAGA,KAAK,CAACc,KAAK,CAAC,CAAC;IACrB,KAAK,IAAIC,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAGf,KAAK,CAACgB,MAAM,EAAED,CAAC,EAAE,EAAE;MACnC,MAAME,IAAI,GAAGjB,KAAK,CAACe,CAAC,CAAC;MACrB,IAAI,OAAOE,IAAI,KAAK,SAAS,EAAE;QAC3BjB,KAAK,CAACe,CAAC,CAAC,GAAGE,IAAI,CAACN,QAAQ,CAAC,CAAC;MAC9B;MACA,IAAI,OAAOM,IAAI,KAAK,QAAQ,IAAIA,IAAI,KAAK,IAAI,EAAE;QAC3C;QACA,IAAI,QAAQA,IAAI,CAACC,UAAU,IAAIlB,KAAK,CAACmB,gBAAgB,IAAIF,IAAI,CAACG,iBAAiB,CAAC,KAAK,UAAU,EAAE;UAC7FpB,KAAK,CAACe,CAAC,CAAC,CAACM,MAAM,GAAG,IAAI;QAC1B;MACJ;IACJ;EACJ;EAEA,IAAIA,MAAM,GAAG,KAAK;EAClB,IAAI,OAAOrB,KAAK,KAAK,QAAQ,IAAIA,KAAK,KAAK,IAAI,EAAE;IAC7C;IACA,IAAI,QAAQA,KAAK,CAACmB,gBAAgB,IAAInB,KAAK,CAACoB,iBAAiB,CAAC,KAAK,UAAU,EAAE;MAC3EpB,KAAK,GAAGA,KAAK,CAACmB,gBAAgB,GAC1BnB,KAAK,CAACmB,gBAAgB,CAAC,CAAC,GAAGnB,KAAK,CAACoB,iBAAiB,CAAC,CAAC;MA