bManager {\n    constructor (runtime) {\n        this.runtime = runtime;\n        this.tabs_ = {};\n    }\n\n    /**\n     * Register a new editor tab.\n     * @param {string} extensionId ID of this extension.\n     * @param {string} tabId ID for this tab.\n     * @param {string} name Name of the editor tab.\n     * @param {string} uri The icon URI\n     * @returns {EditorTab} The tab interface\n     */\n    register (extensionId, tabId, name, uri) {\n        const fullTabId = `${extensionId}_${tabId}`;\n        // check if this tab exists\n        if (fullTabId in this.tabs_) {\n            console.warn('Tab', tabId, 'for', extensionId, 'already exists.');\n            return this.tabs_[fullTabId];\n        }\n        // create tab\n        const tab = new EditorTab(this.runtime, extensionId, tabId, name, uri);\n        this.tabs_[fullTabId] = tab;\n        this.runtime.emit('EDITOR_TABS_NEW', tab);\n        return tab;\n    }\n}\n\nmodule.exports = TabManager;"],"mappings":"AAAA,MAAMA,SAAS,CAAC;EACZC,WAAWA,CAAEC,OAAO,EAAEC,WAAW,EAAEC,KAAK,EAAEC,IAAI,EAAEC,GAAG,EAAE;IACjD,IAAI,CAACJ,OAAO,GAAGA,OAAO;IACtB,IAAI,CAACK,YAAY,GAAGJ,WAAW;IAC/B,IAAI,CAACK,MAAM,GAAGJ,KAAK;IACnB,IAAI,CAACK,QAAQ,GAAG,IAAI;IAEpB,IAAI,CAACJ,IAAI,GAAGA,IAAI;IAChB,IAAI,CAACK,IAAI,GAAGJ,GAAG;EACnB;EAEAK,OAAOA,CAAEN,IAAI,EAAE;IACX,IAAI,CAACA,IAAI,GAAGA,IAAI;IAChB,IAAI,CAACO,MAAM,CAAC,CAAC;EACjB;EACAC,OAAOA,CAAEC,OAAO,EAAE;IACd,IAAI,CAACJ,IAAI,GAAGI,OAAO;IACnB,IAAI,CAACF,MAAM,CAAC,CAAC;EACjB;EAEAG,MAAMA,CAAEC,OAAO,EAAE;IACb,IAAI,CAACP,QAAQ,GAAGO,OAAO;IACvB,IAAI,CAACJ,MAAM,CAAC,CAAC;EACjB;EACAA,MAAMA,CAAA,EAAI;IACN,IAAI,CAACV,OAAO,CAACe,IAAI,CAAC,oBAAoB,CAAC;EAC3C;AACJ;;AAEA;AACA;AACA;AACA;AACA,MAAMC,UAAU,CAAC;EACbjB,WAAWA,CAAEC,OAAO,EAAE;IAClB,IAAI,CAACA,OAAO,GAAGA,OAAO;IACtB,IAAI,CAACiB,KAAK,GAAG,CAAC,CAAC;EACnB;;EAEA;AACJ;AACA;AACA;AACA;AACA;AACA;AACA;EACIC,QAAQA,CAAEjB,WAAW,EAAEC,KAAK,EAAEC,IAAI,EAAEC,GAAG,EAAE;IACrC,MAAMe,SAAS,MAAAC,MAAA,CAAMnB,WAAW,OAAAmB,MAAA,CAAIlB,KAAK,CAAE;IAC3C;IACA,IAAIiB