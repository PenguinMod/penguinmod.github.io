 this.value = this.name;\n            break;\n        default:\n            console.warn(`Invalid variable type: ${this.type}`);\n        }\n    }\n\n    toXML (isLocal) {\n        isLocal = (isLocal === true);\n        return `<variable type=\"${this.type}\" id=\"${this.id}\" islocal=\"${isLocal\n        }\" iscloud=\"${this.isCloud}\">${xmlEscape(this.name)}</variable>`;\n    }\n\n    /**\n     * Type representation for scalar variables.\n     * This is currently represented as ''\n     * for compatibility with blockly.\n     * @const {string}\n     */\n    static get SCALAR_TYPE () {\n        return ''; // used by compiler\n    }\n\n    /**\n     * Type representation for list variables.\n     * @const {string}\n     */\n    static get LIST_TYPE () {\n        return 'list'; // used by compiler\n    }\n\n    /**\n     * Type representation for list variables.\n     * @const {string}\n     */\n    static get BROADCAST_MESSAGE_TYPE () {\n        return 'broadcast_msg';\n    }\n}\n\nmodule.exports = Variable;\n"],"mappings":"AAAA;AACA;AACA;AACA;;AAEA,MAAMA,GAAG,GAAGC,OAAO,CAAC,aAAa,CAAC;AAClC,MAAMC,SAAS,GAAGD,OAAO,CAAC,oBAAoB,CAAC;AAE/C,MAAME,QAAQ,CAAC;EACX;AACJ;AACA;AACA;AACA;AACA;AACA;EACIC,WAAWA,CAAEC,EAAE,EAAEC,IAAI,EAAEC,IAAI,EAAEC,OAAO,EAAE;IAClC,IAAI,CAACH,EAAE,GAAGA,EAAE,IAAIL,GAAG,CAAC,CAAC;IACrB,IAAI,CAACM,IAAI,GAAGA,IAAI;IAChB,IAAI,CAACC,IAAI,GAAGA,IAAI;IAChB,IAAI,CAACC,OAAO,GAAGA,OAAO;IACtB,QAAQ,IAAI,CAACD,IAAI;MACjB,KAAKJ,QAAQ,CAACM,WAAW;QACrB,IAAI,CAACC,KAAK,GAAG,CAAC;QACd;MACJ,KAAKP,QAAQ,CAACQ,SAAS;QACnB,IAAI,CAACD,KAAK,GAAG,EAAE;QACf;MACJ,KAAKP,QAAQ,CAACS,sBAAsB;QAChC,IAAI,CAACF,KAAK,GAAG,IAAI,CAACJ,IAAI;QACtB;MACJ;QACIO,OAAO,CAACC,IAAI,2BAAAC,MAAA,CAA2B,IAAI,CAACR,IAAI,CAAE,CAAC;IACvD;EACJ;EAEAS,KAAKA,CAAEC,OAAO,EAAE;IACZA,OAAO,GAAIA,OAAO,KAAK,IAAK;IAC5B,2BAAAF,MAAA,CAA0B,IAAI,CAACR,IAAI,cAAAQ,MAAA,CAAS,IAAI,CAACV,EAAE,mBAAAU,MAAA,CAAcE,OAAO,mBAAAF,MAAA,CAC1D,IAAI,CAACP,OAAO,SAAAO,MAAA,CAAKb,SAAS,CAAC,IAAI,CAACI,IAAI,CAAC;EACvD;;EAEA;AACJ;AACA;AACA;A