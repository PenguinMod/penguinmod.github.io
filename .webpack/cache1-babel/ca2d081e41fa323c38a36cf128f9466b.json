= null;\n      }\n    }\n\n    _flash();\n  }\n}\n\nconst myFlash = { block: null, timerID: null };\n"],"mappings":"AAAA;AACA;AACA;AACA,eAAe,MAAMA,YAAY,CAAC;EAChC;AACF;AACA;AACA;EACE,OAAOC,KAAKA,CAACC,KAAK,EAAE;IAClB,IAAIC,OAAO,CAACC,OAAO,GAAG,CAAC,EAAE;MACvBC,YAAY,CAACF,OAAO,CAACC,OAAO,CAAC;MAC7B,IAAID,OAAO,CAACD,KAAK,CAACI,QAAQ,EAAE;QAC1BH,OAAO,CAACD,KAAK,CAACI,QAAQ,CAACC,KAAK,CAACC,IAAI,GAAG,EAAE;MACxC;IACF;IAEA,IAAIC,KAAK,GAAG,CAAC;IACb,IAAIC,OAAO,GAAG,IAAI;IAClBP,OAAO,CAACD,KAAK,GAAGA,KAAK;;IAErB;AACJ;AACA;AACA;IACI,SAASS,MAAMA,CAAA,EAAG;MAChB,IAAIR,OAAO,CAACD,KAAK,CAACI,QAAQ,EAAE;QAC1BH,OAAO,CAACD,KAAK,CAACI,QAAQ,CAACC,KAAK,CAACC,IAAI,GAAGE,OAAO,GAAG,SAAS,GAAG,EAAE;MAC9D;MACAA,OAAO,GAAG,CAACA,OAAO;MAClBD,KAAK,EAAE;MACP,IAAIA,KAAK,GAAG,CAAC,EAAE;QACbN,OAAO,CAACC,OAAO,GAAGQ,UAAU,CAACD,MAAM,EAAE,GAAG,CAAC;MAC3C,CAAC,MAAM;QACLR,OAAO,CAACC,OAAO,GAAG,CAAC;QACnBD,OAAO,CAACD,KAAK,GAAG,IAAI;MACtB;IACF;IAEAS,MAAM,CAAC,CAAC;EACV;AACF;AAEA,MAAMR,OAAO,GAAG;EAAED,KAAK,EAAE,IAAI;EAAEE,OAAO,EAAE;AAAK,CAAC","ignoreList":[]}]}