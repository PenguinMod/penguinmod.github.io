 behavior of deserialize-assets.js\n            if (!file) {\n                const fileMatch = new RegExp(`^([^/]*/)?${md5ext}$`);\n                file = zip.file(fileMatch)[0];\n            }\n\n            if (file) {\n                return file.async('uint8array').then(data => runtime.storage.createAsset(\n                    assetType,\n                    ext,\n                    data,\n                    md5,\n                    false\n                ));\n            }\n        }\n\n        return storage.load(assetType, md5, ext);\n    }\n}\n\nmodule.exports = AssetUtil;"],"mappings":"AAAA,MAAMA,UAAU,GAAGC,OAAO,CAAC,eAAe,CAAC;AAE3C,MAAMC,SAAS,CAAC;EACZ;AACJ;AACA;AACA;AACA;AACA;AACA;EACI,OAAOC,WAAWA,CAACC,OAAO,EAAEC,GAAG,EAAEC,SAAS,EAAEC,MAAM,EAAE;IAChD,MAAMC,OAAO,GAAGJ,OAAO,CAACI,OAAO;IAC/B,MAAMC,OAAO,GAAGT,UAAU,CAACU,UAAU,CAACH,MAAM,EAAE,GAAG,CAAC;IAClD,MAAMI,GAAG,GAAGF,OAAO,CAAC,CAAC,CAAC;IACtB,MAAMG,GAAG,GAAGH,OAAO,CAAC,CAAC,CAAC,CAACI,WAAW,CAAC,CAAC;IAEpC,IAAIR,GAAG,EAAE;MACL;MACA,IAAIS,IAAI,GAAGT,GAAG,CAACS,IAAI,CAACP,MAAM,CAAC;;MAE3B;MACA;MACA,IAAI,CAACO,IAAI,EAAE;QACP,MAAMC,SAAS,GAAG,IAAIC,MAAM,cAAAC,MAAA,CAAcV,MAAM,MAAG,CAAC;QACpDO,IAAI,GAAGT,GAAG,CAACS,IAAI,CAACC,SAAS,CAAC,CAAC,CAAC,CAAC;MACjC;MAEA,IAAID,IAAI,EAAE;QACN,OAAOA,IAAI,CAACI,KAAK,CAAC,YAAY,CAAC,CAACC,IAAI,CAACC,IAAI,IAAIhB,OAAO,CAACI,OAAO,CAACa,WAAW,CACpEf,SAAS,EACTM,GAAG,EACHQ,IAAI,EACJT,GAAG,EACH,KACJ,CAAC,CAAC;MACN;IACJ;IAEA,OAAOH,OAAO,CAACc,IAAI,CAAChB,SAAS,EAAEK,GAAG,EAAEC,GAAG,CAAC;EAC5C;AACJ;AAEAW,MAAM,CAACC,OAAO,GAAGtB,SAAS","ignoreList":[]}]}