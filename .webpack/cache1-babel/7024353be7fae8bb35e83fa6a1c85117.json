get.blocks._blocks)\n          .filter((b) => !b.shadow).length // shadow blocks should be filtered out\n      ];\n    });\n\n    // project block count\n    for (const info of targetBlocks) blockCount += info[1];\n    return blockCount;\n  };\n\n  const updateText = () => {\n    const count = getBlockCount();\n    counterElement.innerText = count + (count === 1 ? \" block\" : \" blocks\");\n  };\n\n  const addCounter = () => {\n    let shouldReApply = false;\n    ReduxStore.subscribe(() => {\n      if (!counterElement || shouldReApply) {\n        // init counter\n        const topBar = document.querySelector(\"div[class^='menu-bar_main-menu']\");\n        if (!topBar) return;\n\n        if (shouldReApply) {\n          queueMicrotask(() => {\n            topBar.appendChild(counterElement);\n          });\n          return;\n        }\n\n        counterElement = topBar.appendChild(document.createElement(\"span\"));\n        counterElement.style.order = 1;\n        counterElement.style.padding = \"9px\";\n        counterElement.innerText = \"\";\n        updateText();\n        addLiveBlockCount();\n      } else {\n        // hide display if not in editor\n        const state = ReduxStore.getState().scratchGui;\n        if (state.mode.isPlayerOnly) {\n          // GUI will remove the counter automatically, add it back.\n          shouldReApply = true;\n        }\n      }\n    });\n  }\n\n  const addLiveBlockCount = () => {\n    let lastWorkspaceID;\n    let lastUpdateTime = 0;\n    vm.on(\"workspaceUpdate\", () => queueMicrotask(() => {\n      updateText();\n      const workspace = Blockly.mainWorkspace;\n      const events = Blockly.Events;\n\n      const blocklyHandler = (event) => {\n        const now = Date.now();\n        if (\n          counterElement &&\n          now > lastUpdateTime + 150 && // dont update the count multiple times in a second\n          (event.type === events.DELETE || event.type === events.CREATE)\n        ) {\n          lastUpdateTime = now;\n          setTimeout(updateText, 200);\n        }\n      };\n\n      if (lastWorkspaceID !== workspace.id) {\n        workspace.addChangeListener(blocklyHandler);\n        lastWorkspaceID = workspace.id;\n      }\n    }));\n  };\n\n  addCounter();\n}\n"],"mappings":"AAAA,eAAe,gBAAAA,IAAA,EAAyC;EAAA,IAAzB;IAAEC,KAAK;IAAEC,OAAO;IAAEC;EAAI,CAAC,GAAAH,IAAA;EACpD,MAAMI,OAAO,GAAG,MAAMH,KAAK,CAACI,GAAG,CAACC,KAAK,CAACC,UAAU,CAAC,CAAC;EAClD,MAAMC,EAAE,GAAGP,KAAK,CAACI,GAAG,CAACC,KAAK,CAACE,EAAE;EAE7B,IAAIC,cAAc;EAElB,MAAMC,aAAa,GAAGA,CAAA,KAAM;IAC1B,IAAIC,UAAU,GAAG,CAAC;IAClB,MAAMC,YAAY,GAAGJ,EAAE,CAACK,OAAO,CAACC,OAAO,CAACC,MAAM,CAACC,CAAC,IAAIA,CAAC,CAACC,UAAU,CAAC,CAACC,GAAG,CAAEC,MAAM,IAAK;MAChF,OAAO,CACLA,MAAM,CAACC,EAAE,EACTC,MAAM,CAACC,MAAM,CAACH,MAAM,CAACI,MAAM,CAACC,OAAO,CAAC,CACjCT,MAAM,CAAEU,CAAC,IAAK,CAACA,CAAC,CAACC,MAAM,CAAC,CAACC,MAAM,CAAC;MAAA,CACpC;IACH,CAAC,CAAC;;IAEF;IACA,KAAK,MAAMC,IAAI,IAAIhB,YAAY,EAAED,UAAU,IAAIiB,IAAI,CAAC,CAAC,CAAC;IACtD,OAAOjB,UAAU;EACnB,CAAC;EAED,MAAMkB,UAAU,GAAGA,CAAA,KAAM;IACvB,MAAMC,KAAK,GAAGpB,aAAa,CAAC,CAAC;IAC7BD,cAAc,CAACsB,SAAS,GAAGD,KAAK,IAAIA,KAAK,KAAK,CAAC,GAAG,QAAQ,GAAG,SAAS,CAAC;EACzE,CAAC;EAED,MAAME,UAAU,GAAGA,CAAA,KAAM;IACvB,IAAIC,aAAa,GAAG,KAAK;IACzBC,UAAU,CAACC,SAAS,CAAC,MAAM;MACzB,IAAI,CAAC1B,cAAc,IAAIwB,aAAa,EAAE;QACpC;QACA,MAAMG,MAAM,GAAGC,QAAQ,CAACC,aAAa,CAAC,kCAAkC,CAAC;QACzE,IAAI,CAACF,MAAM,EAAE;QAEb,IAAIH,aAAa,EAAE;UACjBM,cAAc,CAAC,MAAM;YACnBH,MAAM,CAACI,WAAW,CAAC/B,cAAc,CAAC;UACpC,CAAC,CAAC;UACF;QACF;QAEAA,cAAc,GAAG2B,MAAM,CAACI,WAAW,CAACH,QAAQ,CAACI,aAAa,CAAC,MAAM,CAAC,CAAC;QACnEhC,cAAc,CAACiC,KAAK,CAACC,KAAK,GAAG,CAAC;QAC9BlC,cAAc,CAACiC,KAAK,CAACE,OAAO,GAAG,KAAK;QACpCnC,cAAc,CAACsB,SAAS,GAAG,EAAE;QAC7BF,UAAU,CAAC,CAAC;QACZgB,iBAAiB,CAAC,CAAC;MACrB,CAAC,MAAM;QACL;QACA,MAAMC,KAAK,GAAGZ,UAAU,CAACa,QAAQ,CAAC,CAAC,CAACC,UAAU;QAC9C,IAAIF,KAAK,CAACG,IAAI,CAACC,YAAY,EAAE;UAC3B;UACAjB,aAAa,GAAG,IAAI;QACtB;MACF;IACF,CAAC,CAAC;EACJ,CAAC;EAED,MAAMY,iBAAiB,GAAGA,CAAA,KAAM;IAC9B,IAAIM,eAAe;IACnB,IAAIC,cAAc,GAAG,CAAC