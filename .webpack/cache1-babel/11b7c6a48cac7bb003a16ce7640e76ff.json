ze, brushType };\n        case CHANGE_SIMPLIFY_SIZE:\n            if (isNaN(action.simplifySize)) {\n                log.warn(`Invalid simplify setting: ${action.simplifySize}`);\n                return state;\n            }\n            return { brushSize, simplifySize: Math.max(0, action.simplifySize), brushType };\n        case CHANGE_BRUSH_TYPE:\n            return { brushSize, simplifySize, brushType: String(action.brush) };\n        default:\n            return state;\n    }\n};\n\n// Action creators ==================================\nconst changeBrushSize = function (brushSize) {\n    return {\n        type: CHANGE_BRUSH_SIZE,\n        brushSize: brushSize\n    };\n};\n\nconst changeSimplifySize = function (simplifySize) {\n    return {\n        type: CHANGE_SIMPLIFY_SIZE,\n        simplifySize: simplifySize\n    };\n};\n\nconst setBrushType = function (type) {\n    return {\n        type: CHANGE_BRUSH_TYPE,\n        brush: type\n    };\n};\n\nexport {\n    reducer as default,\n    changeBrushSize,\n    changeSimplifySize,\n    setBrushType,\n};\n"],"mappings":"AAAA,OAAOA,GAAG,MAAM,YAAY;AAE5B,MAAMC,iBAAiB,GAAG,4CAA4C;AACtE,MAAMC,oBAAoB,GAAG,+CAA+C;AAC5E,MAAMC,iBAAiB,GAAG,4CAA4C;AACtE,MAAMC,YAAY,GAAG;EAAEC,SAAS,EAAE,EAAE;EAAEC,YAAY,EAAE,EAAE;EAAEC,SAAS,EAAE;AAAS,CAAC;AAE7E,MAAMC,OAAO,GAAG,SAAVA,OAAOA,CAAaC,KAAK,EAAEC,MAAM,EAAE;EACrC,IAAI,OAAOD,KAAK,KAAK,WAAW,EAAEA,KAAK,GAAGL,YAAY;EACtD,IAAI;IAACE,YAAY;IAAED,SAAS;IAAEE;EAAS,CAAC,GAAGE,KAAK;EAChD,QAAQC,MAAM,CAACC,IAAI;IACf,KAAKV,iBAAiB;MAClB,IAAIW,KAAK,CAACF,MAAM,CAACL,SAAS,CAAC,EAAE;QACzBL,GAAG,CAACa,IAAI,wBAAAC,MAAA,CAAwBJ,MAAM,CAACL,SAAS,CAAE,CAAC;QACnD,OAAOI,KAAK;MAChB;MACA,OAAO;QAAEJ,SAAS,EAAEU,IAAI,CAACC,GAAG,CAAC,CAAC,EAAEN,MAAM,CAACL,SAAS,CAAC;QAAEC,YAAY;QAAEC;MAAU,CAAC;IAChF,KAAKL,oBAAoB;MACrB,IAAIU,KAAK,CAACF,MAAM,CAACJ,YAAY,CAAC,EAAE;QAC5BN,GAAG,CAACa,IAAI,8BAAAC,MAAA,CAA8BJ,MAAM,CAACJ,YAAY,CAAE,CAAC;QAC5D,OAAOG,KAAK;MAChB;MACA,OAAO;QAAEJ,SAAS;QAAEC,YAAY,EAAES,IAAI,CAACC,GAAG,CAAC,CAAC,EAAEN,MAAM,CAA