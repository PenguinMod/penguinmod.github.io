{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\addons\\addons\\pick-colors-from-stage\\userscript.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\addons\\addons\\pick-colors-from-stage\\userscript.js","mtime":1777076878427},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["_ref","addon","msg","console","brand","Symbol","setIsPicking","picking","document","body","classList","toggle","isMostRecentClickUserInitiated","addEventListener","e","isTrusted","capture","tab","redux","initialize","action","detail","self","disabled","type","dispatch","callback","color","queueMicrotask","_objectSpread","previousMode","activate","state","scratchGui","colorPicker","active"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/src/addons/addons/pick-colors-from-stage/userscript.js"],"sourcesContent":["export default async function ({ addon, msg, console }) {\n  const brand = Symbol();\n\n  const setIsPicking = (picking) => document.body.classList.toggle(\"sa-stage-color-picker-picking\", picking);\n\n  // We only want to handle color picker events from the user clicking on the button, not from\n  // addons or other scripts pressing it with click().\n  let isMostRecentClickUserInitiated = false;\n  document.addEventListener(\n    \"click\",\n    (e) => {\n      isMostRecentClickUserInitiated = e.isTrusted;\n    },\n    {\n      capture: true,\n    }\n  );\n\n  addon.tab.redux.initialize();\n  addon.tab.redux.addEventListener(\"statechanged\", (e) => {\n    const action = e.detail.action;\n\n    // Do not process events emitted by ourselves.\n    if (action[brand]) {\n      return;\n    }\n\n    if (\n      !addon.self.disabled &&\n      isMostRecentClickUserInitiated &&\n      action.type === \"scratch-paint/eye-dropper/ACTIVATE_COLOR_PICKER\"\n    ) {\n      setIsPicking(true);\n\n      // When scratch-paint's color picker is activated, also activate scratch-gui's color picker.\n      addon.tab.redux.dispatch({\n        type: \"scratch-gui/color-picker/ACTIVATE_COLOR_PICKER\",\n        callback: (color) => {\n          // callback is called from reducer; do not dispatch events in reducer\n          queueMicrotask(() => {\n            // By the time we get here, scratch-paint will have already deactivated its eye dropper.\n            // If we were to just call the callback, the color would indeed update, but the sliders\n            // in the color selector would not update.\n            // https://github.com/LLK/scratch-paint/blob/970b72c3e75d0ad44ab54e403a44786ca5f45512/src/containers/color-picker.jsx#L64\n            // To work around this, we will re-enable the color picker before running the callback.\n            addon.tab.redux.dispatch({\n              ...action,\n              [brand]: true,\n            });\n            action.callback(color);\n            if (action.previousMode) {\n              action.previousMode.activate();\n            }\n            addon.tab.redux.dispatch({\n              type: \"scratch-paint/eye-dropper/DEACTIVATE_COLOR_PICKER\",\n              [brand]: true,\n            });\n            setIsPicking(false);\n          });\n        },\n      });\n    }\n\n    // Don't check for addon being disabled here in case we were dynamically disabled while color\n    // picking. This code won't do anything anyways when the previous code doesn't run.\n    if (action.type === \"scratch-paint/eye-dropper/DEACTIVATE_COLOR_PICKER\") {\n      setIsPicking(false);\n\n      // When someone selects a color in the scratch-paint picker, cancel the scratch-gui picker\n      if (addon.tab.redux.state.scratchGui.colorPicker.active) {\n        addon.tab.redux.dispatch({\n          type: \"scratch-gui/color-picker/DEACTIVATE_COLOR_PICKER\",\n          [brand]: true,\n        });\n      }\n    }\n  });\n}\n"],"mappings":";;;;;AAAA,eAAe,gBAAAA,IAAA,EAAyC;EAAA,IAAzB;IAAEC,KAAK;IAAEC,GAAG;IAAEC;EAAQ,CAAC,GAAAH,IAAA;EACpD,MAAMI,KAAK,GAAGC,MAAM,CAAC,CAAC;EAEtB,MAAMC,YAAY,GAAIC,OAAO,IAAKC,QAAQ,CAACC,IAAI,CAACC,SAAS,CAACC,MAAM,CAAC,+BAA+B,EAAEJ,OAAO,CAAC;;EAE1G;EACA;EACA,IAAIK,8BAA8B,GAAG,KAAK;EAC1CJ,QAAQ,CAACK,gBAAgB,CACvB,OAAO,EACNC,CAAC,IAAK;IACLF,8BAA8B,GAAGE,CAAC,CAACC,SAAS;EAC9C,CAAC,EACD;IACEC,OAAO,EAAE;EACX,CACF,CAAC;EAEDf,KAAK,CAACgB,GAAG,CAACC,KAAK,CAACC,UAAU,CAAC,CAAC;EAC5BlB,KAAK,CAACgB,GAAG,CAACC,KAAK,CAACL,gBAAgB,CAAC,cAAc,EAAGC,CAAC,IAAK;IACtD,MAAMM,MAAM,GAAGN,CAAC,CAACO,MAAM,CAACD,MAAM;;IAE9B;IACA,IAAIA,MAAM,CAAChB,KAAK,CAAC,EAAE;MACjB;IACF;IAEA,IACE,CAACH,KAAK,CAACqB,IAAI,CAACC,QAAQ,IACpBX,8BAA8B,IAC9BQ,MAAM,CAACI,IAAI,KAAK,iDAAiD,EACjE;MACAlB,YAAY,CAAC,IAAI,CAAC;;MAElB;MACAL,KAAK,CAACgB,GAAG,CAACC,KAAK,CAACO,QAAQ,CAAC;QACvBD,IAAI,EAAE,gDAAgD;QACtDE,QAAQ,EAAGC,KAAK,IAAK;UACnB;UACAC,cAAc,CAAC,MAAM;YACnB;YACA;YACA;YACA;YACA;YACA3B,KAAK,CAACgB,GAAG,CAACC,KAAK,CAACO,QAAQ,CAAAI,aAAA,CAAAA,aAAA,KACnBT,MAAM;cACT,CAAChB,KAAK,GAAG;YAAI,EACd,CAAC;YACFgB,MAAM,CAACM,QAAQ,CAACC,KAAK,CAAC;YACtB,IAAIP,MAAM,CAACU,YAAY,EAAE;cACvBV,MAAM,CAACU,YAAY,CAACC,QAAQ,CAAC,CAAC;YAChC;YACA9B,KAAK,CAACgB,GAAG,CAACC,KAAK,CAACO,QAAQ,CAAC;cACvBD,IAAI,EAAE,mDAAmD;cACzD,CAACpB,KAAK,GAAG;YACX,CAAC,CAAC;YACFE,YAAY,CAAC,KAAK,CAAC;UACrB,CAAC,CAAC;QACJ;MACF,CAAC,CAAC;IACJ;;IAEA;IACA;IACA,IAAIc,MAAM,CAACI,IAAI,KAAK,mDAAmD,EAAE;MACvElB,YAAY,CAAC,KAAK,CAAC;;MAEnB;MACA,IAAIL,KAAK,CAACgB,GAAG,CAACC,KAAK,CAACc,KAAK,CAACC,UAAU,CAACC,WAAW,CAACC,MAAM,EAAE;QACvDlC,KAAK,CAACgB,GAAG,CAACC,KAAK,CAACO,QAAQ,CAAC;UACvBD,IAAI,EAAE,kDAAkD;UACxD,CAACpB,KAAK,GAAG;QACX,CAAC,CAAC;MACJ;IACF;EACF,CAAC,CAAC;AACJ","ignoreList":[]