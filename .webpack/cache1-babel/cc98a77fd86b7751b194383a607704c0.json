;\n        this.width = Math.max(Number(width), Comment.MIN_WIDTH);\n        this.height = Math.max(Number(height), Comment.MIN_HEIGHT);\n        this.minimized = minimized || false;\n        this.blockId = null;\n    }\n\n    toXML () {\n        return `<comment id=\"${this.id}\" x=\"${this.x}\" y=\"${\n            this.y}\" w=\"${this.width}\" h=\"${this.height}\" pinned=\"${\n            this.blockId !== null}\" minimized=\"${this.minimized}\">${xmlEscape(this.text)}</comment>`;\n    }\n\n    // TODO choose min and defaults for width and height\n    static get MIN_WIDTH () {\n        return 20;\n    }\n\n    static get MIN_HEIGHT () {\n        return 20;\n    }\n\n    static get DEFAULT_WIDTH () {\n        return 100;\n    }\n\n    static get DEFAULT_HEIGHT () {\n        return 100;\n    }\n\n}\n\nmodule.exports = Comment;\n"],"mappings":"AAAA;AACA;AACA;AACA;;AAEA,MAAMA,GAAG,GAAGC,OAAO,CAAC,aAAa,CAAC;AAClC,MAAMC,SAAS,GAAGD,OAAO,CAAC,oBAAoB,CAAC;AAE/C,MAAME,OAAO,CAAC;EACV;AACJ;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;EACIC,WAAWA,CAAEC,EAAE,EAAEC,IAAI,EAAEC,CAAC,EAAEC,CAAC,EAAEC,KAAK,EAAEC,MAAM,EAAEC,SAAS,EAAE;IACnD,IAAI,CAACN,EAAE,GAAGA,EAAE,IAAIL,GAAG,CAAC,CAAC;IACrB,IAAI,CAACM,IAAI,GAAGA,IAAI;IAChB,IAAI,CAACC,CAAC,GAAGA,CAAC;IACV,IAAI,CAACC,CAAC,GAAGA,CAAC;IACV,IAAI,CAACC,KAAK,GAAGG,IAAI,CAACC,GAAG,CAACC,MAAM,CAACL,KAAK,CAAC,EAAEN,OAAO,CAACY,SAAS,CAAC;IACvD,IAAI,CAACL,MAAM,GAAGE,IAAI,CAACC,GAAG,CAACC,MAAM,CAACJ,MAAM,CAAC,EAAEP,OAAO,CAACa,UAAU,CAAC;IAC1D,IAAI,CAACL,SAAS,GAAGA,SAAS,IAAI,KAAK;IACnC,IAAI,CAACM,OAAO,GAAG,IAAI;EACvB;EAEAC,KAAKA,CAAA,EAAI;IACL,wBAAAC,MAAA,CAAuB,IAAI,CAACd,EAAE,aAAAc,MAAA,CAAQ,IAAI,CAACZ,CAAC,aAAAY,MAAA,CACxC,IAAI,CAACX,CAAC,aAAAW,MAAA,CAAQ,IAAI,CAACV,KAAK,aAAAU,MAAA,CAAQ,IAAI,CAACT,MAAM,kBAAAS,MAAA,CAC3C,IAAI,CAACF,OAAO,KAAK,IAAI,qBAAAE,MAAA,CAAgB,IAAI,CAACR,SAAS,SAAAQ,MAAA,CAAKjB,SAAS,CAAC,IAAI,CAACI,IAAI,CAAC;EACpF;;EAEA;EACA,WAAWS,SAASA,CAAA,EAAI;IACpB,OAAO,EAAE;EACb;EAEA,WAAWC,UAAUA,CAAA,EAAI;IACrB,OAAO,EAAE;EACb;EAEA,WAAWI,aAAaA,CA