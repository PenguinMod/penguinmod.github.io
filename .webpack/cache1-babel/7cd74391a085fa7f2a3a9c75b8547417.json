ly.\n// See reducers/fill-style.js for other ways gradient type changes.\nconst changeGradientType = function (gradientType) {\n    return {\n        type: CHANGE_FILL_GRADIENT_TYPE,\n        gradientType: gradientType\n    };\n};\n\nexport {\n    reducer as default,\n    changeGradientType\n};\n"],"mappings":"AAAA;AACA;AACA,OAAOA,aAAa,MAAM,uBAAuB;AACjD,OAAOC,GAAG,MAAM,YAAY;AAC5B,SAAQC,yBAAyB,QAAO,cAAc;AAEtD,MAAMC,YAAY,GAAG,IAAI;AAEzB,MAAMC,OAAO,GAAG,SAAVA,OAAOA,CAAaC,KAAK,EAAEC,MAAM,EAAE;EACrC,IAAI,OAAOD,KAAK,KAAK,WAAW,EAAEA,KAAK,GAAGF,YAAY;EACtD,QAAQG,MAAM,CAACC,IAAI;IACnB,KAAKL,yBAAyB;MAC1B,IAAII,MAAM,CAACE,YAAY,IAAIR,aAAa,EAAE;QACtC,OAAOM,MAAM,CAACE,YAAY;MAC9B;MACAP,GAAG,CAACQ,IAAI,kCAAAC,MAAA,CAAkCJ,MAAM,CAACE,YAAY,CAAE,CAAC;IAChE;IACJ;MACI,OAAOH,KAAK;EAChB;AACJ,CAAC;;AAED;AACA;AACA;AACA,MAAMM,kBAAkB,GAAG,SAArBA,kBAAkBA,CAAaH,YAAY,EAAE;EAC/C,OAAO;IACHD,IAAI,EAAEL,yBAAyB;IAC/BM,YAAY,EAAEA;EAClB,CAAC;AACL,CAAC;AAED,SACIJ,OAAO,IAAIQ,OAAO,EAClBD,kBAAkB","ignoreList":[]}]}