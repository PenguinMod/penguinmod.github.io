         <div\n                        className={styles.stageBottomWrapper}\n                        style={{\n                            width: stageDimensions.width,\n                            height: stageDimensions.height\n                        }}\n                    >\n                        {micIndicator ? (\n                            <MicIndicator\n                                className={styles.micIndicator}\n                                stageSize={stageDimensions}\n                            />\n                        ) : null}\n                        {question === null ? null : (\n                            <div\n                                className={styles.questionWrapper}\n                                style={{width: stageDimensions.width}}\n                            >\n                                <Question\n                                    question={question}\n                                    onQuestionAnswered={onQuestionAnswered}\n                                />\n                            </div>\n                        )}\n                    </div>\n                    <canvas\n                        className={styles.draggingSprite}\n                        height={0}\n                        ref={dragRef}\n                        width={0}\n                    />\n                </Box>\n                {isStarted ? null : (\n                    <GreenFlagOverlay\n                        className={styles.greenFlagOverlay}\n                        wrapperClass={styles.greenFlagOverlayWrapper}\n                    />\n                )}\n            </Box>\n            {isColorPicking ? (\n                <Box\n                    className={styles.colorPickerBackground}\n                    onClick={onDeactivateColorPicker}\n                />\n            ) : null}\n        </React.Fragment>\n    );\n};\nStageComponent.propTypes = {\n    canvas: PropTypes.instanceOf(Element).isRequired,\n    customStageSize: PropTypes.shape({\n        width: PropTypes.number,\n        height: PropTypes.number\n    }),\n    overlay: PropTypes.instanceOf(Element).isRequired,\n    colorInfo: Loupe.propTypes.colorInfo,\n    dragRef: PropTypes.func,\n    isColorPicking: PropTypes.bool,\n    isFullScreen: PropTypes.bool.isRequired,\n    isPlayerOnly: PropTypes.bool,\n    isStarted: PropTypes.bool,\n    micIndicator: PropTypes.bool,\n    onDeactivateColorPicker: PropTypes.func,\n    onDoubleClick: PropTypes.func,\n    onQuestionAnswered: PropTypes.func,\n    question: PropTypes.string,\n    stageSize: PropTypes.oneOf(Object.keys(STAGE_DISPLAY_SIZES)).isRequired,\n    useEditorDragStyle: PropTypes.bool\n};\nStageComponent.defaultProps = {\n    dragRef: () => {}\n};\nexport default StageComponent;\n"],"mappings":";;;;;;;;;AAAA,OAAOA,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,OAAOC,UAAU,MAAM,YAAY;AAEnC,OAAOC,GAAG,MAAM,gBAAgB;AAChC,OAAOC,kBAAkB,MAAM,2CAA2C;AAC1E,OAAOC,KAAK,MAAM,oBAAoB;AACtC,OAAOC,WAAW,MAAM,mCAAmC;AAC3D,OAAOC,eAAe,MAAM,uCAAuC;AACnE,OAAOC,gBAAgB,MAAM,yCAAyC;AACtE,OAAOC,QAAQ,MAAM,+BAA+B;AACpD,OAAOC,YAAY,MAAM,oCAAoC;AAC7D,SAAQC,mBAAmB,QAAO,+BAA+B;AACjE,SAAQC,kBAAkB,EAAEC,WAAW,QAAO,2BAA2B;AACzE,OAAOC,MAAM,MAAM,aAAa;AAEhC,MAAMC,cAAc,GAAGC,KAAK,IAAI;EAC5B,MAAM;MACFC,MAAM;MACNC,eAAe;MACfC,OAAO;MACPC,cAAc;MACdC,YAAY;MACZC,YAAY;MACZC,SAAS;MACTC,SAAS;MACTC,YAAY;MACZC,QAAQ;MACRC,SAAS;MACTC,kBAAkB;MAClBC,uBAAuB;MACvBC,aAAa;MACbC;IAEJ,CAAC,GAAGf,KAAK;IADFgB,QAAQ,GAAAC,wBAAA,CACXjB,KAAK,EAAAkB,SAAA;EAET,MAAMC,eAAe,GAAGvB,kBAAkB,CAACe,SAAS,EAAET,eAAe,EAAEG,YAAY,CAAC;EACpF,MAAMe,QAAQ,GAAGvB,WAAW,CAACc,SAAS,CAAC;EACvC,MAAMU,cAAc,GAAGF,eAAe,CAACG,KAAK,GAAGF,QAAQ,IAAI,CAACf,YAAY,GAAG;IACvEkB,SAAS,gBAAAC,MAAA,CAAgB,CAACJ,QAAQ,GAAGD,eAAe,CAACG,KAAK,IAAI,CAAC;EACnE,CAAC,GAAG,CAAC,CAAC;EAEN,oBACIrC,KAAA,CAAAwC,aAAA,CAACxC,KAAK,CAACyC,QAAQ,qBACXzC,KAAA,CAAAwC,aAAA,CAACtC,GAAG;IACAwC,SAAS,EAAEzC,UAAU,CACjBY,MAAM,CAAC8B,YAAY,EACnB;MAAC,CAAC9B,MAAM,CAAC+B,eAAe,GAAG,CAACxB,YAAY,IAAID;IAAc,CAAC,CAAE