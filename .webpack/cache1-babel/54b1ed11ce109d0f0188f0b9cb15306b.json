{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\components\\menu-bar\\share-button.jsx","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\components\\menu-bar\\share-button.jsx","mtime":1777076879428},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["classNames","connect","FormattedMessage","injectIntl","PropTypes","React","bindAll","Button","loadingIcon","styles","getProjectThumbnail","Promise","resolve","window","vm","renderer","requestSnapshot","uri","getProjectUri","saveProjectSb3","then","blob","reader","FileReader","onload","element","target","result","readAsDataURL","isUploadAvailable","res","fetch","json","_unused","canUpload","ShareButton","Component","constructor","props","state","loading","imageUri","componentDidMount","addEventListener","wrapperEventHandler","componentWillUnmount","removeEventListener","e","handleMessageEvent","origin","startsWith","data","p4","packagerData","type","source","postMessage","projectUri","onUploadProject","runtime","dataUrl","setState","draw","setTimeout","available","_this$props$extraProj","_this$props$extraProj2","console","warn","alert","isEdit","usernameLoggedIn","extraProjectInfo","author","username","editPiece","remixPiece","id","location","hash","replace","isRemix","concat","targetPage","projectTitle","encodeURIComponent","url","open","render","_this$props$extraProj3","_this$props$extraProj4","createElement","className","shareButton","shareButtonIsShared","isShared","disabled","onClick","shareContent","defaultMessage","icon","draggable","src","height","width","propTypes","string","bool","shape","accepted","remixId","number","tooLarge","releaseDate","Date","isUpdated","mapStateToProps","scratchGui","tw","mapDispatchToProps","dispatch"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/src/components/menu-bar/share-button.jsx"],"sourcesContent":["import classNames from 'classnames';\nimport { connect } from 'react-redux';\nimport { FormattedMessage, injectIntl } from 'react-intl';\nimport PropTypes from 'prop-types';\nimport React from 'react';\nimport bindAll from 'lodash.bindall';\nimport Button from '../button/button.jsx';\n\nimport loadingIcon from './share-loading.svg';\nimport styles from './share-button.css';\n\nconst getProjectThumbnail = () => new Promise(resolve => {\n    window.vm.renderer.requestSnapshot(uri => {\n        resolve(uri);\n    });\n});\nconst getProjectUri = () => new Promise(resolve => {\n    window.vm.saveProjectSb3().then(blob => new Promise(resolve => {\n        const reader = new FileReader();\n        reader.onload = element => {\n            resolve(element.target.result);\n        };\n        reader.readAsDataURL(blob);\n    }))\n        .then(resolve);\n});\n\nconst isUploadAvailable = async () => {\n    let res = null;\n    try {\n        res = await fetch('https://projects.penguinmod.com/api/v1/projects/canuploadprojects').then(res => res.json());\n    } catch {\n        // failed to fetch entirely\n        return false;\n    }\n    return res.canUpload;\n};\n\nclass ShareButton extends React.Component {\n    constructor(props) {\n        super(props);\n        bindAll(this, [\n            'handleMessageEvent',\n            'wrapperEventHandler',\n            'onUploadProject'\n        ]);\n        this.state = {\n            loading: false,\n            imageUri: ''\n        };\n    }\n    componentDidMount() {\n        window.addEventListener('message', this.wrapperEventHandler);\n    }\n    componentWillUnmount() {\n        window.removeEventListener('message', this.wrapperEventHandler);\n    }\n\n    wrapperEventHandler(e) {\n        this.handleMessageEvent(e);\n    }\n    async handleMessageEvent(e) {\n        if (!e.origin.startsWith(`https://penguinmod.com`)) {\n            return;\n        }\n\n        if (!e.data.p4) {\n            return;\n        }\n\n        const packagerData = e.data.p4;\n        if (packagerData.type !== 'validate') {\n            return;\n        }\n\n        const imageUri = this.state.imageUri;\n        e.source.postMessage({\n            p4: {\n                type: 'image',\n                uri: imageUri\n            }\n        }, e.origin);\n        const projectUri = await getProjectUri();\n        e.source.postMessage({\n            p4: {\n                type: 'project',\n                uri: projectUri\n            }\n        }, e.origin);\n\n        e.source.postMessage({\n            p4: {\n                type: 'finished'\n            }\n        }, e.origin);\n    }\n    async onUploadProject() {\n        if (this.state.loading) return;\n        if (!window.vm) return;\n        if (!window.vm.runtime) return;\n        if (!window.vm.renderer) return;\n\n        // get the project thumbnail\n        await new Promise((resolve) => {\n            getProjectThumbnail().then(dataUrl => {\n                this.setState({\n                    imageUri: dataUrl\n                });\n                resolve();\n            });\n            window.vm.renderer.draw(); // force the callback to run\n            setTimeout(() => {\n                window.vm.renderer.draw(); // force the callback to run\n            }, 50);\n            setTimeout(() => {\n                window.vm.renderer.draw(); // force the callback to run\n            }, 100);\n        });\n\n        this.setState({\n            loading: true\n        });\n        isUploadAvailable().then(available => {\n            this.setState({\n                loading: false\n            });\n            if (!available) {\n                // error?\n                console.warn('Project Server did not respond. Uploading is not available.');\n                alert('Uploading is currently unavailable. Please wait for the server to be restored.');\n                return;\n            }\n\n            const isEdit = this.props.usernameLoggedIn\n                && this.props.extraProjectInfo?.author === this.props.username;\n\n            let editPiece = '';\n            let remixPiece = '';\n            const id = location.hash.replace('#', '');\n            if (this.props.extraProjectInfo?.isRemix) {\n                remixPiece = `&remix=${id}`;\n            }\n\n            let targetPage = 'upload';\n            if (isEdit) {\n                targetPage = 'edit';\n                editPiece = `&id=${id}`;\n            }\n\n            const projectTitle = encodeURIComponent(this.props.projectTitle);\n            const url = location.origin;\n            window.open(`https://penguinmod.com/${targetPage}?name=${projectTitle}${editPiece}${remixPiece}&external=${url}`, '_blank');\n        });\n    }\n    render() {\n        const isRemix = this.props.extraProjectInfo?.isRemix;\n        const isEdit = this.props.usernameLoggedIn\n            && this.props.extraProjectInfo?.author === this.props.username;\n        return (\n            <Button\n                className={classNames(\n                    this.props.className,\n                    styles.shareButton,\n                    { [styles.shareButtonIsShared]: this.props.isShared },\n                    { [styles.disabled]: this.state.loading },\n                )}\n                onClick={this.onUploadProject}\n            >\n                <div className={classNames(styles.shareContent)}>\n                    {isEdit ? <FormattedMessage\n                            defaultMessage=\"Upload Edits\"\n                            description=\"Text for uploading edits for projects on PenguinMod\"\n                            id=\"pm.menuBar.pmedit\"\n                        /> :\n                        (isRemix ?\n                            <FormattedMessage\n                                defaultMessage=\"Remix\"\n                                description=\"Menu bar item for remixing\"\n                                id=\"gui.menuBar.remix\"\n                            /> :\n                            <FormattedMessage\n                                defaultMessage=\"Upload\"\n                                description=\"Label for project share button\"\n                                id=\"pm.menuBar.pmshare\"\n                            />)}\n                    {this.state.loading ? (\n                        <img\n                            className={classNames(styles.icon)}\n                            draggable={false}\n                            src={loadingIcon}\n                            height={20}\n                            width={20}\n                        />\n                    ) : null}\n                </div>\n            </Button>\n        );\n    }\n}\n\nShareButton.propTypes = {\n    className: PropTypes.string,\n    isShared: PropTypes.bool,\n    projectTitle: PropTypes.string,\n    extraProjectInfo: PropTypes.shape({\n        accepted: PropTypes.bool,\n        isRemix: PropTypes.bool,\n        remixId: PropTypes.number,\n        tooLarge: PropTypes.bool,\n        author: PropTypes.string,\n        releaseDate: PropTypes.shape(Date),\n        isUpdated: PropTypes.bool\n    }),\n    username: PropTypes.string,\n    usernameLoggedIn: PropTypes.bool\n};\n\nconst mapStateToProps = state => ({\n    projectTitle: state.scratchGui.projectTitle,\n    extraProjectInfo: state.scratchGui.tw.extraProjectInfo,\n    username: state.scratchGui.tw.username,\n    usernameLoggedIn: state.scratchGui.tw.usernameLoggedIn\n});\n\n// eslint-disable-next-line no-unused-vars\nconst mapDispatchToProps = dispatch => ({});\n\nexport default injectIntl(connect(\n    mapStateToProps,\n    mapDispatchToProps\n)(ShareButton));\n"],"mappings":"AAAA,OAAOA,UAAU,MAAM,YAAY;AACnC,SAASC,OAAO,QAAQ,aAAa;AACrC,SAASC,gBAAgB,EAAEC,UAAU,QAAQ,YAAY;AACzD,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,OAAOC,OAAO,MAAM,gBAAgB;AACpC,OAAOC,MAAM,MAAM,sBAAsB;AAEzC,OAAOC,WAAW,MAAM,qBAAqB;AAC7C,OAAOC,MAAM,MAAM,oBAAoB;AAEvC,MAAMC,mBAAmB,GAAGA,CAAA,KAAM,IAAIC,OAAO,CAACC,OAAO,IAAI;EACrDC,MAAM,CAACC,EAAE,CAACC,QAAQ,CAACC,eAAe,CAACC,GAAG,IAAI;IACtCL,OAAO,CAACK,GAAG,CAAC;EAChB,CAAC,CAAC;AACN,CAAC,CAAC;AACF,MAAMC,aAAa,GAAGA,CAAA,KAAM,IAAIP,OAAO,CAACC,OAAO,IAAI;EAC/CC,MAAM,CAACC,EAAE,CAACK,cAAc,CAAC,CAAC,CAACC,IAAI,CAACC,IAAI,IAAI,IAAIV,OAAO,CAACC,OAAO,IAAI;IAC3D,MAAMU,MAAM,GAAG,IAAIC,UAAU,CAAC,CAAC;IAC/BD,MAAM,CAACE,MAAM,GAAGC,OAAO,IAAI;MACvBb,OAAO,CAACa,OAAO,CAACC,MAAM,CAACC,MAAM,CAAC;IAClC,CAAC;IACDL,MAAM,CAACM,aAAa,CAACP,IAAI,CAAC;EAC9B,CAAC,CAAC,CAAC,CACED,IAAI,CAACR,OAAO,CAAC;AACtB,CAAC,CAAC;AAEF,MAAMiB,iBAAiB,GAAG,MAAAA,CAAA,KAAY;EAClC,IAAIC,GAAG,GAAG,IAAI;EACd,IAAI;IACAA,GAAG,GAAG,MAAMC,KAAK,CAAC,mEAAmE,CAAC,CAACX,IAAI,CAACU,GAAG,IAAIA,GAAG,CAACE,IAAI,CAAC,CAAC,CAAC;EAClH,CAAC,CAAC,OAAAC,OAAA,EAAM;IACJ;IACA,OAAO,KAAK;EAChB;EACA,OAAOH,GAAG,CAACI,SAAS;AACxB,CAAC;AAED,MAAMC,WAAW,SAAS9B,KAAK,CAAC+B,SAAS,CAAC;EACtCC,WAAWA,CAACC,KAAK,EAAE;IACf,KAAK,CAACA,KAAK,CAAC;IACZhC,OAAO,CAAC,IAAI,EAAE,CACV,oBAAoB,EACpB,qBAAqB,EACrB,iBAAiB,CACpB,CAAC;IACF,IAAI,CAACiC,KAAK,GAAG;MACTC,OAAO,EAAE,KAAK;MACdC,QAAQ,EAAE;IACd,CAAC;EACL;EACAC,iBAAiBA,CAAA,EAAG;IAChB7B,MAAM,CAAC8B,gBAAgB,CAAC,SAAS,EAAE,IAAI,CAACC,mBAAmB,CAAC;EAChE;EACAC,oBAAoBA,CAAA,EAAG;IACnBhC,MAAM,CAACiC,mBAAmB,CAAC,SAAS,EAAE,IAAI,CAACF,mBAAmB,CAAC;EACnE;EAEAA,mBAAmBA,CAACG,CAAC,EAAE;IACnB,IAAI,CAACC,kBAAkB,CAACD,CAAC,CAAC;EAC9B;EACA,MAAMC,kBAAkBA,CAACD,CAAC,EAAE;IACxB,IAAI,CAACA,CAAC,CAACE,MAAM,CAACC,UAAU,yBAAyB,CAAC,EAAE;MAChD;IACJ;IAEA,IAAI,CAACH,CAAC,CAACI,IAAI,CAACC,EAAE,EAAE;MACZ;IACJ;IAEA,MAAMC,YAAY,GAAGN,CAAC,CAACI,IAAI,CAACC,EAAE;IAC9B,IAAIC,YAAY,CAACC,IAAI,KAAK,UAAU,EAAE;MAClC;IACJ;IAEA,MAA