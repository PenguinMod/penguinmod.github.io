         listening={this.state.listening}\n                onRecord={this.handleRecord}\n                onStopRecording={this.handleStopRecording}\n                {...componentProps}\n            />\n        );\n    }\n}\n\nRecordingStep.propTypes = {\n    intl: intlShape.isRequired,\n    onRecord: PropTypes.func.isRequired,\n    onStopRecording: PropTypes.func.isRequired,\n    recording: PropTypes.bool\n};\n\nexport default injectIntl(RecordingStep);\n"],"mappings":";;;;AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,OAAO,MAAM,gBAAgB;AACpC,OAAOC,sBAAsB,MAAM,+CAA+C;AAClF,OAAOC,aAAa,MAAM,gCAAgC;AAC1D,SAAQC,cAAc,EAAEC,UAAU,EAAEC,SAAS,QAAO,YAAY;AAChE,OAAOC,GAAG,MAAM,YAAY;AAE5B,MAAMC,QAAQ,GAAGJ,cAAc,CAAC;EAC5BK,QAAQ;IAAA;IAAA;EAAA;AAKZ,CAAC,CAAC;AAEF,MAAMC,aAAa,SAASX,KAAK,CAACY,SAAS,CAAC;EACxCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZZ,OAAO,CAAC,IAAI,EAAE,CACV,cAAc,EACd,qBAAqB,EACrB,eAAe,EACf,mBAAmB,EACnB,sBAAsB,CACzB,CAAC;IAEF,IAAI,CAACa,KAAK,GAAG;MACTC,SAAS,EAAE,KAAK;MAChBC,KAAK,EAAE,CAAC;MACRC,MAAM,EAAE;IACZ,CAAC;EACL;EACAC,iBAAiBA,CAAA,EAAI;IACjB,IAAI,CAACC,aAAa,GAAG,IAAIhB,aAAa,CAAC,CAAC;IACxC,IAAI,CAACgB,aAAa,CAACC,cAAc,CAAC,IAAI,CAACC,aAAa,EAAE,IAAI,CAACC,iBAAiB,EAAE,IAAI,CAACC,oBAAoB,CAAC;EAC5G;EACAC,oBAAoBA,CAAA,EAAI;IACpB,IAAI,CAACL,aAAa,CAACM,OAAO,CAAC,CAAC;EAChC;EACAJ,aAAaA,CAAA,EAAI;IACb,IAAI,CAACK,QAAQ,CAAC;MAACX,SAAS,EAAE;IAAI,CAAC,CAAC;EACpC;EACAQ,oBAAoBA,CAAEI,KAAK,EAAE;IACzBpB,GAAG,CAACoB,KAAK,CAACA,KAAK,CAAC;IAChBC,KAAK,CAAC,IAAI,CAACf,KAAK,CAACgB,IAAI,CAACC,aAAa,CAACtB,QAAQ,CAACC,QAAQ,CAAC,CAAC,CAAC,CAAC;EAC7D;EACAa,iBAAiBA,CAAEN,KAAK,EAAE;IACtB,IAAI,CAACU,QAAQ,CAAC;MACVV,KAAK,EAAEA,KAAK;MACZC,MAAM,EAAE,IAAI,CAACJ,KAAK,CAACkB,SAAS,GAAG,CAAC,IAAI,CAACjB,KAAK,CAACG,MAAM,IAAI,EAAE,EAAEe,MAAM,CAAC,CAAChB,KAAK,CAAC,CAAC,GAAG,IAAI,CAACF,KAAK,CAACG;IAC1F,CAAC,CAAC;EACN;EACAgB,YAAYA,CAAA,EAAI;IACZ,IAAI,CAACd,aAAa,CAACe,cAAc,CAAC,CAAC;IACnC,IAAI,CAACrB,KAAK,CAACsB,QAAQ,CAAC,CAAC;EACzB;EACAC,mBAAmBA,CAAA,EAAI;IACnB,MAAM;MAACC,OA