e'\n        ]);\n\n        this.state = {\n            waiting: false\n        };\n    }\n    componentDidUpdate (prevProps) {\n        if (this.state.waiting && this.props.isShowingWithId && !prevProps.isShowingWithId) {\n            this.fulfill();\n        }\n    }\n    fulfill () {\n        this.props.onDoneUpdating();\n        this.setState({ // eslint-disable-line react/no-did-update-set-state\n            waiting: false\n        });\n    }\n    waitForUpdate (isUpdating) {\n        if (isUpdating) {\n            this.setState({\n                waiting: true\n            });\n        } else { // fulfill immediately\n            this.fulfill();\n        }\n    }\n    render () {\n        return this.props.children(\n            this.waitForUpdate\n        );\n    }\n}\n\nProjectWatcher.propTypes = {\n    children: PropTypes.func,\n    isShowingWithId: PropTypes.bool,\n    onDoneUpdating: PropTypes.func\n};\n\nProjectWatcher.defaultProps = {\n    onDoneUpdating: () => {}\n};\n\nconst mapStateToProps = state => {\n    const loadingState = state.scratchGui.projectState.loadingState;\n    return {\n        isShowingWithId: getIsShowingWithId(loadingState)\n    };\n};\n\nconst mapDispatchToProps = () => ({});\n\nexport default connect(\n    mapStateToProps,\n    mapDispatchToProps\n)(ProjectWatcher);\n"],"mappings":"AAAA,OAAOA,OAAO,MAAM,gBAAgB;AACpC,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,SAAQC,OAAO,QAAO,aAAa;AAEnC,SACIC,kBAAkB,QACf,2BAA2B;;AAElC;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAMC,cAAc,SAASH,KAAK,CAACI,SAAS,CAAC;EACzCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZR,OAAO,CAAC,IAAI,EAAE,CACV,eAAe,CAClB,CAAC;IAEF,IAAI,CAACS,KAAK,GAAG;MACTC,OAAO,EAAE;IACb,CAAC;EACL;EACAC,kBAAkBA,CAAEC,SAAS,EAAE;IAC3B,IAAI,IAAI,CAACH,KAAK,CAACC,OAAO,IAAI,IAAI,CAACF,KAAK,CAACK,eAAe,IAAI,CAACD,SAAS,CAACC,eAAe,EAAE;MAChF,IAAI,CAACC,OAAO,CAAC,CAAC;IAClB;EACJ;EACAA,OAAOA,CAAA,EAAI;IACP,IAAI,CAACN,KAAK,CAACO,cAAc,CAAC,CAAC;IAC3B,IAAI,CAACC,QAAQ,CAAC;MAAE;MACZN