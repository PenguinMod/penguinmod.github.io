{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\addons\\addons\\editor-devtools\\UndoGroup.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\addons\\addons\\editor-devtools\\UndoGroup.js","mtime":1777076878143},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["UndoGroup","startUndoGroup","workspace","undoStack","undoStack_","length","_devtoolsLastUndo","endUndoGroup","setTimeout","group","generateUID","i","CHARACTERS","result","Math","floor","random"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/src/addons/addons/editor-devtools/UndoGroup.js"],"sourcesContent":["/**\n * This class is dedicated to maintaining the Undo stack of Blockly\n * It allows us to initiate an undo group such that all subsequent operations are recorded as a single\n * undoable transaction.\n */\nexport default class UndoGroup {\n  /**\n   * Start an Undo group - begin recording\n   * @param workspace the workspace\n   */\n  static startUndoGroup(workspace) {\n    const undoStack = workspace.undoStack_;\n    if (undoStack.length) {\n      undoStack[undoStack.length - 1]._devtoolsLastUndo = true;\n    }\n  }\n\n  /**\n   * End an Undo group - stops recording\n   * @param workspace the workspace\n   */\n  static endUndoGroup(workspace) {\n    const undoStack = workspace.undoStack_;\n    // Events (responsible for undoStack updates) are delayed with a setTimeout(f, 0)\n    // https://github.com/LLK/scratch-blocks/blob/f159a1779e5391b502d374fb2fdd0cb5ca43d6a2/core/events.js#L182\n    setTimeout(() => {\n      const group = generateUID();\n      for (let i = undoStack.length - 1; i >= 0 && !undoStack[i]._devtoolsLastUndo; i--) {\n        undoStack[i].group = group;\n      }\n    }, 0);\n  }\n}\n\n/**\n * https://github.com/LLK/scratch-blocks/blob/f159a1779e5391b502d374fb2fdd0cb5ca43d6a2/core/events.js#L182\n * @returns {string}\n * @private\n */\nfunction generateUID() {\n  const CHARACTERS = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%()*+,-./:;=?@[]^_`{|}~\";\n  let result = \"\";\n  for (let i = 0; i < 20; i++) {\n    result += CHARACTERS[Math.floor(Math.random() * CHARACTERS.length)];\n  }\n  return result;\n}\n"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA,eAAe,MAAMA,SAAS,CAAC;EAC7B;AACF;AACA;AACA;EACE,OAAOC,cAAcA,CAACC,SAAS,EAAE;IAC/B,MAAMC,SAAS,GAAGD,SAAS,CAACE,UAAU;IACtC,IAAID,SAAS,CAACE,MAAM,EAAE;MACpBF,SAAS,CAACA,SAAS,CAACE,MAAM,GAAG,CAAC,CAAC,CAACC,iBAAiB,GAAG,IAAI;IAC1D;EACF;;EAEA;AACF;AACA;AACA;EACE,OAAOC,YAAYA,CAACL,SAAS,EAAE;IAC7B,MAAMC,SAAS,GAAGD,SAAS,CAACE,UAAU;IACtC;IACA;IACAI,UAAU,CAAC,MAAM;MACf,MAAMC,KAAK,GAAGC,WAAW,CAAC,CAAC;MAC3B,KAAK,IAAIC,CAAC,GAAGR,SAAS,CAACE,MAAM,GAAG,CAAC,EAAEM,CAAC,IAAI,CAAC,IAAI,CAACR,SAAS,CAACQ,CAAC,CAAC,CAACL,iBAAiB,EAAEK,CAAC,EAAE,EAAE;QACjFR,SAAS,CAACQ,CAAC,CAAC,CAACF,KAAK,GAAGA,KAAK;MAC5B;IACF,CAAC,EAAE,CAAC,CAAC;EACP;AACF;;AAEA;AACA;AACA;AACA;AACA;AACA,SAASC,WAAWA,CAAA,EAAG;EACrB,MAAME,UAAU,GAAG,0FAA0F;EAC7G,IAAIC,MAAM,GAAG,EAAE;EACf,KAAK,IAAIF,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAG,EAAE,EAAEA,CAAC,EAAE,EAAE;IAC3BE,MAAM,IAAID,UAAU,CAACE,IAAI,CAACC,KAAK,CAACD,IAAI,CAACE,MAAM,CAAC,CAAC,GAAGJ,UAAU,CAACP,MAAM,CAAC,CAAC;EACrE;EACA,OAAOQ,MAAM;AACf","ignoreList":[]}]}