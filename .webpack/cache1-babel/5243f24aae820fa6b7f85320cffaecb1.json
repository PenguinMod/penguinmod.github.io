n '&amp;';\n        case '\\'': return '&apos;';\n        case '\"': return '&quot;';\n        }\n    });\n};\n\n/**\n * creates escaped text suitible for attributes\n * @param {string} unsafe the contents to escape\n * @returns {string} escaped contents\n */\nconst escapeAttribute = unsafe => {\n    const escaped = xmlEscape(unsafe);\n    return JSON.stringify(escaped).slice(1, -1);\n};\n\nmodule.exports = xmlEscape;\nmodule.exports.escapeAttribute = escapeAttribute;\n"],"mappings":"AAAA,MAAMA,GAAG,GAAGC,OAAO,CAAC,OAAO,CAAC;;AAE5B;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAMC,SAAS,GAAG,SAAZA,SAASA,CAAaC,MAAM,EAAE;EAChC,IAAI,OAAOA,MAAM,KAAK,QAAQ,EAAE;IAC5B,IAAIC,KAAK,CAACC,OAAO,CAACF,MAAM,CAAC,EAAE;MACvB;MACA;MACAA,MAAM,GAAGG,MAAM,CAACH,MAAM,CAAC;IAC3B,CAAC,MAAM;MACHH,GAAG,CAACO,IAAI,qBAAAC,MAAA,CAAqB,OAAOL,MAAM,wBAAAK,MAAA,CAAqB,IAAIC,KAAK,CAAC,CAAC,CAACC,KAAK,CAAE,CAAC;MACnF,OAAOP,MAAM;IACjB;EACJ;EACA,OAAOA,MAAM,CAACQ,OAAO,CAAC,UAAU,EAAEC,CAAC,IAAI;IACnC,QAAQA,CAAC;MACT,KAAK,GAAG;QAAE,OAAO,MAAM;MACvB,KAAK,GAAG;QAAE,OAAO,MAAM;MACvB,KAAK,GAAG;QAAE,OAAO,OAAO;MACxB,KAAK,IAAI;QAAE,OAAO,QAAQ;MAC1B,KAAK,GAAG;QAAE,OAAO,QAAQ;IACzB;EACJ,CAAC,CAAC;AACN,CAAC;;AAED;AACA;AACA;AACA;AACA;AACA,MAAMC,eAAe,GAAGV,MAAM,IAAI;EAC9B,MAAMW,OAAO,GAAGZ,SAAS,CAACC,MAAM,CAAC;EACjC,OAAOY,IAAI,CAACC,SAAS,CAACF,OAAO,CAAC,CAACG,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC;AAC/C,CAAC;AAEDC,MAAM,CAACC,OAAO,GAAGjB,SAAS;AAC1BgB,MAAM,CAACC,OAAO,CAACN,eAAe,GAAGA,eAAe","ignoreList":[]}]}