rops);\n        bindAll(this, [\n            'wrapperEventHandler'\n        ]);\n        \n        this.state = {\n            frame: null,\n            canSetUsername: true,\n        };\n    }\n    \n    componentDidMount() {\n        window.addEventListener('message', this.wrapperEventHandler);\n        const iframe = document.createElement('iframe');\n        iframe.src = `${origin}/embed/editor?external=${encodeURIComponent(window.origin)}`;\n        iframe.width = 100;\n        iframe.height = 100;\n        iframe.style.display = 'none';\n        document.body.appendChild(iframe);\n        \n        this.setState({\n            frame: iframe\n        });\n    }\n    componentWillUnmount() {\n        window.removeEventListener('message', this.wrapperEventHandler);\n        const iframe = this.state.frame;\n        if (iframe) {\n            iframe.remove();\n        }\n        this.setState({\n            frame: null\n        });\n    }\n    \n    async wrapperEventHandler(e) {\n        const data = e.data;\n        // Don't recursively try to run this event.\n        if (e.origin === window.origin) {\n            return;\n        }\n        if (!data.type) return;\n        if (!data.packet) return;\n\n        switch (data.type) {\n            case 'login': {\n                if (data.packet.loggedIn !== true) return;\n                if (!data.packet.username) return;\n                if (!this.state.canSetUsername) return;\n                this.props.onSetUsername(data.packet.username);\n                this.setState({\n                    canSetUsername: false\n                });\n            }\n        }\n    }\n\n    render () {\n        return (\n            <div></div>\n        );\n    }\n}\n\nHomeCommunication.propTypes = {\n    projectId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n    isPlayground: PropTypes.bool,\n    onSetUsername: PropTypes.func,\n    username: PropTypes.string,\n    usernameInvalid: PropTypes.bool,\n    usernameLoggedIn: PropTypes.bool\n};\n\nconst mapStateToProps = state => ({\n    username: state.scratchGui.tw.username,\n    usernameInvalid: state.scratchGui.tw.usernameInvalid,\n    usernameLoggedIn: state.scratchGui.tw.usernameLoggedIn\n});\n\nconst mapDispatchToProps = dispatch => ({\n    onSetUsername: username => {\n        dispatch(setUsername(username));\n        dispatch(setUsernameLoggedIn(true));\n        dispatch(setUsernameInvalid(false));\n    }\n});\n\nexport default connect(\n    mapStateToProps,\n    mapDispatchToProps\n)(HomeCommunication);\n"],"mappings":"AAAA,OAAOA,OAAO,MAAM,gBAAgB;AACpC,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,SAAQC,OAAO,QAAO,aAAa;AACnC,SAAQC,WAAW,EAAEC,kBAAkB,EAAEC,mBAAmB,QAAO,gBAAgB;AAEnF,IAAIC,MAAM,GAAG,wBAAwB;AACrC;;AAEA,MAAMC,iBAAiB,SAASN,KAAK,CAACO,SAAS,CAAC;EAC5CC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZX,OAAO,CAAC,IAAI,EAAE,CACV,qBAAqB,CACxB,CAAC;IAEF,IAAI,CAACY,KAAK,GAAG;MACTC,KAAK,EAAE,IAAI;MACXC,cAAc,EAAE;IACpB,CAAC;EACL;EAEAC,iBAAiBA,CAAA,EAAG;IAChBC,MAAM,CAACC,gBAAgB,CAAC,SAAS,EAAE,IAAI,CAACC,mBAAmB,CAAC;IAC5D,MAAMC,MAAM,GAAGC,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;IAC/CF,MAAM,CAACG,GAAG,MAAAC,MAAA,CAAMhB,MAAM,6BAAAgB,MAAA,CAA0BC,kBAAkB,CAACR,MAAM,CAACT,MAAM,CAAC,CAAE;IACnFY,MAAM,CAACM,KAAK,GAAG,GAAG;IAClBN,MAAM,CAACO,MAAM,GAAG,GAAG;IACnBP,MAAM,CAACQ,KAAK,CAACC,OAAO,GAAG,MAAM;IAC7BR,QAAQ,CAACS,IAAI,CAACC,WAAW,CAACX,MAAM,CAAC;IAEjC,IAAI,CAACY,QAAQ,CAAC;MACVlB,KAAK,EAAEM;IACX,CAAC,CAAC;EACN;EACAa,oBAAoBA,CAAA,EAAG;IACnBhB,MAAM,CAACiB,mBAAmB,CAAC,SAAS,EAAE,IAAI,CAACf,mBAAmB,CAAC;IAC/D,MAAMC,MAAM,GAAG,IAAI,CAACP,KAAK,CAACC,KAAK;IAC/B,IAAIM,MAAM,EAAE;MACRA,MAAM,CAACe,MAAM,CAAC,CAAC;IACnB;IACA,IAAI,CAACH,QAAQ,CAAC;MACVlB,KAAK,EAAE;IACX,CAAC,CAAC;EACN;EAEA,MAAMK,mBAAmBA,CAACiB,CAAC,EAAE;IACzB,MAAMC,IAAI,GAAGD,CAAC,CAACC,IAAI;IACnB;IACA,IAAID,CAAC,CAAC5B,MAAM,KAAKS,MAAM,CAACT,MAAM,EAAE;MAC5B;IACJ;IACA,IAAI,CAAC6B,IAAI,CAACC,IAAI,EAAE;IAChB,IAAI,CAACD,IAAI,CAACE,MAAM,EAAE;IAElB,QAAQF,IAAI,CAACC,IAAI;MACb,KAAK,OAAO;QA