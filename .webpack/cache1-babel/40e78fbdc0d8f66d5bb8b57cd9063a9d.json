;\n  // search might make more sense, but browsers treat them special in ways that this addon does not handle,\n  // so just leave it as a text input. Also note that Scratch uses type=text for its own search inputs in\n  // the libraries, so this fits right in.\n  searchBox.type = \"text\";\n\n  const search = (query) => {\n    if (!spritesContainer) return;\n\n    query = query.toLowerCase();\n    const containsQuery = (str) => str.toLowerCase().includes(query);\n\n    for (const sprite of spritesContainer.children) {\n      const visible =\n        !query ||\n        containsQuery(sprite.children[0].children[1].innerText) ||\n        (containsQuery(sprite.children[0].children[2].children[0].innerText) &&\n          sprite.children[0].classList.contains(\"sa-folders-folder\"));\n      sprite.style.display = visible ? \"\" : \"none\";\n    }\n  };\n\n  searchBox.addEventListener(\"input\", (e) => {\n    search(e.target.value);\n  });\n\n  const reset = () => {\n    search(\"\");\n    searchBox.value = \"\";\n  };\n\n  const resetButton = document.createElement(\"button\");\n  resetButton.className = \"sa-search-sprites-reset\";\n  resetButton.addEventListener(\"click\", reset);\n  resetButton.textContent = \"×\";\n  addon.self.addEventListener(\"disabled\", reset);\n\n  container.appendChild(searchBox);\n  container.appendChild(resetButton);\n\n  while (true) {\n    await addon.tab.waitForElement(\"div[class^='sprite-selector_items-wrapper']\", {\n      markAsSeen: true,\n      reduxEvents: [\"scratch-gui/mode/SET_PLAYER\", \"fontsLoaded/SET_FONTS_LOADED\", \"scratch-gui/locales/SELECT_LOCALE\"],\n      reduxCondition: (state) => !state.scratchGui.mode.isPlayerOnly,\n    });\n\n    spritesContainer = document.querySelector('[class^=\"sprite-selector_items-wrapper\"]');\n    spriteSelectorContainer = document.querySelector('[class^=\"sprite-selector_scroll-wrapper\"]');\n    spriteSelectorContainer.insertBefore(container, spritesContainer);\n    reset(); // Clear search box after going outside then inside\n  }\n}\n"],"mappings":"AAAA,eAAe,gBAAAA,IAAA,EAAyC;EAAA,IAAzB;IAAEC,KAAK;IAAEC,OAAO;IAAEC;EAAI,CAAC,GAAAH,IAAA;EACpD,IAAII,gBAAgB;EACpB,IAAIC,uBAAuB;EAE3B,MAAMC,SAAS,GAAGC,QAAQ,CAACC,aAAa,CAAC,KAAK,CAAC;EAC/CF,SAAS,CAACG,SAAS,GAAG,6BAA6B;EACnDR,KAAK,CAACS,GAAG,CAACC,wBAAwB,CAACL,SAAS,EAAE;IAC5CM,OAAO,EAAE;EACX,CAAC,CAAC;EAEF,MAAMC,SAAS,GAAGN,QAAQ,CAACC,aAAa,CAAC,OAAO,CAAC;EACjDK,SAAS,CAACJ,SAAS,GAAG,uBAAuB;EAC7CI,SAAS,CAACC,WAAW,GAAGX,GAAG,CAAC,aAAa,CAAC;EAC1CU,SAAS,CAACE,YAAY,GAAG,KAAK;EAC9B;EACA;EACA;EACAF,SAAS,CAACG,IAAI,GAAG,MAAM;EAEvB,MAAMC,MAAM,GAAIC,KAAK,IAAK;IACxB,IAAI,CAACd,gBAAgB,EAAE;IAEvBc,KAAK,GAAGA,KAAK,CAACC,WAAW,CAAC,CAAC;IAC3B,MAAMC,aAAa,GAAIC,GAAG,IAAKA,GAAG,CAACF,WAAW,CAAC,CAAC,CAACG,QAAQ,CAACJ,KAAK,CAAC;IAEhE,KAAK,MAAMK,MAAM,IAAInB,gBAAgB,CAACoB,QAAQ,EAAE;MAC9C,MAAMC,OAAO,GACX,CAACP,KAAK,IACNE,aAAa,CAACG,MAAM,CAACC,QAAQ,CAAC,CAAC,CAAC,CAACA,QAAQ,CAAC,CAAC,CAAC,CAACE,SAAS,CAAC,IACtDN,aAAa,CAACG,MAAM,CAACC,QAAQ,CAAC,CAAC,CAAC,CAACA,QAAQ,CAAC,CAAC,CAAC,CAACA,QAAQ,CAAC,CAAC,CAAC,CAACE,SAAS,CAAC,IAClEH,MAAM,CAACC,QAAQ,CAAC,CAAC,CAAC,CAACG,SAAS,CAACC,QAAQ,CAAC,mBAAmB,CAAE;MAC/DL,MAAM,CAACM,KAAK,CAACjB,OAAO,GAAGa,OAAO,GAAG,EAAE,GAAG,MAAM;IAC9C;EACF,CAAC;EAEDZ,SAAS,CAACiB,gBAAgB,CAAC,OAAO,EAAGC,CAAC,IAAK;IACzCd,MAAM,CAACc,CAAC,CAACC,MAAM,CAACC,KAAK,CAAC;EACxB,CAAC,CAAC;EAEF,MAAMC,KAAK,GAAGA,CAAA,KAAM;IAClBjB,MAAM,CAAC,EAAE,CAAC;IACVJ,SAAS,CAACoB,KAAK,GAAG,EAAE;EACtB,CAAC;EAED,MAAME,WAAW,GAAG5B,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;EACpD2B,WAAW,CAAC1B,SAAS,GAAG,yBAAyB;EACjD0B,WAAW,CAACL,gBAAgB,CAAC,OAAO,EAAEI,KAAK,CAAC;EAC5CC,WAAW,CAACC,WAAW,GAAG,GAAG;EAC7BnC,KAAK,CAACoC,IAAI,CAACP,gBAAgB,CAAC,UAAU,EAAEI,KAAK,CAAC;EAE9C5B,SAAS,CAACgC,WAAW,CAACzB,SAAS,CAAC;EAChCP,SAAS,CAACgC,WAAW,CAACH,WAAW,CAAC;EAElC,OAAO,IAAI,EAAE;IACX,MAAMlC,KAAK,CAACS,GAAG,CAAC6B,cAAc,CAAC,6CAA6C,EAAE;MAC5EC,UAAU,EAAE,IAAI;MAChBC,WAAW,EAAE,CAAC,6BAA6B,EAAE,8BAA8B,EAAE,mCAAmC,CAAC;MACjHC,cAAc,EAAGC,KAAK,IAAK,CAACA,KAAK,CAACC,UAAU,CAACC,IAAI,CAACC;IACpD,