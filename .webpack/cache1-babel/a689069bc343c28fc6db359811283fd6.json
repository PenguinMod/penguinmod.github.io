{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\addons\\addons\\editor-devtools\\DomHelpers.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\addons\\addons\\editor-devtools\\DomHelpers.js","mtime":1777076878141},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["DomHelpers","constructor","addon","vm","tab","traps","events","triggerDragAndDrop","selectorDrag","selectorDrop","mouseXY","shiftKey","fireMouseEvent","type","elem","centerX","centerY","evt","document","createEvent","initMouseEvent","window","dispatchEvent","elemDrag","elemDrop","pos","getBoundingClientRect","center1X","Math","floor","left","right","center1Y","top","bottom","center2X","x","center2Y","y","bindOnce","dom","event","func","capture","removeEventListener","addEventListener","push","eventDetails","unbindAllEvents"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/src/addons/addons/editor-devtools/DomHelpers.js"],"sourcesContent":["export default class DomHelpers {\n  constructor(addon) {\n    this.addon = addon;\n    this.vm = addon.tab.traps.vm;\n    /**\n     * @type {eventDetails[]}\n     */\n    this.events = [];\n  }\n\n  /**\n   * Simulate a drag and drop programmatically through javascript\n   * @param selectorDrag\n   * @param selectorDrop\n   * @param mouseXY\n   * @param [shiftKey=false]\n   * @returns {boolean}\n   */\n  triggerDragAndDrop(selectorDrag, selectorDrop, mouseXY, shiftKey) {\n    // function for triggering mouse events\n    shiftKey = shiftKey || false;\n    let fireMouseEvent = function (type, elem, centerX, centerY) {\n      let evt = document.createEvent(\"MouseEvents\");\n      evt.initMouseEvent(type, true, true, window, 1, 1, 1, centerX, centerY, shiftKey, false, false, false, 0, elem);\n      elem.dispatchEvent(evt);\n    };\n\n    // fetch target elements\n    let elemDrag = selectorDrag; // document.querySelector(selectorDrag);\n    let elemDrop = selectorDrop; // document.querySelector(selectorDrop);\n    if (!elemDrag /* || !elemDrop*/) {\n      return false;\n    }\n\n    // calculate positions\n    let pos = elemDrag.getBoundingClientRect();\n    let center1X = Math.floor((pos.left + pos.right) / 2);\n    let center1Y = Math.floor((pos.top + pos.bottom) / 2);\n\n    // mouse over dragged element and mousedown\n    fireMouseEvent(\"mouseover\", elemDrag, center1X, center1Y);\n    fireMouseEvent(\"mousedown\", elemDrag, center1X, center1Y);\n\n    // start dragging process over to drop target\n    fireMouseEvent(\"dragstart\", elemDrag, center1X, center1Y);\n    fireMouseEvent(\"drag\", elemDrag, center1X, center1Y);\n    fireMouseEvent(\"mousemove\", elemDrag, center1X, center1Y);\n\n    if (!elemDrop) {\n      if (mouseXY) {\n        // console.log(mouseXY);\n        let center2X = mouseXY.x;\n        let center2Y = mouseXY.y;\n        fireMouseEvent(\"drag\", elemDrag, center2X, center2Y);\n        fireMouseEvent(\"mousemove\", elemDrag, center2X, center2Y);\n      }\n      return false;\n    }\n\n    pos = elemDrop.getBoundingClientRect();\n    let center2X = Math.floor((pos.left + pos.right) / 2);\n    let center2Y = Math.floor((pos.top + pos.bottom) / 2);\n\n    fireMouseEvent(\"drag\", elemDrag, center2X, center2Y);\n    fireMouseEvent(\"mousemove\", elemDrop, center2X, center2Y);\n\n    // trigger dragging process on top of drop target\n    fireMouseEvent(\"mouseenter\", elemDrop, center2X, center2Y);\n    fireMouseEvent(\"dragenter\", elemDrop, center2X, center2Y);\n    fireMouseEvent(\"mouseover\", elemDrop, center2X, center2Y);\n    fireMouseEvent(\"dragover\", elemDrop, center2X, center2Y);\n\n    // release dragged element on top of drop target\n    fireMouseEvent(\"drop\", elemDrop, center2X, center2Y);\n    fireMouseEvent(\"dragend\", elemDrag, center2X, center2Y);\n    fireMouseEvent(\"mouseup\", elemDrag, center2X, center2Y);\n\n    return true;\n  }\n\n  bindOnce(dom, event, func, capture) {\n    capture = !!capture;\n    dom.removeEventListener(event, func, capture);\n    dom.addEventListener(event, func, capture);\n    this.events.push(new eventDetails(dom, event, func, capture));\n  }\n\n  unbindAllEvents() {\n    for (const event of this.events) {\n      event.dom.removeEventListener(event.event, event.func, event.capture);\n    }\n    this.events = [];\n  }\n}\n\n/**\n * A record of an event\n */\nclass eventDetails {\n  constructor(dom, event, func, capture) {\n    this.dom = dom;\n    this.event = event;\n    this.func = func;\n    this.capture = capture;\n  }\n}\n"],"mappings":"AAAA,eAAe,MAAMA,UAAU,CAAC;EAC9BC,WAAWA,CAACC,KAAK,EAAE;IACjB,IAAI,CAACA,KAAK,GAAGA,KAAK;IAClB,IAAI,CAACC,EAAE,GAAGD,KAAK,CAACE,GAAG,CAACC,KAAK,CAACF,EAAE;IAC5B;AACJ;AACA;IACI,IAAI,CAACG,MAAM,GAAG,EAAE;EAClB;;EAEA;AACF;AACA;AACA;AACA;AACA;AACA;AACA;EACEC,kBAAkBA,CAACC,YAAY,EAAEC,YAAY,EAAEC,OAAO,EAAEC,QAAQ,EAAE;IAChE;IACAA,QAAQ,GAAGA,QAAQ,IAAI,KAAK;IAC5B,IAAIC,cAAc,GAAG,SAAjBA,cAAcA,CAAaC,IAAI,EAAEC,IAAI,EAAEC,OAAO,EAAEC,OAAO,EAAE;MAC3D,IAAIC,GAAG,GAAGC,QAAQ,CAACC,WAAW,CAAC,aAAa,CAAC;MAC7CF,GAAG,CAACG,cAAc,CAACP,IAAI,EAAE,IAAI,EAAE,IAAI,EAAEQ,MAAM,EAAE,CAAC,EAAE,CAAC,EAAE,CAAC,EAAEN,OAAO,EAAEC,OAAO,EAAEL,QAAQ,EAAE,KAAK,EAAE,KAAK,EAAE,KAAK,EAAE,CAAC,EAAEG,IAAI,CAAC;MAC/GA,IAAI,CAACQ,aAAa,CAACL,GAAG,CAAC;IACzB,CAAC;;IAED;IACA,IAAIM,QAAQ,GAAGf,YAAY,CAAC,CAAC;IAC7B,IAAIgB,QAAQ,GAAGf,YAAY,CAAC,CAAC;IAC7B,IAAI,CAACc,QAAQ,CAAC,mBAAmB;MAC/B,OAAO,KAAK;IACd;;IAEA;IACA,IAAIE,GAAG,GAAGF,QAAQ,CAACG,qBAAqB,CAAC,CAAC;IAC1C,IAAIC,QAAQ,GAAGC,IAAI,CAACC,KAAK,CAAC,CAACJ,GAAG,CAACK,IAAI,G