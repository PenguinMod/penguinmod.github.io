y vm.addSprite\n */\nconst emptySprite = (name, soundName, costumeName) => ({\n    objName: name,\n    sounds: [],\n    costumes: [\n        {\n            costumeName: costumeName,\n            baseLayerID: -1,\n            baseLayerMD5: 'cd21514d0531fdffb22204e0ec5ed84a.svg',\n            bitmapResolution: 1,\n            rotationCenterX: 0,\n            rotationCenterY: 0\n        }\n    ],\n    currentCostumeIndex: 0,\n    scratchX: 36,\n    scratchY: 28,\n    scale: 1,\n    direction: 90,\n    rotationStyle: 'normal',\n    isDraggable: false,\n    visible: true,\n    spriteInfo: {}\n});\n\nexport {\n    emptyCostume,\n    emptySprite\n};\n"],"mappings":"AAAA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA,MAAMA,YAAY,GAAGC,IAAI,KAAK;EAC1BA,IAAI,EAAEA,IAAI;EACVC,GAAG,EAAE,sCAAsC;EAC3CC,eAAe,EAAE,CAAC;EAClBC,eAAe,EAAE,CAAC;EAClBC,gBAAgB,EAAE,CAAC;EACnBC,MAAM,EAAE;AACZ,CAAC,CAAC;;AAEF;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAMC,WAAW,GAAGA,CAACN,IAAI,EAAEO,SAAS,EAAEC,WAAW,MAAM;EACnDC,OAAO,EAAET,IAAI;EACbU,MAAM,EAAE,EAAE;EACVC,QAAQ,EAAE,CACN;IACIH,WAAW,EAAEA,WAAW;IACxBI,WAAW,EAAE,CAAC,CAAC;IACfC,YAAY,EAAE,sCAAsC;IACpDT,gBAAgB,EAAE,CAAC;IACnBF,eAAe,EAAE,CAAC;IAClBC,eAAe,EAAE;EACrB,CAAC,CACJ;EACDW,mBAAmB,EAAE,CAAC;EACtBC,QAAQ,EAAE,EAAE;EACZC,QAAQ,EAAE,EAAE;EACZC,KAAK,EAAE,CAAC;EACRC,SAAS,EAAE,EAAE;EACbC,aAAa,EAAE,QAAQ;EACvBC,WAAW,EAAE,KAAK;EAClBC,OAAO,EAAE,IAAI;EACbC,UAAU,EAAE,CAAC;AACjB,CAAC,CAAC;AAEF,SACIvB,YAAY,EACZO,WAAW","ignoreList":[]}]}