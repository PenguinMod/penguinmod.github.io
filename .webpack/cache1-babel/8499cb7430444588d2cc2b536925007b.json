\n        return new jwArray.Type(Object.values(vm._projectZip.files).filter(v => v.name.startsWith(\"extraAssets/\") && v.dir && v.name !== \"extraAssets/\").map(v => v.name.substring(12)))\n    }\n\n    getFilesInFolder({NAME}) {\n        if (!vm._projectZip.files[\"extraAssets/\"]) return new jwArray.Type()\n\n        NAME = Cast.toString(NAME)\n        if (!NAME.endsWith(\"/\")) NAME += \"/\"\n        \n        let rootFolder = NAME == \"/\" ? `extraAssets/` : `extraAssets/${NAME}`\n        let depth = rootFolder.split(\"/\").length\n        return new jwArray.Type(Object.values(vm._projectZip.files).filter(v => v.name.startsWith(rootFolder) && v.name.split(\"/\").length == depth && !v.dir).map(v => v.name.substring(12)))\n    }\n\n    getSubdirs({NAME}) {\n        if (!vm._projectZip.files[\"extraAssets/\"]) return new jwArray.Type()\n\n        NAME = Cast.toString(NAME)\n        if (!NAME.endsWith(\"/\")) NAME += \"/\"\n        \n        let rootFolder = NAME == \"/\" ? `extraAssets/` : `extraAssets/${NAME}`\n        let depth = rootFolder.split(\"/\").length\n        return new jwArray.Type(Object.values(vm._projectZip.files).filter(v => v.name.startsWith(rootFolder) && v.name.split(\"/\").length == depth+1 && v.dir).map(v => v.name.substring(12)))\n    }\n}\n\nmodule.exports = Extension"],"mappings":";;;;;AAAA,MAAMA,SAAS,GAAGC,OAAO,CAAC,oCAAoC,CAAC;AAC/D,MAAMC,UAAU,GAAGD,OAAO,CAAC,qCAAqC,CAAC;AACjE,MAAME,YAAY,GAAGF,OAAO,CAAC,uCAAuC,CAAC;AACrE,MAAMG,UAAU,GAAGH,OAAO,CAAC,qCAAqC,CAAC;AACjE,MAAMI,IAAI,GAAGJ,OAAO,CAAC,iBAAiB,CAAC;AAEvC,IAAIK,OAAO,GAAG;EACVC,IAAI,EAAE,MAAM,EAAE;EACdC,KAAK,EAAE,CAAC,CAAC;EACTC,QAAQ,EAAE,CAAC;AACf,CAAC;AAED,MAAMC,SAAS,CAAC;EACZC,WAAWA,CAAA,EAAG;IACV,IAAI,CAACC,EAAE,CAACN,OAAO,EAAEM,EAAE,CAACC,gBAAgB,CAACC,mBAAmB,CAAC,SAAS,CAAC;IACnER,OAAO,GAAGM,EAAE,CAACN,OAAO;EACxB;EAEAS,OAAOA,CAAA,EAAG;IACN,OAAO;MACHC,EAAE,EAAE,WAAW;MACfC,IAAI,EAAE,QAAQ;MACdC,MAAM,EAAE,SAAS;MACjBC,WAAW,EAAE,o8BAAo8B;MACj9BC,MAAM,EAAE,CACJ;QACIC,MAAM,EAAE,SAAS;QACj