ny other way.\n *   // Other things I tried:\n *   // Just injecting the font-family into the document: no effect.\n *   // External stylesheet linked to by SVG: no effect.\n *   // Using a <link> or <style>@import</style> to link to font-family\n *   // injected into the document: no effect.\n * @param {string} svgString The string representation of the svg to modify\n * @param {object} [customFontFaces] Object mapping custom font families to @font-face statements.\n * @return {string} The svg with any needed fonts inlined\n */\nconst inlineSvgFonts = function (svgString, customFontFaces = {}) {\n    // Make it clear that this function only operates on strings.\n    // If we don't explicitly throw this here, the function silently fails.\n    if (typeof svgString !== 'string') {\n        throw new Error('SVG to be inlined is not a string');\n    }\n\n    const FONTS = {};\n    if (customFontFaces && typeof customFontFaces === 'object') {\n        // The fonts in the document will be XML escaped\n        for (const [families, style] of Object.entries(customFontFaces)) {\n            FONTS[xmlEscape(families)] = style;\n        }\n    }\n    try {\n        // We already know these don't need to be XML escaped\n        Object.assign(FONTS, getFonts());\n    } catch (e) {\n        // getFonts fails in tests because it uses some webpack tricks. This is safe to ignore.\n    }\n\n    // Collect fonts that need injection.\n    const fontsNeeded = new Set();\n    const fontRegex = /font-family=\"([^\"]*)\"/g;\n    let matches = fontRegex.exec(svgString);\n    while (matches) {\n        fontsNeeded.add(matches[1]);\n        matches = fontRegex.exec(svgString);\n    }\n    if (fontsNeeded.size > 0) {\n        let str = '<defs><style>';\n        for (const font of fontsNeeded) {\n            if (Object.prototype.hasOwnProperty.call(FONTS, font)) {\n                str += `${FONTS[font]}`;\n            }\n        }\n        str += '</style></defs>';\n        svgString = svgString.replace(/<svg[^>]*>/, `$&${str}`);\n        return svgString;\n    }\n    return svgString;\n};\n\nmodule.exports = inlineSvgFonts;\n"],"mappings":"AAAA;AACA;AACA;AACA,MAAMA,QAAQ,GAAGC,OAAO,CAAC,sBAAsB,CAAC;AAEhD,MAAMC,SAAS,GAAGC,GAAG,IAAIA,GAAG,CAACC,OAAO,CAAC,UAAU,EAAEC,CAAC,IAAI;EAClD,QAAQA,CAAC;IACT,KAAK,GAAG;MAAE,OAAO,MAAM;IACvB,KAAK,GAAG;MAAE,OAAO,MAAM;IACvB,KAAK,GAAG;MAAE,OAAO,OAAO;IACxB,KAAK,IAAI;MAAE,OAAO,QAAQ;IAC1B,KAAK,GAAG;MAAE,OAAO,QAAQ;EACzB;AACJ,CAAC,CAAC;;AAEF;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAMC,cAAc,GAAG,SAAjBA,cAAcA,CAAaC,SAAS,EAAwB;EAAA,IAAtBC,eAAe,GAAAC,SAAA,CAAAC,MAAA,QAAAD,SAAA,QAAAE,SAAA,GAAAF,SAAA,MAAG,CAAC,CAAC;EAC5D;EACA;EACA,IAAI,OAAOF,SAAS,KAAK,QAAQ,EAAE;IAC/B,MAAM,IAAIK,KAAK,CAAC,mCAAmC,CAAC;EACxD;EAEA,MAAMC,KAAK,GAAG,CAAC,CAAC;EAChB,IAAIL,eAAe,IAAI,OAAOA,eAAe,KAAK,QAAQ,EAAE;IACxD;IACA,KAAK,MAAM,CAACM,QAAQ,EAAEC,KAAK,CAAC,IAAIC,MAAM,CAACC,OAAO,CAACT,eAAe,CAAC,EAAE;MAC7DK,KAAK,CAACX,SAAS,CAACY,QAAQ,CAAC,CAAC,GAAGC,KAAK;IACtC;EACJ;EACA,IAAI;IACA;IACAC,MAAM,CAACE,MAAM,CAACL,KAAK,EAAEb,QAAQ,CAAC,CAAC,CAAC;EACpC,CAAC,CAAC,OAAOmB,CAAC,EAAE;IACR;EAAA;;EAGJ;EACA,MAAMC,WAAW,GAAG,IAAIC,GAAG,CAAC,CAAC;EAC7B,MAAMC,SAAS,GAAG,wBAAwB;EAC1C,IAAIC,OAAO,GAAGD,SAAS,CAACE,IAAI,CAACjB,SAAS,CAAC;EACvC,OAAOgB,OAAO,EAAE;IACZH,WAAW,CAACK,GAAG,CAACF,OAAO,CAAC,CAAC,CAAC,CAAC;IAC3BA,OAAO,GAAGD,SAAS,CAACE,IAAI,CAACjB,SAAS,CAAC;EACvC;EACA,IAAIa,WAAW,CAACM,IAAI,GAAG,CAAC,EAAE;IACtB,IAAIvB,GAAG,GAAG,eAAe;IACzB,KAAK,MAAMwB,IAAI,IAAIP,WAAW,EAAE;MAC5B,IAAIJ,MAAM,CAACY,SAAS,CAACC,cAAc,CAACC,IAAI,CAACjB,KAAK,EAAEc,IAAI,CAAC,EAAE;QACnDxB,GAAG,OAAA4B,MAAA,CAAOlB,KAAK,CAACc,IAAI,CAAC,CAAE;MAC3B;IACJ;IACAxB,GAAG,IAAI,iBAAiB;IACxBI,SAAS,GAAGA,SAAS,CAACH,OAAO,CAAC,YAAY,OAAA2B,MAAA,CAAO5B,GAAG,CAAE,CAAC;IACvD,OAAOI,SAAS;EACpB;EACA,OAAOA,SAAS;AACpB,CAAC;AAEDyB,MAAM,CAACC,OAAO,GAAG3B,cAAc","ignoreList":[]}]}