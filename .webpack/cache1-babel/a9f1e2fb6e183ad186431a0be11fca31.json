handleSwitchToBitmap: () => {\n        dispatch(changeFormat(Formats.BITMAP));\n    },\n    handleSwitchToVector: () => {\n        dispatch(changeFormat(Formats.VECTOR));\n    },\n    removeTextEditTarget: () => {\n        dispatch(setTextEditTarget());\n    },\n    setLayout: layout => {\n        dispatch(setLayout(layout));\n    },\n    setSelectedItems: format => {\n        dispatch(setSelectedItems(getSelectedLeafItems(), isBitmap(format)));\n    },\n    onDeactivateEyeDropper: () => {\n        // set redux values to default for eye dropper reducer\n        dispatch(deactivateEyeDropper());\n    }\n});\n\nexport default connect(\n    mapStateToProps,\n    mapDispatchToProps\n)(FixedTools);\n"],"mappings":"AAAA,OAAOA,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,SAAQC,OAAO,QAAO,aAAa;AAEnC,OAAOC,mBAAmB,MAAM,2CAA2C;AAE3E,SAAQC,UAAU,IAAVA,WAAU,QAAO,mBAAmB;AAC5C,SAAQC,YAAY,QAAO,oBAAoB;AAC/C,SAAQC,kBAAkB,IAAlBA,mBAAkB,EAAEC,gBAAgB,IAAhBA,iBAAgB,QAAO,4BAA4B;AAC/E,SAAQC,oBAAoB,QAAO,yBAAyB;AAC5D,SAAQC,iBAAiB,QAAO,8BAA8B;AAC9D,SAAQC,SAAS,IAATA,UAAS,QAAO,oBAAoB;AAE5C,SAAQC,oBAAoB,QAAO,qBAAqB;AACxD,SAAQC,YAAY,EAAEC,YAAY,EAAEC,UAAU,EAAEC,YAAY,QAAO,iBAAiB;AACpF,SAAQC,cAAc,EAAEC,gBAAgB,QAAO,iBAAiB;AAEhE,OAAOC,OAAO,IAAGC,QAAQ,QAAO,eAAe;AAC/C,OAAOC,OAAO,MAAM,gBAAgB;AAEpC,MAAMC,UAAU,SAASpB,KAAK,CAACqB,SAAS,CAAC;EACrCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZJ,OAAO,CAAC,IAAI,EAAE,CACV,oBAAoB,EACpB,mBAAmB,EACnB,kBAAkB,EAClB,mBAAmB,EACnB,wBAAwB,EACxB,aAAa,EACb,eAAe,CAClB,CAAC;EACN;EACAK,WAAWA,CAAA,EAAI;IACXT,cAAc,CAAC,IAAI,CAACQ,KAAK,CAAClB,kBAAkB,EAAE,IAAI,CAACoB,sBAAsB,EAAE,IAAI,CAACF,KAAK,CAACG,aAAa,CAAC;EACxG;EACAC,aAAaA,CAAA,EAAI;IACbX,gBAAgB,CAAC,IAAI,CAACO,KAAK,CAAClB,kBAAkB,EAAE,IAAI,CAACoB,sBAAsB,EAAE,IAAI,CAACF,KAAK,CAACG,aAAa,CAAC;EAC1G;EACAE,kBAAkBA,CAAA,EAAI;IAClBhB,YAAY,CAAC,IAAI,CAACW,KAAK,CAACG,aAAa,CAAC;EAC1C;EACAG,iBAAiBA,CAAA,EAAI;IACjBf,YAAY,CAAC,IAAI,CAACS,KAAK,CAACG,aAAa,CAAC;EAC1C;EACAI,gBAAgBA,CAAA,EAAI;IAChBjB,UAAU,CAAC,IAAI,CAACU,KAAK,CAACG,a