           'handleRefresh'\n        ]);\n        this.state = {\n            phase: PHASES.prescan\n        };\n    }\n    componentWillUnmount () {\n        // @todo: stop the peripheral scan here\n        this.unbindPeripheralUpdates();\n    }\n    handlePeripheralScanTimeout () {\n        this.setState({\n            phase: PHASES.notfound\n        });\n        this.unbindPeripheralUpdates();\n    }\n    handlePeripheralListUpdate (newList) {\n        // TODO: sort peripherals by signal strength? so they don't jump around\n        const peripheralArray = Object.keys(newList).map(id =>\n            newList[id]\n        );\n        if (peripheralArray.length > 0) {\n            this.props.onConnecting(peripheralArray[0].peripheralId);\n        }\n    }\n    bindPeripheralUpdates () {\n        this.props.vm.on(\n            'PERIPHERAL_LIST_UPDATE', this.handlePeripheralListUpdate);\n        this.props.vm.on(\n            'PERIPHERAL_SCAN_TIMEOUT', this.handlePeripheralScanTimeout);\n    }\n    unbindPeripheralUpdates () {\n        this.props.vm.removeListener(\n            'PERIPHERAL_LIST_UPDATE', this.handlePeripheralListUpdate);\n        this.props.vm.removeListener(\n            'PERIPHERAL_SCAN_TIMEOUT', this.handlePeripheralScanTimeout);\n    }\n    handleRefresh () {\n        // @todo: stop the peripheral scan here, it is more important for auto scan\n        // due to timeout and cancellation\n        this.setState({\n            phase: PHASES.prescan\n        });\n        this.unbindPeripheralUpdates();\n    }\n    handleStartScan () {\n        this.bindPeripheralUpdates();\n        this.props.vm.scanForPeripheral(this.props.extensionId);\n        this.setState({\n            phase: PHASES.pressbutton\n        });\n\n    }\n    render () {\n        return (\n            <ScanningStepComponent\n                connectionTipIconURL={this.props.connectionTipIconURL}\n                phase={this.state.phase}\n                title={this.props.extensionId}\n                onRefresh={this.handleRefresh}\n                onStartScan={this.handleStartScan}\n            />\n        );\n    }\n}\n\nAutoScanningStep.propTypes = {\n    connectionTipIconURL: PropTypes.string,\n    extensionId: PropTypes.string.isRequired,\n    onConnecting: PropTypes.func.isRequired,\n    vm: PropTypes.instanceOf(VM).isRequired\n};\n\nexport default AutoScanningStep;\n"],"mappings":"AAAA,OAAOA,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,OAAOC,OAAO,MAAM,gBAAgB;AACpC,OAAOC,qBAAqB,IAAGC,MAAM,QAAO,uDAAuD;AACnG,OAAOC,EAAE,MAAM,YAAY;AAE3B,MAAMC,gBAAgB,SAASL,KAAK,CAACM,SAAS,CAAC;EAC3CC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZP,OAAO,CAAC,IAAI,EAAE,CACV,4BAA4B,EAC5B,6BAA6B,EAC7B,iBAAiB,EACjB,eAAe,CAClB,CAAC;IACF,IAAI,CAACQ,KAAK,GAAG;MACTC,KAAK,EAAEP,MAAM,CAACQ;IAClB,CAAC;EACL;EACAC,oBAAoBA,CAAA,EAAI;IACpB;IACA,IAAI,CAACC,uBAAuB,CAAC,CAAC;EAClC;EACAC,2BAA2BA,CAAA,EAAI;IAC3B,IAAI,CAACC,QAAQ,CAAC;MACVL,KAAK,EAAEP,MAAM,CAACa;IAClB,CAAC,CAAC;IACF,IAAI,CAACH,uBAAuB,CAAC,CAAC;EAClC;EACAI,0BAA0BA,CAAEC,OAAO,EAAE;IACjC;IACA,MAAMC,eAAe,GAAGC,MAAM,CAACC,IAAI,CAACH,OAAO,CAAC,CAACI,GAAG,CAACC,EAAE,IAC/CL,OAAO,CAACK,EAAE,CACd,CAAC;IACD,IAAIJ,eAAe,CAACK,MAAM,GAAG,CAAC,EAAE;MAC5B,IAAI,CAAChB,KAAK,CAACiB,YAAY,CAACN,eAAe,CAAC,CAAC,CAAC,CAACO,YAAY,CAAC;IAC5D;EACJ;EACAC,qBAAqBA,CAAA,EAAI;IACrB,IAAI,CAACnB,KAAK,CAACoB,EAAE,CAACC,EAAE,CACZ,wBAAwB,EAAE,IAAI,CAACZ,0BAA0B,CAAC;IAC9D,IAAI,CAACT,KAAK,CAACoB,EAAE,CAACC,EAAE,CACZ,yBAAyB,EAAE,IAAI,CAACf,2BAA2B,CAAC;EACpE;EACAD,uBAAuBA,CAAA,EAAI;IACvB,IAAI,CAACL,KAAK,CAACoB,EAAE,CAACE,cAAc,CACxB,wBAAwB,EAAE,IAAI,CAACb,0BAA0B,CAAC;IAC9D,IAAI,CAACT,KAAK,CAACoB,EAAE,CAACE,cAAc,CACxB,yBAAyB,EAAE,IAAI,CAAChB,2BAA2B,CAAC;EACpE;EACAiB,aAAaA,CAAA,EAAI;IACb;IACA;IACA,IAAI,CAAChB,QAAQ,CAAC;MACVL,KAAK,EAAEP,MAAM,CAACQ;IAClB,CAAC,CAAC;IACF,IAAI,CAACE,uBAAuB,CAAC,CAAC;EAClC;EACAmB,eAAeA,CAAA,EAAI;IACf,IAAI,CAACL,qBAAqB,CAAC,CAAC;IAC5B,IAAI,CAACnB,KAAK,CAACoB,EAAE,CAACK,iBAAiB,CAAC,IAAI,CAACzB,KAAK,CAAC0B,WAAW,CAAC;IACvD,IAAI,CAACn