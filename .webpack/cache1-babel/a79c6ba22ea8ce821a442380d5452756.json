n        // Don't change state if no selection\n        if (!action.selectedItems || !action.selectedItems.length) {\n            return state;\n        }\n        // Vector mode doesn't have bit width\n        if (!action.bitmapMode) {\n            return state;\n        }\n        const colorState = getColorsFromSelection(action.selectedItems, action.bitmapMode);\n        if (colorState.thickness) return colorState.thickness;\n        return state;\n    }\n    default:\n        return state;\n    }\n};\n\n// Action creators ==================================\nconst changeBitBrushSize = function (brushSize) {\n    return {\n        type: CHANGE_BIT_BRUSH_SIZE,\n        brushSize: brushSize\n    };\n};\n\nexport {\n    reducer as default,\n    changeBitBrushSize\n};\n"],"mappings":"AAAA,OAAOA,GAAG,MAAM,YAAY;AAC5B,SAAQC,qBAAqB,QAAO,kBAAkB;AACtD,SAAQC,sBAAsB,QAAO,sBAAsB;;AAE3D;AACA;AACA,MAAMC,qBAAqB,GAAG,gDAAgD;AAC9E,MAAMC,YAAY,GAAG,EAAE;AAEvB,MAAMC,OAAO,GAAG,SAAVA,OAAOA,CAAaC,KAAK,EAAEC,MAAM,EAAE;EACrC,IAAI,OAAOD,KAAK,KAAK,WAAW,EAAEA,KAAK,GAAGF,YAAY;EACtD,QAAQG,MAAM,CAACC,IAAI;IACnB,KAAKL,qBAAqB;MACtB,IAAIM,KAAK,CAACF,MAAM,CAACG,SAAS,CAAC,EAAE;QACzBV,GAAG,CAACW,IAAI,wBAAAC,MAAA,CAAwBL,MAAM,CAACG,SAAS,CAAE,CAAC;QACnD,OAAOJ,KAAK;MAChB;MACA,OAAOO,IAAI,CAACC,GAAG,CAAC,CAAC,EAAEP,MAAM,CAACG,SAAS,CAAC;IACxC,KAAKT,qBAAqB;MAC1B;QACI;QACA,IAAI,CAACM,MAAM,CAACQ,aAAa,IAAI,CAACR,MAAM,CAACQ,aAAa,CAACC,MAAM,EAAE;UACvD,OAAOV,KAAK;QAChB;QACA;QACA,IAAI,CAACC,MAAM,CAACU,UAAU,EAAE;UACpB,OAAOX,KAAK;QAChB;QACA,MAAMY,UAAU,GAAGhB,sBAAsB,CAACK,MAAM,CAACQ,aAAa,EAAER,MAAM,CAACU,UAAU,CAAC;QAClF,IAAIC,UAAU,CAACC,SAAS,EAAE,OAAOD,UAAU,CAACC,SAAS;QACrD,OAAOb,KAAK;MAChB;IACA;MACI,OAAOA,KAAK;EAChB;AACJ,CAAC;;AAED;AACA,MAAMc,kBAAkB,GAAG,SAArBA,kBAAkBA,CAAaV,SAAS,EAAE;EAC5C,OAAO;IACHF,IAAI,EAAEL,qBAAqB;IAC3BO,SAAS,EAAEA;EACf,CAAC;AACL,CAAC;AAED,SACIL,OAAO,IAAIgB,OAAO,EAClBD,kBAAkB","ignoreList":[]}]}