.length > 0) return false;\n    return true;\n};\n\nexport {\n    requestVideoStream,\n    requestDisableVideo\n};\n"],"mappings":"AAAA,OAAOA,YAAY,MAAM,wBAAwB;;AAEjD;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAMC,YAAY,GAAG,EAAE;AACvB,MAAMC,kBAAkB,GAAGC,SAAS,IAAI;EACpC,IAAIC,aAAa;EACjB,IAAIH,YAAY,CAACI,MAAM,KAAK,CAAC,EAAE;IAC3BD,aAAa,GAAGJ,YAAY,CAAC;MACzBM,KAAK,EAAE,KAAK;MACZC,KAAK,EAAEJ;IACX,CAAC,CAAC;IACFF,YAAY,CAACO,IAAI,CAACJ,aAAa,CAAC;EACpC,CAAC,MAAM,IAAIH,YAAY,CAACI,MAAM,GAAG,CAAC,EAAE;IAChCD,aAAa,GAAGH,YAAY,CAAC,CAAC,CAAC;IAC/BA,YAAY,CAACO,IAAI,CAAC,IAAI,CAAC;EAC3B;EACA,OAAOJ,aAAa;AACxB,CAAC;AAED,MAAMK,mBAAmB,GAAGA,CAAA,KAAM;EAC9BR,YAAY,CAACS,GAAG,CAAC,CAAC;EAClB,IAAIT,YAAY,CAACI,MAAM,GAAG,CAAC,EAAE,OAAO,KAAK;EACzC,OAAO,IAAI;AACf,CAAC;AAED,SACIH,kBAAkB,EAClBO,mBAAmB","ignoreList":[]}]}