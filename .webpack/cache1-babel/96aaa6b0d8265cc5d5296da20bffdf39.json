nts-modal.css';\nimport FontDropdownItem from './font-dropdown-item.jsx';\n\nclass FontName extends React.Component {\n    constructor (props) {\n        super(props);\n        bindAll(this, [\n            'setInputRef',\n            'handleChange',\n            'handleFocus',\n            'handleBlur',\n            'handleResize',\n            'handleSelectFont',\n            'handleKeyDown'\n        ]);\n        this.state = {\n            focused: false,\n            rect: null\n        };\n    }\n\n    componentDidMount () {\n        window.addEventListener('resize', this.handleResize);\n    }\n\n    componentWillUnmount () {\n        window.removeEventListener('resize', this.handleResize);\n    }\n\n    setInputRef (input) {\n        this.input = input;\n\n        // can't use autoFocus because handleFocus relies on the ref existing already\n        if (input) {\n            input.focus();\n        }\n    }\n\n    handleChange (e) {\n        this.props.onChange(e.target.value);\n    }\n\n    handleFocus () {\n        this.setState({\n            focused: true,\n            rect: this.input.getBoundingClientRect()\n        });\n    }\n\n    handleBlur () {\n        this.props.onChange(this.props.fontManager.getSafeName(this.props.name));\n        this.setState({\n            focused: false\n        });\n    }\n\n    handleResize () {\n        if (this.state.focused) {\n            this.setState({\n                rect: this.input.getBoundingClientRect()\n            });\n        }\n    }\n\n    handleSelectFont (font) {\n        this.props.onChange(font);\n    }\n\n    handleKeyDown (e) {\n        if (e.key === 'Enter') {\n            this.handleBlur();\n            e.target.blur();\n        }\n    }\n\n    getFilteredOptions () {\n        if (!this.state.focused || !this.props.options) {\n            return [];\n        }\n        const name = this.props.name.toLowerCase();\n        const candidates = this.props.options\n            .filter(family => family.toLowerCase().includes(name));\n        if (candidates.length === 0 && candidates[0] === this.props.name) {\n            return [];\n        }\n        return candidates;\n    }\n\n    render () {\n        const {\n            /* eslint-disable no-unused-vars */\n            name,\n            onChange,\n            fontManager,\n            options,\n            /* eslint-enable no-unused-vars */\n            ...props\n        } = this.props;\n\n        const filteredOptions = this.getFilteredOptions();\n        return (\n            <div className={styles.fontInputOuter}>\n                <input\n                    {...props}\n                    type=\"text\"\n                    className={styles.fontInput}\n                    value={this.props.name}\n                    ref={this.setInputRef}\n                    onChange={this.handleChange}\n                    onFocus={this.handleFocus}\n                    onBlur={this.handleBlur}\n                    onKeyDown={this.handleKeyDown}\n                />\n\n                {/* We need to use a portal to get out of the modal's overflow: hidden, unfortunately */}\n                {filteredOptions.length > 0 && ReactDOM.createPortal(\n                    <div\n                        className={styles.fontDropdownOuter}\n                        style={{\n                            left: `${this.state.rect.left - 4}px`,\n                            top: `${this.state.rect.top + this.state.rect.height + 4}px`,\n                            width: `${this.state.rect.width + 8}px`\n                        }}\n                    >\n                        {this.getFilteredOptions().map(family => (\n                            <FontDropdownItem\n                                key={family}\n                                family={family}\n                                onSelect={this.handleSelectFont}\n                            />\n                        ))}\n                    </div>,\n                    document.body\n                )}\n            </div>\n        );\n    }\n}\n\nFontName.propTypes = {\n    name: PropTypes.string.isRequired,\n    onChange: PropTypes.func.isRequired,\n    fontManager: PropTypes.shape({\n        getSafeName: PropTypes.func.isRequired\n    }).isRequired,\n    options: PropTypes.arrayOf(PropTypes.string.isRequired)\n};\n\nexport default FontName;\n"],"mappings":";;;;AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,QAAQ,MAAM,WAAW;AAChC,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,OAAO,MAAM,gBAAgB;AACpC,OAAOC,MAAM,MAAM,mBAAmB;AACtC,OAAOC,gBAAgB,MAAM,0BAA0B;AAEvD,MAAMC,QAAQ,SAASN,KAAK,CAACO,SAAS,CAAC;EACnCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZN,OAAO,CAAC,IAAI,EAAE,CACV,aAAa,EACb,cAAc,EACd,aAAa,EACb,YAAY,EACZ,cAAc,EACd,kBAAkB,EAClB,eAAe,CAClB,CAAC;IACF,IAAI,CAACO,KAAK,GAAG;MACTC,OAAO,EAAE,KAAK;MACdC,IAAI,EAAE;IACV,CAAC;EACL;EAEAC,iBAAiBA,CAAA,EAAI;IACjBC,MAAM,CAACC,gBAAgB,CAAC,QAAQ,EAAE,IAAI,CAACC,YAAY,CAAC;EACxD;EAEAC,oBAAoBA,CAAA,EAAI;IACpBH,MAAM,CAACI,mBAAmB,CAAC,QAAQ,EAAE,IAAI,CAACF,YAAY,CAAC;EAC3D;EAEAG,WAAWA,CAAEC,KAAK,EAAE;IAChB,IAAI,CAACA,KAAK,GAAGA,KAAK;;IAElB;IACA,IAAIA,KAAK,EAAE;MACPA,KAAK,CAACC,KAAK,CAAC,CAAC;IACjB;EACJ;EAEAC,YAAYA,CAAEC,CAAC,EAAE;IACb,IAAI,CAACd,KAAK,CAACe,QAAQ,CAACD,CAAC,CAACE,MAAM,CAACC,KAAK,CAAC;EACvC;EAEAC,WAAWA,CAAA,EAAI;IACX,IAAI,CAACC,QAAQ,CAAC;MACVjB,OAAO,EAAE,IAAI;MACbC,IAAI,EAAE,IAAI,CAACQ,KAAK,CAACS,qBAAqB,CAAC;IAC3C,CAAC,CAAC;EACN;EAEAC,UAAUA,CAAA,EAAI;IACV,IAAI,CAACrB,KAAK,CAACe,QAAQ,CAAC,IAAI,CAACf,KAAK,CAACsB,WAAW,CAACC,WAAW,CAAC,IAAI,CAACvB,KAAK,CAACwB,IAAI,CAAC,CAAC;IACxE,IAAI,CAACL,QAAQ,CAAC;MACVjB,OAAO,EAAE;IACb,CAAC,CAAC;EACN;EAEAK,YAAYA,CAAA,EAAI;IACZ,IAAI,IAAI,CAACN,KAAK,CAACC,OAAO,EAAE;MACpB,IAAI,CAACiB,QAAQ,CAAC;QACVhB,IAAI,EAAE,IAAI,CAACQ,KAAK,CAACS,qBAAqB,CAAC;MAC3C,CAAC,CAAC;IACN;EACJ;EAEAK,gBAAgBA,CAAEC,IAAI,EAAE;IACpB,IAAI,CAAC1B,KAAK,CAACe,QAAQ,CAACW,IAAI,CAAC;EAC7B;EAEAC,aAAaA,CAAEb,CAAC,EAAE;IACd,IAAIA,CAAC,CAACc,GAAG,KAAK,OAAO,EAAE;MACnB,IAAI,CAACP,UAAU,CAAC,CAAC;MACjBP,CAAC,CAACE,MAAM,CAAC