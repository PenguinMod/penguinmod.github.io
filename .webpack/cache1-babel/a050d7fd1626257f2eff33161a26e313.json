    };\n    const hitResults = paper.project.hitTestAll(event.point, hitOptions);\n    if (hitResults.length === 0) {\n        return null;\n    }\n\n    // Get highest z-index result\n    let hitResult;\n    for (const result of hitResults) {\n        if (!hitResult || sortItemsByZIndex(hitResult.item, result.item) < 0) {\n            hitResult = result;\n        }\n    }\n    const item = hitResult.item;\n    // If the hovered item is already selected, then there should be no hovered item.\n    if (!item || item.selected) {\n        return null;\n    }\n\n    let hoverGuide;\n    if (isBoundsItem(item)) {\n        hoverGuide = hoverBounds(item);\n    } else if (!subselect && isGroupChild(item)) {\n        hoverGuide = hoverBounds(getRootItem(item));\n    } else {\n        hoverGuide = hoverItem(item);\n    }\n    hoverGuide.data.hitResult = hitResult;\n\n    return hoverGuide;\n};\n\nexport {\n    getHoveredItem\n};\n"],"mappings":"AAAA,OAAOA,KAAK,MAAM,kBAAkB;AACpC,SAAQC,YAAY,EAAEC,WAAW,QAAO,QAAQ;AAChD,SAAQC,WAAW,EAAEC,SAAS,QAAO,UAAU;AAC/C,SAAQC,YAAY,QAAO,SAAS;AACpC,SAAQC,iBAAiB,QAAO,QAAQ;;AAExC;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAMC,cAAc,GAAG,SAAjBA,cAAcA,CAAaC,KAAK,EAAEC,UAAU,EAAEC,SAAS,EAAE;EAC3D,MAAMC,QAAQ,GAAGF,UAAU,CAACG,KAAK;EACjCH,UAAU,CAACG,KAAK,GAAGC,SAAS,IAAI;IAC5B,IAAIA,SAAS,CAACC,IAAI,CAACC,IAAI,IAAIF,SAAS,CAACC,IAAI,CAACC,IAAI,CAACC,OAAO,EAAE,OAAO,KAAK;IACpE,OAAOL,QAAQ,GAAGA,QAAQ,CAACE,SAAS,CAAC,GAAG,IAAI;EAChD,CAAC;EACD,MAAMI,UAAU,GAAGjB,KAAK,CAACkB,OAAO,CAACC,UAAU,CAACX,KAAK,CAACY,KAAK,EAAEX,UAAU,CAAC;EACpE,IAAIQ,UAAU,CAACI,MAAM,KAAK,CAAC,EAAE;IACzB,OAAO,IAAI;EACf;;EAEA;EACA,IAAIR,SAAS;EACb,KAAK,MAAMS,MAAM,IAAIL,UAAU,EAAE;IAC7B,IAAI,CAACJ,SAAS,IAAIP,iBAAiB,CAACO,SAAS,CAACC,IAAI,EAAEQ,MAAM,CAACR,IAAI,CAAC,GAAG,CAAC,EAAE;MAClED,SAAS,GAAGS,MAAM;IACtB;EACJ;EACA,MAAMR,IAAI,GAAGD,SAAS,CAACC,IAAI;EAC3B;EACA,IAAI,CAACA,IAAI,IAAIA,IAAI,CAACS,QAAQ,EAAE;IACxB,OAAO,IAAI;EACf;EAEA,IAAIC,UAAU;EACd,IAAIvB,YAAY,CAACa,IAAI,CAAC,EAAE;IACpBU,UAAU,GAAGrB,WAAW,CAACW,