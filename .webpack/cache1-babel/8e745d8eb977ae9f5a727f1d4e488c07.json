ngth;\n        metadata.costumesCount += target.sprite.costumes_.length;\n        metadata.scriptCount += target.sprite.blocks._scripts.length;\n        metadata.soundsCount += target.sprite.sounds.length;\n        for (const variableName in target.variables) {\n            const variable = target.variables[variableName];\n            if (variable.type === 'list') {\n                ++metadata.listsCount;\n            } else {\n                ++metadata.variablesCount;\n            }\n        }\n    }\n\n    return metadata;\n};\n\nexport default collectMetadata;\n"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA,MAAMA,eAAe,GAAG,SAAlBA,eAAeA,CAAaC,EAAE,EAAiC;EAAA,IAA/BC,WAAW,GAAAC,SAAA,CAAAC,MAAA,QAAAD,SAAA,QAAAE,SAAA,GAAAF,SAAA,MAAG,EAAE;EAAA,IAAEG,MAAM,GAAAH,SAAA,CAAAC,MAAA,QAAAD,SAAA,QAAAE,SAAA,GAAAF,SAAA,MAAG,EAAE;EAC/D;EACA,MAAMI,QAAQ,GAAG;IACbL,WAAW,EAAEA,WAAW;IACxBM,QAAQ,EAAEF,MAAM;IAChBG,WAAW,EAAE,CAAC;IACdC,WAAW,EAAE,CAAC;IACdC,aAAa,EAAE,CAAC;IAChBC,UAAU,EAAE,CAAC;IACbC,WAAW,EAAE,CAAC;IACdC,WAAW,EAAE,CAAC;IACdC,cAAc,EAAE;EACpB,CAAC;EAED,KAAK,MAAMC,MAAM,IAAIf,EAAE,CAACgB,OAAO,CAACC,OAAO,EAAE;IACrC,EAAEX,QAAQ,CAACE,WAAW;IACtBF,QAAQ,CAACG,WAAW,IAAIS,MAAM,CAACC,IAAI,CAACJ,MAAM,CAACK,MAAM,CAACC,MAAM,CAACC,OAAO,CAAC,CAACnB,MAAM;IACxEG,QAAQ,CAACI,aAAa,IAAIK,MAAM,CAACK,MAAM,CAACG,SAAS,CAACpB,MAAM;IACxDG,QAAQ,CAACM,WAAW,IAAIG,MAAM,CAACK,MAAM,CAACC,MAAM,CAACG,QAAQ,CAACrB,MAAM;IAC5DG,QAAQ,CAACO,WAAW,IAAIE,MAAM,CAACK,MAAM,CAACK,MAAM,CAACtB,MAAM;IACnD,KAAK,MAAMuB,YAAY,IAAIX,MAAM,CAACY,SAAS,EAAE;MACzC,MAAMC,QAAQ,GAAGb,MAAM,CAACY,SAAS,CAACD,YAAY,CAAC;MAC/C,IAAIE,QAAQ,CAACC,IAAI,KAAK,MAAM,EAAE;QAC1B,EAAEvB,QAAQ,CAACK,UAAU;MACzB,CAAC,MAAM;QACH,EAAEL,QAAQ,CAACQ,cAAc;MAC7B;IACJ;EACJ;EAEA,OAAOR,QAAQ;AACnB,CAAC;AAED,eAAeP,eAAe","ignoreList":[]}]}