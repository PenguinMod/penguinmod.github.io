Props = omit(this.props, ['onSetFontsLoaded']);\n            return (\n                <WrappedComponent\n                    {...componentProps}\n                />\n            );\n        }\n    }\n\n\n    FontLoaderComponent.propTypes = {\n        fontsLoaded: PropTypes.bool.isRequired,\n        onSetFontsLoaded: PropTypes.func.isRequired\n    };\n    const mapStateToProps = state => ({\n        fontsLoaded: state.scratchGui.fontsLoaded\n    });\n    const mapDispatchToProps = dispatch => ({\n        onSetFontsLoaded: () => dispatch(setFontsLoaded())\n    });\n    return connect(\n        mapStateToProps,\n        mapDispatchToProps\n    )(FontLoaderComponent);\n};\n\nexport {\n    FontLoaderHOC as default\n};\n"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,IAAI,MAAM,aAAa;AAC9B,SAAQC,OAAO,QAAO,aAAa;AACnC,SAAQC,cAAc,QAAO,0BAA0B;AACvD,SAAQC,SAAS,QAAO,sBAAsB;;AAE9C;AACA;AACA;AACA;AACA,MAAMC,aAAa,GAAG,SAAhBA,aAAaA,CAAaC,gBAAgB,EAAE;EAC9C,MAAMC,mBAAmB,SAASR,KAAK,CAACS,SAAS,CAAC;IAC9CC,iBAAiBA,CAAA,EAAI;MACjB,IAAI,IAAI,CAACC,KAAK,CAACC,WAAW,EAAE;MAE5BP,SAAS,CAAC,CAAC,CAACQ,IAAI,CAAC,MAAM,IAAI,CAACF,KAAK,CAACG,gBAAgB,CAAC,CAAC,CAAC;IACzD;IACAC,MAAMA,CAAA,EAAI;MACN,MAAMC,cAAc,GAAGd,IAAI,CAAC,IAAI,CAACS,KAAK,EAAE,CAAC,kBAAkB,CAAC,CAAC;MAC7D,oBACIX,KAAA,CAAAiB,aAAA,CAACV,gBAAgB,EACTS,cACP,CAAC;IAEV;EACJ;EAGAR,mBAAmB,CAACU,SAAS,GAAG;IAC5BN,WAAW,EAAEX,SAAS,CAACkB,IAAI,CAACC,UAAU;IACtCN,gBAAgB,EAAEb,SAAS,CAACoB,IAAI,CAACD;EACrC,CAAC;EACD,MAAME,eAAe,GAAGC,KAAK,KAAK;IAC9BX,WAAW,EAAEW,KAAK,CAACC,UAAU,CAACZ;EAClC,CAAC,CAAC;EACF,MAAMa,kBAAkB,GAAGC,QAAQ,KAAK;IACpCZ,gBAAgB,EAAEA,CAAA,KAAMY,QAAQ,CAACtB,cAAc,CAAC,CAAC;EACrD,CAAC,CAAC;EACF,OAAOD,OAAO,CACVmB,eAAe,EACfG,kBACJ,CAAC,CAACjB,mBAAmB,CAAC;AAC1B,CAAC;AAED,SACIF,aAAa,IAAIqB,OAAO","ignoreList":[]}]}