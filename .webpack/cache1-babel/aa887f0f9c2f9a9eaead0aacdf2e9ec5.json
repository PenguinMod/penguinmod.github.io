handleChangeFallback',\n            'handleFinish'\n        ]);\n        this.state = {\n            name: '',\n            fallback: FontFallback.DEFAULT,\n            localFonts: null\n        };\n    }\n\n    componentDidMount () {\n        // Chrome-only API\n        if (typeof queryLocalFonts === 'function') {\n            // eslint-disable-next-line no-undef\n            queryLocalFonts().then(fonts => {\n                const uniqueFamilies = [...new Set(fonts.map(i => i.family))];\n                this.setState({\n                    localFonts: uniqueFamilies\n                });\n            });\n        }\n    }\n\n    handleChangeName (name) {\n        this.setState({\n            name\n        });\n    }\n\n    handleChangeFallback (fallback) {\n        this.setState({\n            fallback\n        });\n    }\n\n    handleFinish () {\n        this.props.fontManager.addSystemFont(this.state.name, this.state.fallback);\n        this.props.onClose();\n    }\n\n    render () {\n        return (\n            <React.Fragment>\n                <p>\n                    <FormattedMessage\n                        // eslint-disable-next-line max-len\n                        defaultMessage=\"Type in the name of any font built in to your computer. The font may not appear correctly for everyone.\"\n                        description=\"Part of font management modal.\"\n                        id=\"tw.fonts.system.name\"\n                    />\n                </p>\n\n                <FontName\n                    name={this.state.name}\n                    onChange={this.handleChangeName}\n                    fontManager={this.props.fontManager}\n                    placeholder=\"Wingdings\"\n                    options={this.state.localFonts}\n                />\n\n                {this.state.name && (\n                    <React.Fragment>\n                        <FontPlayground family={`${this.state.name}, ${this.state.fallback}`} />\n\n                        <FontFallback\n                            fallback={this.state.fallback}\n                            onChange={this.handleChangeFallback}\n                        />\n                    </React.Fragment>\n                )}\n\n                <AddButton\n                    onClick={this.handleFinish}\n                    disabled={!this.state.name}\n                />\n            </React.Fragment>\n        );\n    }\n}\n\nAddSystemFont.propTypes = {\n    fontManager: PropTypes.shape({\n        addSystemFont: PropTypes.func.isRequired,\n        hasFont: PropTypes.func.isRequired\n    }).isRequired,\n    onClose: PropTypes.func.isRequired\n};\n\nexport default AddSystemFont;\n"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,SAAS,MAAM,YAAY;AAClC,SAAQC,gBAAgB,QAAO,YAAY;AAC3C,OAAOC,OAAO,MAAM,gBAAgB;AACpC,OAAOC,QAAQ,MAAM,iBAAiB;AACtC,OAAOC,cAAc,MAAM,uBAAuB;AAClD,OAAOC,YAAY,MAAM,qBAAqB;AAC9C,OAAOC,SAAS,MAAM,kBAAkB;AAExC,MAAMC,aAAa,SAASR,KAAK,CAACS,SAAS,CAAC;EACxCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZR,OAAO,CAAC,IAAI,EAAE,CACV,kBAAkB,EAClB,sBAAsB,EACtB,cAAc,CACjB,CAAC;IACF,IAAI,CAACS,KAAK,GAAG;MACTC,IAAI,EAAE,EAAE;MACRC,QAAQ,EAAER,YAAY,CAACS,OAAO;MAC9BC,UAAU,EAAE;IAChB,CAAC;EACL;EAEAC,iBAAiBA,CAAA,EAAI;IACjB;IACA,IAAI,OAAOC,eAAe,KAAK,UAAU,EAAE;MACvC;MACAA,eAAe,CAAC,CAAC,CAACC,IAAI,CAACC,KAAK,IAAI;QAC5B,MAAMC,cAAc,GAAG,CAAC,GAAG,IAAIC,GAAG,CAACF,KAAK,CAACG,GAAG,CAACC,CAAC,IAAIA,CAAC,CAACC,MAAM,CAAC,CAAC,CAAC;QAC7D,IAAI,CAACC,QAAQ,CAAC;UACVV,UAAU,EAAEK;QAChB,CAAC,CAAC;MACN,CAAC,CAAC;IACN;EACJ;EAEAM,gBAAgBA,CAAEd,IAAI,EAAE;IACpB,IAAI,CAACa,QAAQ,CAAC;MACVb;IACJ,CAAC,CAAC;EACN;EAEAe,oBAAoBA,CAAEd,QAAQ,EAAE;IAC5B,IAAI,CAACY,QAAQ,CAAC;MACVZ;IACJ,CAAC,CAAC;EACN;EAEAe,YAAYA,CAAA,EAAI;IACZ,IAAI,CAAClB,KAAK,CAACmB,WAAW,CAACC,aAAa,CAAC,IAAI,CAACnB,KAAK,CAACC,IAAI,EAAE,IAAI,CAACD,KAAK,CAACE,QAAQ,CAAC;IAC1E,IAAI,CAACH,KAAK,CAACqB,OAAO,CAAC,CAAC;EACxB;EAEAC,MAAMA,CAAA,EAAI;IACN,oBACIjC,KAAA,CAAAkC,aAAA,CAAClC,KAAK,CAACmC,QAAQ,qBACXnC,KAAA,CAAAkC,aAAA,yBACIlC,KAAA,