{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\scratch-paint\\src\\helper\\selection-tools\\rotate-tool.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\scratch-paint\\src\\helper\\selection-tools\\rotate-tool.js","mtime":1777529318086},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["paper","RotateTool","constructor","onUpdateImage","rotItems","rotGroupPivot","prevRot","onMouseDown","hitResult","boundsPath","selectedItems","bounds","center","item","parent","Layer","push","onMouseDrag","event","rotAngle","point","subtract","angle","modifiers","shift","Math","round","i","length","rotate","onMouseUp","button"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/node_modules/scratch-paint/src/helper/selection-tools/rotate-tool.js"],"sourcesContent":["import paper from '@turbowarp/paper';\n\n/**\n * Tool to handle rotation when dragging the rotation handle in the bounding box tool.\n */\nclass RotateTool {\n    /**\n     * @param {!function} onUpdateImage A callback to call when the image visibly changes\n     */\n    constructor (onUpdateImage) {\n        this.rotItems = [];\n        this.rotGroupPivot = null;\n        this.prevRot = 90;\n        this.onUpdateImage = onUpdateImage;\n    }\n\n    /**\n     * @param {!paper.HitResult} hitResult Data about the location of the mouse click\n     * @param {!object} boundsPath Where the boundaries of the hit item are\n     * @param {!Array.<paper.Item>} selectedItems Set of selected paper.Items\n     */\n    onMouseDown (hitResult, boundsPath, selectedItems) {\n        this.rotGroupPivot = boundsPath.bounds.center;\n        for (const item of selectedItems) {\n            // Rotate only root items\n            if (item.parent instanceof paper.Layer) {\n                this.rotItems.push(item);\n            }\n        }\n        this.prevRot = 90;\n    }\n    onMouseDrag (event) {\n        let rotAngle = (event.point.subtract(this.rotGroupPivot)).angle;\n        if (event.modifiers.shift) {\n            rotAngle = Math.round(rotAngle / 45) * 45;\n        }\n\n        for (let i = 0; i < this.rotItems.length; i++) {\n            const item = this.rotItems[i];\n\n            item.rotate(rotAngle - this.prevRot, this.rotGroupPivot);\n        }\n\n        this.prevRot = rotAngle;\n    }\n    onMouseUp (event) {\n        if (event.event.button > 0) return; // only first mouse button\n\n        this.rotItems.length = 0;\n        this.rotGroupPivot = null;\n        this.prevRot = 90;\n\n        this.onUpdateImage();\n    }\n}\n\nexport default RotateTool;\n"],"mappings":"AAAA,OAAOA,KAAK,MAAM,kBAAkB;;AAEpC;AACA;AACA;AACA,MAAMC,UAAU,CAAC;EACb;AACJ;AACA;EACIC,WAAWA,CAAEC,aAAa,EAAE;IACxB,IAAI,CAACC,QAAQ,GAAG,EAAE;IAClB,IAAI,CAACC,aAAa,GAAG,IAAI;IACzB,IAAI,CAACC,OAAO,GAAG,EAAE;IACjB,IAAI,CAACH,aAAa,GAAGA,aAAa;EACtC;;EAEA;AACJ;AACA;AACA;AACA;EACII,WAAWA,CAAEC,SAAS,EAAEC,UAAU,EAAEC,aAAa,EAAE;IAC/C,IAAI,CAACL,aAAa,GAAGI,UAAU,CAACE,MAAM,CAACC,MAAM;IAC7C,KAAK,MAAMC,IAAI,IAAIH,aAAa,EAAE;MAC9B;MACA,IAAIG,IAAI,CAACC,MAAM,YAAYd,KAAK,CAACe,KAAK,EAAE;QACpC,IAAI,CAACX,QAAQ,CAACY,IAAI,CAACH,IAAI,CAAC;MAC5B;IACJ;IACA,IAAI,CAACP,OAAO,GAAG,EAAE;EACrB;EACAW,WAAWA,CAAEC,KAAK,EAAE;IAChB,IAAIC,QAAQ,GAAID,KAAK,CAACE,KAAK,CAACC,QAAQ,CAAC,IAAI,CAAChB,aAAa,CAAC,CAAEiB,KAAK;IAC/D,IAAIJ,KAAK,CAACK,SAAS,CAACC,KAAK,EAAE;MACvBL,QAAQ,GAAGM,IAAI,CAACC,KAAK,CAACP,QAAQ,GAAG,EAAE,CAAC,GAAG,EAAE;IAC7C;IAEA,KAAK,IAAIQ,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAG,IAAI,CAACvB,QAAQ,CAACwB,MAAM,EAAED,CAAC,EAAE,EAAE