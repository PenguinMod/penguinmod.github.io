& costume.name,\n        rotationCenterX: costume && costume.rotationCenterX,\n        rotationCenterY: costume && costume.rotationCenterY,\n        imageFormat: costume && costume.dataFormat,\n        imageId: targetId && `${targetId}${costume.skinId}`,\n        rtl: state.locales.isRtl,\n        selectedCostumeIndex: index,\n        vm: state.scratchGui.vm,\n        zoomLevelId: targetId\n    };\n};\n\nconst mapDispatchToProps = dispatch => ({\n    onManageFonts: () => dispatch(openFontsModal())\n});\n\nexport default ErrorBoundaryHOC('paint')(connect(\n    mapStateToProps,\n    mapDispatchToProps\n)(PaintEditorWrapper));\n"],"mappings":";;;;AAAA,OAAOA,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,OAAOC,OAAO,MAAM,gBAAgB;AACpC,OAAOC,EAAE,MAAM,YAAY;AAC3B,OAAOC,WAAW,MAAM,yBAAyB;AACjD,SAAQC,cAAc,QAAO,sBAAsB;AACnD,OAAOC,gBAAgB,MAAM,+BAA+B;AAC5D,SAAQC,cAAc,QAAO,oBAAoB;AAEjD,SAAQC,OAAO,QAAO,aAAa;AAEnC,MAAMC,kBAAkB,SAASR,KAAK,CAACS,SAAS,CAAC;EAC7CC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZV,OAAO,CAAC,IAAI,EAAE,CACV,mBAAmB,EACnB,kBAAkB,EAClB,mBAAmB,CACtB,CAAC;IACF,IAAI,CAACW,KAAK,GAAG;MACTC,KAAK,EAAE,IAAI,CAACF,KAAK,CAACG,EAAE,CAACC,OAAO,CAACC,WAAW,CAACC,QAAQ,CAAC;IACtD,CAAC;EACL;EACAC,iBAAiBA,CAAA,EAAG;IAChB,IAAI,CAACP,KAAK,CAACG,EAAE,CAACC,OAAO,CAACC,WAAW,CAACG,EAAE,CAAC,QAAQ,EAAE,IAAI,CAACC,iBAAiB,CAAC;EAC1E;EACAC,qBAAqBA,CAACC,SAAS,EAAEC,SAAS,EAAE;IACxC,OAAO,IAAI,CAACZ,KAAK,CAACa,OAAO,KAAKF,SAAS,CAACE,OAAO,IAC3C,IAAI,CAACb,KAAK,CAACc,GAAG,KAAKH,SAAS,CAACG,GAAG,IAChC,IAAI,CAACd,KAAK,CAACe,IAAI,KAAKJ,SAAS,CAACI,IAAI,IAClC,IAAI,CAACf,KAAK,CAACgB,MAAM,KAAKL,SAAS,CAACK,MAAM,IACtC,IAAI,CAAChB,KAAK,CAACiB,eAAe,KAAKN,SAAS,CAACM,eAAe,IACxD,IAAI,CAAChB,KAAK,CAACC,KAAK,KAAKU,SAAS,CAACV,KAAK;EAC5C;EACAgB,oBAAoBA,CAAA,EAAG;IACnB,IAAI,CAAClB,KAAK,CAACG,EAAE,CAACC,OAAO,CAACC,WAAW,CAACc,GAAG,CAAC,QAAQ,EAAE,IAAI,CAACV,iBAAiB,CAAC;EAC3E;EACAA,iBAAiBA,CAAA,EAAG;IAChB,IAAI,CAACW,QAAQ,CAAC;MACVlB,KAAK,EAAE,IAAI,CAACF,KAAK,CAACG,EAAE,CAACC,OAAO,CAACC,WAAW,CAACC,QAAQ,CAAC;IACtD