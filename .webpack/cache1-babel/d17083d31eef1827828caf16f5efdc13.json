ck(0 - data.deltaY);\n\n        const matchFields = {};\n        const scrollFields = {};\n        if (data.deltaY < 0) {\n            matchFields.KEY_OPTION = 'up arrow';\n            scrollFields.KEY_OPTION = 'up';\n        } else if (data.deltaY > 0) {\n            matchFields.KEY_OPTION = 'down arrow';\n            scrollFields.KEY_OPTION = 'down';\n        } else {\n            return;\n        }\n\n        this.runtime.startHats('event_whenkeypressed', matchFields);\n        this.runtime.startHats('event_whenmousescrolled', scrollFields);\n    }\n\n    // pm: expose scroll delta for sensing block\n    getScrollDelta () {\n        return this.scrollDelta;\n    }\n}\n\nmodule.exports = MouseWheel;\n"],"mappings":"AAAA,MAAMA,UAAU,CAAC;EACbC,WAAWA,CAAEC,OAAO,EAAE;IAClB;AACR;AACA;AACA;IACQ,IAAI,CAACA,OAAO,GAAGA,OAAO;;IAEtB;IACA,IAAI,CAACC,WAAW,GAAG,CAAC;IACpB,IAAI,CAACD,OAAO,CAACE,EAAE,CAAC,kBAAkB,EAAE,MAAM;MACtC,IAAI,CAACD,WAAW,GAAG,CAAC;IACxB,CAAC,CAAC;EACN;EAEAE,4BAA4BA,CAAEC,MAAM,EAAE;IAClC,IAAI,wBAAwB,IAAI,IAAI,CAACJ,OAAO,EAAE;MAC1C,IAAI,CAACA,OAAO,CAACK,sBAAsB,CAACC,cAAc,IAAIF,MAAM;IAChE;EACJ;;EAEA;AACJ;AACA;AACA;EACIG,QAAQA,CAAEC,IAAI,EAAE;IACZ;IACA,IAAI,CAACP,WAAW,GAAGO,IAAI,CAACC,MAAM;IAC9B;IACA,IAAI,CAACN,4BAA4B,CAAC,CAAC,GAAGK,IAAI,CAACC,MAAM,CAAC;IAElD,MAAMC,WAAW,GAAG,CAAC,CAAC;IACtB,MAAMC,YAAY,GAAG,CAAC,CAAC;IACvB,IAAIH,IAAI,CAACC,MAAM,GAAG,CAAC,EAAE;MACjBC,WAAW,CAACE,UAAU,GAAG,UAAU;MACnCD,YAAY,CAACC,UAAU,GAAG,IAAI;IAClC,CAAC,MAAM,IAAIJ,IAAI,CAACC,MAAM,GAAG,CAAC,EAAE;MACxBC,WAAW,CAACE,UAAU,GAAG,YAAY;MACrCD,YAAY,CAACC,UAAU,GAAG,MAAM;IACpC,CAAC,MAAM;MACH;IACJ;IAEA,IAAI,CAACZ,OAAO,CAACa,SAAS,CAAC,sBAAsB,EAAEH,WAAW,CAAC;IAC3D,IAAI,CAACV,OAAO,CAACa,SAAS,CAAC,yBAAyB,EAAEF,YAAY,CAAC;EACnE;;EAEA;EACAG,cAAcA,CAAA,EAAI;IACd,OAAO,IAAI,CAACb,WAAW;EAC3B;AACJ;AAEAc,MAAM,CAACC,OAAO,GAAGlB,UAAU","ignoreList":[]}]}