-units\n        const nativeSize = vm.renderer.getNativeSize();\n        return [\n            ((stageWidth / nativeSize[0]) * x) + (stageWidth / 2),\n            -((stageHeight / nativeSize[1]) * y) + (stageHeight / 2)\n        ];\n    }\n\n    render () {\n        const {\n            className,\n            highlightedTargetId,\n            highlightedTargetTime,\n            vm\n        } = this.props;\n\n        if (!(highlightedTargetId && vm && vm.renderer &&\n            vm.runtime.getTargetById(highlightedTargetId))) return null;\n\n        const target = vm.runtime.getTargetById(highlightedTargetId);\n        const bounds = vm.renderer.getBounds(target.drawableID);\n        const [left, top] = this.getPageCoords(bounds.left, bounds.top);\n        const [right, bottom] = this.getPageCoords(bounds.right, bounds.bottom);\n\n        const pad = 2; // px\n\n        return (\n            <div\n                className={className}\n                // Ensure new DOM element each update to restart animation\n                key={highlightedTargetTime}\n                style={{\n                    position: 'absolute',\n                    top: `${top - pad}px`,\n                    left: `${left - pad}px`,\n                    width: `${(right - left) + (2 * pad)}px`,\n                    height: `${(bottom - top) + (2 * pad)}px`\n                }}\n            />\n        );\n    }\n}\n\nTargetHighlight.propTypes = {\n    className: PropTypes.string,\n    highlightedTargetId: PropTypes.string,\n    highlightedTargetTime: PropTypes.number,\n    stageHeight: PropTypes.number,\n    stageWidth: PropTypes.number,\n    vm: PropTypes.instanceOf(VM)\n};\n\nconst mapStateToProps = state => ({\n    highlightedTargetTime: state.scratchGui.targets.highlightedTargetTime,\n    highlightedTargetId: state.scratchGui.targets.highlightedTargetId,\n    vm: state.scratchGui.vm\n});\n\nconst mapDispatchToProps = () => ({});\n\nexport default connect(\n    mapStateToProps,\n    mapDispatchToProps\n)(TargetHighlight);\n"],"mappings":"AAAA,OAAOA,OAAO,MAAM,gBAAgB;AACpC,OAAOC,KAAK,MAAM,OAAO;AACzB,OAAOC,SAAS,MAAM,YAAY;AAElC,SAAQC,OAAO,QAAO,aAAa;AACnC,OAAOC,EAAE,MAAM,YAAY;AAE3B,MAAMC,eAAe,SAASJ,KAAK,CAACK,SAAS,CAAC;EAC1CC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZR,OAAO,CAAC,IAAI,EAAE,CACV,eAAe,CAClB,CAAC;EACN;;EAEA;EACAS,aAAaA,CAAEC,CAAC,EAAEC,CAAC,EAAE;IACjB,MAAM;MAACC,UAAU;MAAEC,WAAW;MAAEC;IAAE,CAAC,GAAG,IAAI,CAACN,KAAK;IAChD;IACA,MAAMO,UAAU,GAAGD,EAAE,CAACE,QAAQ,CAACC,aAAa,CAAC,CAAC;IAC9C,OAAO,CACDL,UAAU,GAAGG,UAAU,CAAC,CAAC,CAAC,GAAIL,CAAC,GAAKE,UAAU,GAAG,CAAE,EACrD,EAAGC,WAAW,GAAGE,UAAU,CAAC,CAAC,CAAC,GAAIJ,CAAC,CAAC,GAAIE,WAAW,GAAG,CAAE,CAC3D;EACL;EAEAK,MAAMA,CAAA,EAAI;IACN,MAAM;MACFC,SAAS;MACTC,mBAAmB;MACnBC,qBAAqB;MACrBP;IACJ,CAAC,GAAG,IAAI,CAACN,KAAK;IAEd,IAAI,EAAEY,mBAAmB,IAAIN,EAAE,IAAIA,EAAE,CAACE,QAAQ,IAC1CF,EAAE,CAACQ,OAAO,CAACC,aAAa,CAACH,mBAAmB,CAAC,CAAC,EAAE,OAAO,IAAI;IAE/D,MAAMI,MAAM,GAAGV,EAAE,CAACQ,OAAO,CAACC,aAAa,CAACH,mBAAmB,CAAC;IAC5D,MAAMK,MAAM,GAAGX,EAAE,CAACE,QAAQ,CAACU,SAAS,CAACF,MAAM,CAACG,UAAU,CAAC;IACvD,MAAM,CAACC,IAAI,EAAEC,GAAG,CAAC,GAAG,IAAI,CAACpB,aAAa,CAACgB,MAAM,CAACG,IAAI,EAAEH,MAAM,CAACI,GAAG,CAAC;IAC/D,MAAM,CAACC,KAAK,EAAEC,MAAM,CAAC,GAAG,IAAI,CAACtB,aAAa,CAACgB,MAAM,CAACK,KAAK,EAAEL,MAAM,CAACM,MAAM,CAAC;IAEvE,MAAMC,GAAG,GAAG,CAAC,CAAC,CAAC;;IAEf,oBACI/B,KAAA,CAAAgC,aAAA;MACId,SAAS,EAAEA;MACX;MAAA;MACAe,GAAG,EAAEb,qBAAsB;MAC3Bc,KAAK,EAAE;QACHC,QAAQ,EAAE,UAAU;QACpBP,GAAG,KAAAQ,MAAA,CAAKR,GAAG,GAAGG,GAAG,OAAI;QACrBJ,IAAI,KAAAS,MAAA,CAAKT,IAAI,GAAGI,GAAG,OAAI;QACvBM,KAAK,KAAAD,MAAA,CAAMP,KAAK,GAAGF,IAAI,GAAK,CAAC,GAAGI,GAAI,OAAI;QACxCO,MAAM,KAAAF,MAAA,CAAMN,MAAM,GAAGF,GAAG,GAAK,CAAC,GAAGG,GAAI;MACzC;IAAE,CACL,CAAC;EAEV;AACJ;AAEA3B,eAAe,CAACmC,SAAS,GAAG;EACxBrB,SAAS,EAAEjB,SAAS,CAACuC,MAAM;EAC3BrB,mBAAmB,EAAElB,SAAS,CAACuC,MAAM;EACrCpB,qBAAqB,EAAEnB,SAAS,CAACwC,MAAM;EACvC7B,WAAW,EAAEX,SAAS,CAACwC,MAAM;EAC7B9B,UAAU,EAAEV,SAAS,CAACwC,MAAM;EAC5B5B,EAAE,EAAEZ,SAAS,CAACyC,UAAU,CAACvC,EAAE;AAC/B,CAAC;AAED,MAA