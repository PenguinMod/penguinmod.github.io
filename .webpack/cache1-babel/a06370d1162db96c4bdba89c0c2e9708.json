, ':');\n    }\n    return newSearch;\n};\n\n/**\n * Change URL search params to something else in place\n * @param {URLSearchParams} params New URLSearchParams\n */\nconst setSearchParams = params => {\n    const newSearch = searchParamsToString(params);\n    if (location.search !== newSearch) {\n        history.replaceState(null, null, `${location.pathname}${newSearch}${location.hash}`);\n    }\n};\n\nexport {\n    setProjectId,\n    searchParamsToString,\n    setSearchParams\n};\n"],"mappings":"AAAA,SAAQA,YAAY,IAAIC,iBAAiB,QAAO,2BAA2B;AAE3E,MAAMD,YAAY,GAAGA,CAACE,QAAQ,EAAEC,SAAS,KAAK;EAC1C,IAAIC,OAAO,CAACC,GAAG,CAACC,aAAa,KAAK,UAAU,EAAE;IAC1C,IAAIH,SAAS,KAAK,GAAG,EAAE;MACnBA,SAAS,GAAG,EAAE;IAClB;IACAI,QAAQ,CAACC,IAAI,MAAAC,MAAA,CAAML,OAAO,CAACC,GAAG,CAACK,IAAI,EAAAD,MAAA,CAAGN,SAAS,CAAE;IACjD;EACJ;EACAD,QAAQ,CAACD,iBAAiB,CAACE,SAAS,CAAC,CAAC;AAC1C,CAAC;AAED,MAAMQ,oBAAoB,GAAGC,MAAM,IAAI;EACnC,IAAIC,SAAS,GAAGD,MAAM,CAACE,QAAQ,CAAC,CAAC;EACjC,IAAID,SAAS,CAACE,MAAM,GAAG,CAAC,EAAE;IACtB;IACAF,SAAS,OAAAJ,MAAA,CAAOI,SAAS,CAAE;IAC3BA,SAAS,GAAGA;IACR;IACA;IAAA,CACCG,OAAO,CAAC,WAAW,EAAE,EAAE;IACxB;IAAA,CACCA,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CACpBA,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC;EAC7B;EACA,OAAOH,SAAS;AACpB,CAAC;;AAED;AACA;AACA;AACA;AACA,MAAMI,eAAe,GAAGL,MAAM,IAAI;EAC9B,MAAMC,SAAS,GAAGF,oBAAoB,CAACC,MAAM,CAAC;EAC9C,IAAIL,QAAQ,CAACW,MAAM,KAAKL,SAAS,EAAE;IAC/BM,OAAO,CAACC,YAAY,CAAC,IAAI,EAAE,IAAI,KAAAX,MAAA,CAAKF,QAAQ,CAACc,QAAQ,EAAAZ,MAAA,CAAGI,SAAS,EAAAJ,MAAA,CAAGF,QAAQ,CAACe,IAAI,CAAE,CAAC;EACxF;AACJ,CAAC;AAED,SACItB,YAAY,EACZW,oBAAoB,EACpBM,eAAe","ignoreList":[]}]}