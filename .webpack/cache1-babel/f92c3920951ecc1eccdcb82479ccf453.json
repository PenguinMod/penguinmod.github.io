his.inputNode;\n\n        this.initialized = true;\n    }\n\n    /**\n     * Set the effects value.\n     * @private\n     * @param {number} value - new value to set effect to\n     */\n    _set (value, additionalDecay) {\n        this.value = value;\n\n        const {gain} = this.outputNode;\n        const {currentTime, DECAY_DURATION} = this.audioEngine;\n\n        if (typeof additionalDecay === \"number\") {\n            gain.linearRampToValueAtTime(value / 100, currentTime + (DECAY_DURATION + additionalDecay));\n            return;\n        }\n        gain.linearRampToValueAtTime(value / 100, currentTime + DECAY_DURATION);\n    }\n\n    /**\n     * Clean up and disconnect audio nodes.\n     */\n    dispose () {\n        if (!this.initialized) {\n            return;\n        }\n\n        this.outputNode.disconnect();\n\n        this.inputNode = null;\n        this.outputNode = null;\n        this.target = null;\n\n        this.initialized = false;\n    }\n}\n\nmodule.exports = VolumeEffect;\n"],"mappings":"AAAA,MAAMA,MAAM,GAAGC,OAAO,CAAC,UAAU,CAAC;;AAElC;AACA;AACA;AACA,MAAMC,YAAY,SAASF,MAAM,CAAC;EAC9B;AACJ;AACA;AACA;EACI,IAAIG,aAAaA,CAAA,EAAI;IACjB,OAAO,GAAG;EACd;;EAEA;AACJ;AACA;AACA;EACI,IAAIC,IAAIA,CAAA,EAAI;IACR,OAAO,QAAQ;EACnB;;EAEA;AACJ;AACA;AACA;AACA;AACA;EACIC,UAAUA,CAAA,EAAI;IACV,IAAI,CAACC,SAAS,GAAG,IAAI,CAACC,WAAW,CAACC,YAAY,CAACC,UAAU,CAAC,CAAC;IAC3D,IAAI,CAACC,UAAU,GAAG,IAAI,CAACJ,SAAS;IAEhC,IAAI,CAACK,WAAW,GAAG,IAAI;EAC3B;;EAEA;AACJ;AACA;AACA;AACA;EACIC,IAAIA,CAAEC,KAAK,EAAEC,eAAe,EAAE;IAC1B,IAAI,CAACD,KAAK,GAAGA,KAAK;IAElB,MAAM;MAACE;IAAI,CAAC,GAAG,IAAI,CAACL,UAAU;IAC9B,MAAM;MAACM,WAAW;MAAEC;IAAc,CAAC,GAAG,IAAI,CAACV,WAAW;IAEtD,IAAI,OAAOO,eAAe,KAAK,QAAQ,EAAE;MACrCC,IAAI,CAACG,uBAAuB,CAACL,KAAK,GAAG,GAAG,EAAEG,WAAW,IAAIC,cAAc,GAAGH,eAAe,CAAC,CAAC;MAC3F;IACJ;IACAC,IAAI,CAACG,uBAAuB,CAACL,KAAK,GAAG,GAAG,EAAEG,WAAW,GAAGC,cAAc,CAAC;EAC3E;;EAEA;AACJ;AACA;EACIE,OAAOA,CAAA,EAAI;IACP,IAAI,CAAC,IAAI,CAACR,WAAW,EAAE;MACnB;IACJ;IAEA,IAAI,CAACD,UAAU,CAACU,UAAU,C