     const len = array.byteLength;\n        for (let i = 0; i < len; i++) {\n            binary += String.fromCharCode(array[i]);\n        }\n        return btoa(binary);\n    }\n\n    /**\n    * Convert an array buffer to a base64 encoded string.\n    * @param {array} buffer - an array buffer to convert.\n    * @return {string} - the base64 encoded string.\n    */\n    static arrayBufferToBase64 (buffer) {\n        return Base64Util.uint8ArrayToBase64(new Uint8Array(buffer));\n    }\n\n}\n\nmodule.exports = Base64Util;\n"],"mappings":"AAAA,MAAMA,IAAI,GAAGC,OAAO,CAAC,MAAM,CAAC;AAC5B,MAAMC,IAAI,GAAGD,OAAO,CAAC,MAAM,CAAC;AAE5B,MAAME,UAAU,CAAC;EAEb;AACJ;AACA;AACA;AACA;EACI,OAAOC,kBAAkBA,CAAEC,MAAM,EAAE;IAC/B,MAAMC,YAAY,GAAGN,IAAI,CAACK,MAAM,CAAC;IACjC,MAAME,GAAG,GAAGD,YAAY,CAACE,MAAM;IAC/B,MAAMC,KAAK,GAAG,IAAIC,UAAU,CAACH,GAAG,CAAC;IACjC,KAAK,IAAII,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAGJ,GAAG,EAAEI,CAAC,EAAE,EAAE;MAC1BF,KAAK,CAACE,CAAC,CAAC,GAAGL,YAAY,CAACM,UAAU,CAACD,CAAC,CAAC;IACzC;IACA,OAAOF,KAAK;EAChB;;EAEA;AACJ;AACA;AACA;AACA;EACI,OAAOI,kBAAkBA,CAAEJ,KAAK,EAAE;IAC9B,IAAIK,MAAM,GAAG,EAAE;IACf,MAAMP,GAAG,GAAGE,KAAK,CAACM,UAAU;IAC5B,KAAK,IAAIJ,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAGJ,GAAG,EAAEI,CAAC,EAAE,EAAE;MAC1BG,MAAM,IAAIE,MAAM,CAACC,YAAY,CAACR,KAAK,CAACE,CAAC,CAAC,CAAC;IAC3C;IACA,OAAOT,IAAI,CAACY,MAAM,CAAC;EACvB;;EAEA;AACJ;AACA;AACA;AACA;EACI,OAAOI,mBAAmBA,CAAEC,MAAM,EAAE;IAChC,OAAOhB,UAAU,CAACU,kBAAkB,CAAC,IAAIH,UAAU,CAACS,MAAM,CAAC,CAAC;EAChE;AAEJ;AAEAC,MAAM,CAACC,OAAO,GAAGlB,UAAU","ignoreList":[]}]}