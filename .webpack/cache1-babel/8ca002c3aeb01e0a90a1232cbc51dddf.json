ent) {\n            blocks[i].parent = oldToNew[blocks[i].parent];\n        }\n        if (blocks[i].next) {\n            blocks[i].next = oldToNew[blocks[i].next];\n        }\n    }\n};\n"],"mappings":"AAAA,MAAMA,GAAG,GAAGC,OAAO,CAAC,OAAO,CAAC;;AAE5B;AACA;AACA;AACA;AACA;AACAC,MAAM,CAACC,OAAO,GAAGC,MAAM,IAAI;EACvB,MAAMC,QAAQ,GAAG,CAAC,CAAC;;EAEnB;EACA,KAAK,IAAIC,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAGF,MAAM,CAACG,MAAM,EAAED,CAAC,EAAE,EAAE;IACpC,MAAME,KAAK,GAAGR,GAAG,CAAC,CAAC;IACnB,MAAMS,KAAK,GAAGL,MAAM,CAACE,CAAC,CAAC,CAACI,EAAE;IAC1BN,MAAM,CAACE,CAAC,CAAC,CAACI,EAAE,GAAGL,QAAQ,CAACI,KAAK,CAAC,GAAGD,KAAK;EAC1C;;EAEA;EACA;EACA,KAAK,IAAIF,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAGF,MAAM,CAACG,MAAM,EAAED,CAAC,EAAE,EAAE;IACpC,KAAK,MAAMK,GAAG,IAAIP,MAAM,CAACE,CAAC,CAAC,CAACM,MAAM,EAAE;MAChC,MAAMC,KAAK,GAAGT,MAAM,CAACE,CAAC,CAAC,CAACM,MAAM,CAACD,GAAG,CAAC;MACnCE,KAAK,CAACC,KAAK,GAAGT,QAAQ,CAACQ,KAAK,CAACC,KAAK,CAAC;MACnCD,KAAK,CAACE,MAAM,GAAGV,QAAQ,CAACQ,KAAK,CAACE,MAAM,CAAC;IACzC;IACA,IAAIX,MAAM,CAACE,CAAC,CAAC,CAACU,MAAM,EAAE;MAClBZ,MAAM,CAACE,CAAC,CAAC,CAACU,MAAM,GAAGX,QAAQ,CAACD,MAAM,CAACE,CAAC,CAAC,CAACU,MAAM,CAAC;IACjD;IACA,IAAIZ,MAAM,CAACE,CAAC,CAAC,CAACW,IAAI,EAAE;MAChBb,MAAM,CAACE,CAAC,CAAC,CAACW,IAAI,GAAGZ,QAAQ,CAACD,MAAM,CAACE,CAAC,CAAC,CAACW,IAAI,CAAC;IAC7C;EACJ;AACJ,CAAC","ignoreList":[]}]}