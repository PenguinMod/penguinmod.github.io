Item ID of the hover indicator item.\n * @return {object} Redux action to change the hovered item.\n */\nconst setHoveredItem = function (hoveredItemId) {\n    return {\n        type: CHANGE_HOVERED,\n        hoveredItemId: hoveredItemId\n    };\n};\n\nconst clearHoveredItem = function () {\n    return {\n        type: CHANGE_HOVERED,\n        hoveredItemId: null\n    };\n};\n\nexport {\n    reducer as default,\n    setHoveredItem,\n    clearHoveredItem\n};\n"],"mappings":"AAAA,OAAOA,GAAG,MAAM,YAAY;AAE5B,MAAMC,cAAc,GAAG,oCAAoC;AAC3D,MAAMC,YAAY,GAAG,IAAI;AAEzB,MAAMC,OAAO,GAAG,SAAVA,OAAOA,CAAaC,KAAK,EAAEC,MAAM,EAAE;EACrC,IAAI,OAAOD,KAAK,KAAK,WAAW,EAAEA,KAAK,GAAGF,YAAY;EACtD,QAAQG,MAAM,CAACC,IAAI;IACnB,KAAKL,cAAc;MACf,IAAI,OAAOI,MAAM,CAACE,aAAa,KAAK,WAAW,EAAE;QAC7CP,GAAG,CAACQ,IAAI,yDAAyD,CAAC;QAClE,OAAOJ,KAAK;MAChB,CAAC,MAAM,IAAI,OAAOC,MAAM,CAACE,aAAa,KAAK,WAAW,IAAIE,KAAK,CAACJ,MAAM,CAACE,aAAa,CAAC,EAAE;QACnFP,GAAG,CAACQ,IAAI,mDAAAE,MAAA,CAAmDL,MAAM,CAACE,aAAa,CAAE,CAAC;QAClF,OAAOH,KAAK;MAChB;MACA,OAAOC,MAAM,CAACE,aAAa;IAC/B;MACI,OAAOH,KAAK;EAChB;AACJ,CAAC;;AAED;AACA;AACA;AACA;AACA;AACA;AACA,MAAMO,cAAc,GAAG,SAAjBA,cAAcA,CAAaJ,aAAa,EAAE;EAC5C,OAAO;IACHD,IAAI,EAAEL,cAAc;IACpBM,aAAa,EAAEA;EACnB,CAAC;AACL,CAAC;AAED,MAAMK,gBAAgB,GAAG,SAAnBA,gBAAgBA,CAAA,EAAe;EACjC,OAAO;IACHN,IAAI,EAAEL,cAAc;IACpBM,aAAa,EAAE;EACnB,CAAC;AACL,CAAC;AAED,SACIJ,OAAO,IAAIU,OAAO,EAClBF,cAAc,EACdC,gBAAgB","ignoreList":[]}]}