t.type = 'file';\n        input.accept = this.props.accept;\n        input.addEventListener('change', this.handleChange);\n        document.body.appendChild(input);\n        input.click();\n        input.remove();\n    }\n    render () {\n        return (\n            <button\n                className={styles.container}\n                onClick={this.handleClick}\n            >\n                {this.props.file ? (\n                    <FormattedMessage\n                        defaultMessage=\"Selected: {name}\"\n                        // eslint-disable-next-line max-len\n                        description=\"Appears in a file selector when a file is selected. {name} could be a string like 'fetch.js'\"\n                        id=\"tw.fileInput.selected\"\n                        values={{\n                            name: this.props.file.name\n                        }}\n                    />\n                ) : (\n                    <FormattedMessage\n                        defaultMessage=\"No file selected.\"\n                        description=\"Appears in a file selector when no file is selected.\"\n                        id=\"tw.fileInput.none\"\n                    />\n                )}\n            </button>\n        );\n    }\n}\n\nFileInput.propTypes = {\n    file: PropTypes.instanceOf(File),\n    accept: PropTypes.string,\n    onChange: PropTypes.func\n};\n\nexport default FileInput;\n"],"mappings":"AAAA,OAAOA,KAAK,MAAM,OAAO;AACzB,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,OAAO,MAAM,gBAAgB;AACpC,SAAQC,gBAAgB,QAAO,YAAY;AAC3C,OAAOC,MAAM,MAAM,kBAAkB;AAErC,MAAMC,SAAS,SAASL,KAAK,CAACM,SAAS,CAAC;EACpCC,WAAWA,CAAEC,KAAK,EAAE;IAChB,KAAK,CAACA,KAAK,CAAC;IACZN,OAAO,CAAC,IAAI,EAAE,CACV,cAAc,EACd,aAAa,CAChB,CAAC;IACF,IAAI,CAACO,KAAK,GAAG;MACTC,IAAI,EAAEF,KAAK,CAACE;IAChB,CAAC;EACL;EACAC,YAAYA,CAAEC,CAAC,EAAE;IACb,MAAMF,IAAI,GAAGE,CAAC,CAACC,MAAM,CAACC,KAAK,CAAC,CAAC,CAAC;IAC9B,IAAI,CAACN,KAAK,CAACO,QAAQ,CAACL,IAAI,CAAC;EAC7B;EACAM,WAAWA,CAAA,EAAI;IACX,MAAMC,KAAK,GAA