{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\scratch-svg-renderer\\src\\font-converter.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\scratch-svg-renderer\\src\\font-converter.js","mtime":1777528790278},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["convertFonts","svgTag","textElements","collectText","domElement","localName","push","i","childNodes","length","textElement","getAttribute","setAttribute","module","exports"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/node_modules/scratch-svg-renderer/src/font-converter.js"],"sourcesContent":["/**\n * @fileOverview Convert 2.0 fonts to 3.0 fonts.\n */\n\n/**\n * Given an SVG, replace Scratch 2.0 fonts with new 3.0 fonts. Add defaults where there are none.\n * @param {SVGElement} svgTag The SVG dom object\n * @return {void}\n */\nconst convertFonts = function (svgTag) {\n    // Collect all text elements into a list.\n    const textElements = [];\n    const collectText = domElement => {\n        if (domElement.localName === 'text') {\n            textElements.push(domElement);\n        }\n        for (let i = 0; i < domElement.childNodes.length; i++) {\n            collectText(domElement.childNodes[i]);\n        }\n    };\n    collectText(svgTag);\n    // If there's an old font-family, switch to the new one.\n    for (const textElement of textElements) {\n        // If there's no font-family provided, provide one.\n        if (!textElement.getAttribute('font-family') ||\n            textElement.getAttribute('font-family') === 'Helvetica') {\n            textElement.setAttribute('font-family', 'Sans Serif');\n        } else if (textElement.getAttribute('font-family') === 'Mystery') {\n            textElement.setAttribute('font-family', 'Curly');\n        } else if (textElement.getAttribute('font-family') === 'Gloria') {\n            textElement.setAttribute('font-family', 'Handwriting');\n        } else if (textElement.getAttribute('font-family') === 'Donegal') {\n            textElement.setAttribute('font-family', 'Serif');\n        }\n    }\n};\n\nmodule.exports = convertFonts;\n"],"mappings":"AAAA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA,MAAMA,YAAY,GAAG,SAAfA,YAAYA,CAAaC,MAAM,EAAE;EACnC;EACA,MAAMC,YAAY,GAAG,EAAE;EACvB,MAAMC,WAAW,GAAGC,UAAU,IAAI;IAC9B,IAAIA,UAAU,CAACC,SAAS,KAAK,MAAM,EAAE;MACjCH,YAAY,CAACI,IAAI,CAACF,UAAU,CAAC;IACjC;IACA,KAAK,IAAIG,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAGH,UAAU,CAACI,UAAU,CAACC,MAAM,EAAEF,CAAC,EAAE,EAAE;MACnDJ,WAAW,CAACC,UAAU,CAACI,UAAU,CAACD,CAAC,CAAC,CAAC;IACzC;EACJ,CAAC;EACDJ,WAAW,CAACF,MAAM,CAAC;EACnB;EACA,KAAK,MAAMS,WAAW,IAAIR,YAAY,EAAE;IACpC;IACA,IAAI,CAACQ,WAAW,CAACC,YAAY,CAAC,aAAa,CAAC,IACxCD,WAAW,CAACC,YAAY,CAAC,aAAa,CAAC,KAAK,WAAW,EAAE;MACzDD,WAAW,CAACE,YAAY,CAAC,aAAa,EAAE,YAAY,CAAC;IACzD,CAAC,MAAM,IAAIF,WAAW,CAACC,YAAY,CAAC,aAAa,CAAC,KAAK,SAAS,EAAE;MAC9DD,WAAW,CAACE,YAAY,CAAC,aAAa,EAAE,OAAO,CAAC;IACpD,CAAC,MAAM,IAAIF,WAAW,CAACC,YAAY,CAAC,aAAa,CAAC,KAAK,QAAQ,EAAE;MAC7DD,WAAW,CAACE,YAAY,CAAC,aAAa,EAAE,aAAa,CAAC;IAC1D,CAAC,MAAM,IAAIF,WAAW,CAACC,YAAY,CAAC,aAAa,CAAC,KAAK,SAAS,EAAE;MAC9DD,WAAW,CAACE,YAAY,CAAC,aAAa,EAAE,OAAO,CAAC;IACpD;EACJ;AACJ,CAAC;AAEDC,MAAM,CAACC,OAAO,GAAGd,YAAY","ignoreList":[]}]}