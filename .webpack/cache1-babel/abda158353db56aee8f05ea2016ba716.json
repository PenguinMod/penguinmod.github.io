ed') {\n        return 'png';\n    }\n    return 'jpg';\n};\n\nconst toSb2ImageMedia = imageMedia => {\n    if (imageMedia.extension === 'uncompressed') {\n        return new Uint8Array(PNGFile.encode(\n            imageMedia.width,\n            imageMedia.height,\n            imageMedia.decoded\n        ));\n    }\n    return imageMedia.decoded;\n};\n\nconst toSb2SoundMedia = soundMedia => soundMedia.wavEncodedData;\n\nconst toSb2FakeZipApi = ({images, sounds}) => {\n    const files = {};\n\n    let index = 0;\n    for (const image of images) {\n        files[`${index++}.${toSb2ImageExtension(image)}`] = {\n            bytes: toSb2ImageMedia(image)\n        };\n    }\n\n    index = 0;\n    for (const sound of sounds) {\n        files[`${index++}.wav`] = {\n            bytes: toSb2SoundMedia(sound)\n        };\n    }\n\n    return new FakeZip(files);\n};\n\nexport {toSb2FakeZipApi};\n"],"mappings":"AAAA,SAAQA,MAAM,QAAO,gBAAgB;AAErC,SAAQC,OAAO,QAAO,oBAAoB;AAE1C,MAAMC,WAAW,CAAC;EACdC,WAAWA,CAAEC,IAAI,EAAE;IACf,IAAI,CAACA,IAAI,GAAGA,IAAI;EACpB;EAEAC,KAAKA,CAAEC,UAAU,EAAE;IACfN,MAAM,CAACM,UAAU,KAAK,YAAY,EAAE,yCAAyC,CAAC;IAE9E,OAAOC,OAAO,CAACC,OAAO,CAAC,IAAI,CAACJ,IAAI,CAACK,KAAK,CAAC;EAC3C;AACJ;AAEA,SAAQP,WAAW;AAEnB,MAAMQ,OAAO,CAAC;EACVP,WAAWA,CAAEQ,KAAK,EAAE;IAChB,IAAI,CAACA,KAAK,GAAGA,KAAK;EACtB;EAEAP,IAAIA,CAAEA,IAAI,EAAE;IACR,IAAIA,IAAI,IAAI,IAAI,CAACO,KAAK,EAAE;MACpB,OAAO,IAAIT,WAAW,CAAC,IAAI,CAACS,KAAK,CAACP,IAAI,CAAC,CAAC;IAC5C;EACJ;AACJ;AAEA,SAAQM,OAAO;AAEf,MAAME,mBAAmB,GAAGC,UAAU,IAAI;EACtC,IAAIA,UAAU,CAACC,SAAS,KAAK,cAAc,EAAE;IACzC,OAAO,KAAK;EAChB;EACA,OAAO,KAAK;AAChB,CAAC;AAED,MAAMC,eAAe,GAAGF,UAAU,IAAI;EAClC,IAAIA,UAAU,CAACC,SAAS,KAAK,cAAc,EAAE;IACzC,OAAO,IAAIE,UAAU,CAACf,OAAO,CAACgB,MAAM,CAChCJ,UAAU,CAACK,KAAK,EAChBL,UAAU,CAACM,MAAM,EACjBN,UAAU,CAACO,OACf,CAAC,CAAC;EACN;EACA,OAAOP,UAAU,CAACO,OAAO;AAC7B,CAAC;AAED,MAAMC,eAAe,GAAGC,UAAU,IAAIA,UAAU,CAACC,cAAc;AAE/D,MAAMC,eAAe,GAAGC,IAAA,IAAsB;EAAA,IAArB;IAACC,MAAM;IAAEC;EAAM,CAAC,GAAAF,IAAA;EACrC,MAAMd,KAAK,GAA