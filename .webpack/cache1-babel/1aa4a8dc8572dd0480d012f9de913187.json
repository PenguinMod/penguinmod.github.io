{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\lib\\tw-local-backpack-api.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\src\\lib\\tw-local-backpack-api.js","mtime":1777076889304},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["storage","md5","soundThumbnail","arrayBufferToBase64","base64ToArrayBuffer","DATABASE_NAME","DATABASE_VERSION","STORE_NAME","idbItemToBackpackItem","item","id","concat","type","thumbnailUrl","thumbnailData","assetType","bodyUrl","bodyData","mime","AssetType","ImageVector","ImageBitmap","Sound","extension","runtimeFormat","itemMD5","bodyMD5","md5ext","body","builtinHelper","_store","Uint8Array","_db","openDB","Promise","resolve","reject","window","indexedDB","Error","request","open","onupgradeneeded","e","db","target","result","createObjectStore","keyPath","autoIncrement","onsuccess","onerror","error","getBackpackContents","_ref","limit","offset","transaction","store","objectStore","items","openCursor","first","cursor","advance","length","push","value","continue","saveBackpackObject","_ref2","name","thumbnail","idbItem","putRequest","put","deleteBackpackObject","_ref3","deleteRequest","delete","updateBackpackObject","_ref4","getRequest","get","newItem","_objectSpread"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/src/lib/tw-local-backpack-api.js"],"sourcesContent":["import storage from './storage';\nimport md5 from 'js-md5';\nimport {soundThumbnail} from './backpack/sound-payload';\nimport {arrayBufferToBase64, base64ToArrayBuffer} from './tw-base64-utils';\n\n// Special constants -- do not change without care.\nconst DATABASE_NAME = 'TW_Backpack';\nconst DATABASE_VERSION = 1;\nconst STORE_NAME = 'backpack';\n\nconst idbItemToBackpackItem = item => {\n    // convert id to string\n    item.id = `${item.id}`;\n\n    if (item.type === 'sound') {\n        // For sounds, use the local thumbnail instead of what was stored in the backpack.\n        // The thumbnail was updated and it doesn't make sense for already backpacked sounds to\n        // use the old icon instead of the new one.\n        item.thumbnailUrl = `data:;base64,${soundThumbnail}`;\n    } else {\n        // Thumbnail could be any image format. The browser will figure out which format it is.\n        item.thumbnailUrl = `data:;base64,${arrayBufferToBase64(item.thumbnailData)}`;\n    }\n\n    let assetType;\n    if (item.type === 'script') {\n        item.bodyUrl = `data:application/json;base64,${arrayBufferToBase64(item.bodyData)}`;\n    } else if (item.type === 'sprite') {\n        item.bodyUrl = `data:application/zip;base64,${arrayBufferToBase64(item.bodyData)}`;\n    } else if (item.type === 'costume') {\n        if (item.mime === 'image/svg+xml') {\n            assetType = storage.AssetType.ImageVector;\n        } else if (item.mime === 'image/png' || item.mime === 'image/jpeg') {\n            assetType = storage.AssetType.ImageBitmap;\n        }\n    } else if (item.type === 'sound') {\n        assetType = storage.AssetType.Sound;\n    }\n\n    if (assetType) {\n        const extension = assetType.runtimeFormat;\n        const itemMD5 = item.bodyMD5;\n        const md5ext = `${itemMD5}.${extension}`;\n        item.body = md5ext;\n        storage.builtinHelper._store(\n            assetType,\n            extension,\n            new Uint8Array(item.bodyData),\n            itemMD5\n        );\n    }\n\n    return item;\n};\n\nlet _db;\nconst openDB = () => new Promise((resolve, reject) => {\n    if (_db) {\n        resolve(_db);\n        return;\n    }\n\n    if (!window.indexedDB) {\n        reject(new Error('indexedDB is not supported'));\n        return;\n    }\n\n    const request = indexedDB.open(DATABASE_NAME, DATABASE_VERSION);\n\n    request.onupgradeneeded = e => {\n        const db = e.target.result;\n        db.createObjectStore(STORE_NAME, {\n            keyPath: 'id',\n            autoIncrement: true\n        });\n    };\n\n    request.onsuccess = e => {\n        _db = e.target.result;\n        resolve(_db);\n    };\n\n    request.onerror = () => {\n        reject(new Error(`DB error: ${request.error}`));\n    };\n});\n\nconst getBackpackContents = async ({\n    limit,\n    offset\n}) => {\n    const db = await openDB();\n    return new Promise((resolve, reject) => {\n        const transaction = db.transaction(STORE_NAME, 'readonly');\n        transaction.onerror = () => {\n            reject(new Error(`Transaction error: ${transaction.error}`));\n        };\n        const store = transaction.objectStore(STORE_NAME);\n        const items = [];\n        const request = store.openCursor(null, 'prev');\n        let first = true;\n        request.onsuccess = e => {\n            const cursor = e.target.result;\n            if (first) {\n                first = false;\n                if (cursor && offset !== 0) {\n                    cursor.advance(offset);\n                    return;\n                }\n            }\n            if (cursor && items.length < limit) {\n                items.push(idbItemToBackpackItem(cursor.value));\n                cursor.continue();\n            } else {\n                resolve(items);\n            }\n        };\n    });\n};\n\nconst saveBackpackObject = async ({\n    type,\n    mime,\n    name,\n    body,\n    thumbnail\n}) => {\n    const db = await openDB();\n    return new Promise((resolve, reject) => {\n        const transaction = db.transaction(STORE_NAME, 'readwrite');\n        transaction.onerror = () => {\n            reject(new Error(`Transaction error: ${transaction.error}`));\n        };\n        const store = transaction.objectStore(STORE_NAME);\n        const bodyData = base64ToArrayBuffer(body);\n        const bodyMD5 = md5(bodyData);\n        const idbItem = {\n            type,\n            mime,\n            name,\n            bodyData,\n            bodyMD5,\n            thumbnailData: base64ToArrayBuffer(thumbnail)\n        };\n        const putRequest = store.put(idbItem);\n        putRequest.onsuccess = () => {\n            idbItem.id = putRequest.result;\n            resolve(idbItemToBackpackItem(idbItem));\n        };\n    });\n};\n\nconst deleteBackpackObject = async ({\n    id\n}) => {\n    id = +id;\n    const db = await openDB();\n    return new Promise((resolve, reject) => {\n        const transaction = db.transaction(STORE_NAME, 'readwrite');\n        transaction.onerror = () => {\n            reject(new Error(`Transaction error: ${transaction.error}`));\n        };\n        const store = transaction.objectStore(STORE_NAME);\n        // Convert string IDs to number IDs\n        const deleteRequest = store.delete(id);\n        deleteRequest.onsuccess = () => {\n            resolve();\n        };\n    });\n};\n\nconst updateBackpackObject = async ({\n    id,\n    name\n}) => {\n    id = +id;\n    const db = await openDB();\n    return new Promise((resolve, reject) => {\n        const transaction = db.transaction(STORE_NAME, 'readwrite');\n        transaction.onerror = () => {\n            reject(new Error(`Transaction error: ${transaction.error}`));\n        };\n        const store = transaction.objectStore(STORE_NAME);\n        const getRequest = store.get(id);\n        getRequest.onsuccess = () => {\n            const newItem = {\n                ...getRequest.result,\n                name: name\n            };\n            const putRequest = store.put(newItem);\n            putRequest.onsuccess = () => {\n                resolve(idbItemToBackpackItem(newItem));\n            };\n        };\n    });\n};\n\nexport default {\n    getBackpackContents,\n    saveBackpackObject,\n    deleteBackpackObject,\n    updateBackpackObject\n};\n"],"mappings":";;;;;AAAA,OAAOA,OAAO,MAAM,WAAW;AAC/B,OAAOC,GAAG,MAAM,QAAQ;AACxB,SAAQC,cAAc,QAAO,0BAA0B;AACvD,SAAQC,mBAAmB,EAAEC,mBAAmB,QAAO,mBAAmB;;AAE1E;AACA,MAAMC,aAAa,GAAG,aAAa;AACnC,MAAMC,gBAAgB,GAAG,CAAC;AAC1B,MAAMC,UAAU,GAAG,UAAU;AAE7B,MAAMC,qBAAqB,GAAGC,IAAI,IAAI;EAClC;EACAA,IAAI,CAACC,EAAE,MAAAC,MAAA,CAAMF,IAAI,CAACC,EAAE,CAAE;EAEtB,IAAID,IAAI,CAACG,IAAI,KAAK,OAAO,EAAE;IACvB;IACA;IACA;IACAH,IAAI,CAACI,YAAY,mBAAAF,MAAA,CAAmBT,cAAc,CAAE;EACxD,CAAC,MAAM;IACH;IACAO,IAAI,CAACI,YAAY,mBAAAF,MAAA,CAAmBR,mBAAmB,CAACM,IAAI,CAACK,aAAa,CAAC,CAAE;EACjF;EAEA,IAAIC,SAAS;EACb,IAAIN,IAAI,CAACG,IAAI,KAAK,QAAQ,EAAE;IACxBH,IAAI,CAACO,OAAO,mCAAAL,MAAA,CAAmCR,mBAAmB,CAACM,IAAI,CAACQ,QAAQ,CAAC,CAAE;EACvF,CAAC,MAAM,IAAIR,IAAI,CAACG,IAAI,KAAK,QAAQ,EAAE;IAC/BH,IAAI,CAACO,OAAO,kCAAAL,MAAA,CAAkCR,mBAAmB,CAACM,IAAI,CAACQ,QAAQ,CAAC,CAAE;EACtF,CAAC,MAAM,IAAIR,IAAI,CAACG,IAAI,KAAK,SAAS,EAAE;IAChC,IAAIH,IAAI,CAACS,IAAI,KAAK,eAAe,EAAE;MAC/BH,SAAS,GAAGf,OAAO,CAACmB,SAAS,CAACC,WAAW;IAC7C,CAAC,MAAM,IAAIX,IAAI,CAACS,IAAI,KAAK,WAAW,IAAIT,IAAI,CAACS,IAAI,KAAK,YAAY,EAAE;MAChEH,SAAS,GAAGf,OAAO,CAACmB,SAAS,CAACE,WAAW;IAC7C;EACJ,CAAC,MAAM,IAAIZ,IAAI,CAACG,IAAI,KAAK,OAAO,EAAE;IAC9BG,SAAS,GAAGf,OAAO,CAACmB,SAAS,CAACG,KAAK;EACvC;EAEA,IAAIP,SAAS,EAAE;IACX,MAAMQ,SAAS,GAAGR,SAAS,CAACS,aAAa;IACzC,MAAMC,OAAO,GAAGhB,IAAI,CAACiB,OAAO;IAC5B,MAAMC,MAAM,MAAAhB,MAAA,CAAMc,OAAO,OAAAd,MAAA,CAAIY,SAAS,CAAE;IACxCd,IAAI,CAACmB,IAAI,GAAGD,MAAM;IAClB3B,OAAO,CAAC6B,aAAa,CAACC,MAAM,CACxBf,SAAS,EACTQ,SAAS,EACT,IAAIQ,UAAU,CAACtB,IAAI,CAACQ,QAAQ,CAAC,EAC7BQ,OACJ,CAAC;EACL;EAEA,OAAOhB,IAAI;AACf,CAAC;AAED,IAAIuB,GAAG;AACP,MAAMC,MAAM,GAAGA,CAAA,KAAM,IAAIC,OAAO,CAAC,CAACC,OAAO,EAAEC,MAAM,KAAK;EAClD,IAAIJ,GAAG,EAAE;IACLG,OAAO,CAACH,GAAG,CAAC;IACZ;EACJ;EAEA,IAAI,CAACK,MAAM,CAACC,SAAS,EAAE;IACnBF,MAAM,CAAC,IAAIG,KAAK,CAAC,4BAA4B,CAAC,CAAC;IAC/C;EACJ;EAEA,MAAMC,OAAO,GAAGF,