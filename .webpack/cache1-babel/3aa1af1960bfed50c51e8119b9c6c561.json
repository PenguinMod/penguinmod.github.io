etting: ${action.simplifySize}`);\n                return state;\n            }\n            return { brushSize, simplifySize: Math.max(0, action.simplifySize) };\n    default:\n        return state;\n    }\n};\n\n// Action creators ==================================\nconst changeBrushSize = function (brushSize) {\n    return {\n        type: CHANGE_ERASER_SIZE,\n        brushSize: brushSize\n    };\n};\n\nconst changeSimplifySize = function (simplifySize) {\n    return {\n        type: CHANGE_ERASER_SIMPLIFY_SIZE,\n        simplifySize: simplifySize\n    };\n};\n\nexport {\n    reducer as default,\n    changeBrushSize,\n    changeSimplifySize\n};\n"],"mappings":"AAAA,OAAOA,GAAG,MAAM,YAAY;AAE5B,MAAMC,kBAAkB,GAAG,8CAA8C;AACzE,MAAMC,2BAA2B,GAAG,uDAAuD;AAC3F,MAAMC,YAAY,GAAG;EAAEC,SAAS,EAAE,EAAE;EAAEC,YAAY,EAAE;AAAG,CAAC;AAExD,MAAMC,OAAO,GAAG,SAAVA,OAAOA,CAAaC,KAAK,EAAEC,MAAM,EAAE;EACrC,IAAI,OAAOD,KAAK,KAAK,WAAW,EAAEA,KAAK,GAAGJ,YAAY;EACtD,IAAI;IAACE,YAAY;IAAED;EAAS,CAAC,GAAGG,KAAK;EACrC,QAAQC,MAAM,CAACC,IAAI;IACf,KAAKR,kBAAkB;MACnB,IAAIS,KAAK,CAACF,MAAM,CAACJ,SAAS,CAAC,EAAE;QACzBJ,GAAG,CAACW,IAAI,wBAAAC,MAAA,CAAwBJ,MAAM,CAACJ,SAAS,CAAE,CAAC;QACnD,OAAOG,KAAK;MAChB;MACA,OAAO;QAAEH,SAAS,EAAES,IAAI,CAACC,GAAG,CAAC,CAAC,EAAEN,MAAM,CAACJ,SAAS,CAAC;QAAEC;MAAa,CAAC;IACrE,KAAKH,2BAA2B;MAC5B,IAAIQ,KAAK,CAACF,MAAM,CAACH,YAAY,CAAC,EAAE;QAC5BL,GAAG,CAACW,IAAI,8BAAAC,MAAA,CAA8BJ,MAAM,CAACH,YAAY,CAAE,CAAC;QAC5D,OAAOE,KAAK;MAChB;MACA,OAAO;QAAEH,SAAS;QAAEC,YAAY,EAAEQ,IAAI,CAACC,GAAG,CAAC,CAAC,EAAEN,MAAM,CAACH,YAAY;MAAE,CAAC;IAC5E;MACI,OAAOE,KAAK;EAChB;AACJ,CAAC;;AAED;AACA,MAAMQ,eAAe,GAAG,SAAlBA,eAAeA,CAAaX,SAAS,EAAE;EACzC,OAAO;IACHK,IAAI,EAAER,kBAAkB;IACxBG,SAAS,EAAEA;EACf,CAAC;AACL,CAAC;AAED,MAAMY,kBAAkB,GAAG,SAArBA,kBAAkBA,CAAaX,YAAY,EAAE;EAC/C,OAAO;IACHI,IAAI,EAAEP,2BAA2B;IACjCG,YAAY,EAAEA;EAClB,CAAC;AACL,CAAC;AAED,SACIC,OAAO,IAAIW,OAAO,EAClBF,eAAe,EACfC,kBAAkB","ignoreList":[]}]}