());\n    }\n\n    dataFixed () {\n        if (!this._data) {\n            this._data = new ReferenceFixer(this.dataTable()).table;\n        }\n        return this._data;\n    }\n\n    data () {\n        return this.dataFixed()[0];\n    }\n\n    images () {\n        const unique = new Set();\n        return this.dataFixed().filter(obj => {\n            if (obj instanceof ImageMediaData) {\n                if (unique.has(obj.crc)) return false;\n                unique.add(obj.crc);\n                return true;\n            }\n            return false;\n        });\n    }\n\n    sounds () {\n        const unique = new Set();\n        return this.dataFixed().filter(obj => {\n            if (obj instanceof SoundMediaData) {\n                if (unique.has(obj.crc)) return false;\n                unique.add(obj.crc);\n                return true;\n            }\n            return false;\n        });\n    }\n}\n\nexport {SB1File};\n"],"mappings":"AAAA,SAAQA,UAAU,QAAO,sBAAsB;AAE/C,SAAQC,gBAAgB,QAAO,6BAA6B;AAC5D,SAAQC,aAAa,QAAO,yBAAyB;AACrD,SAAQC,YAAY,QAAO,wBAAwB;AACnD,SAAQC,cAAc,QAAO,0BAA0B;AACvD,SAAQC,cAAc,EAAEC,cAAc,QAAO,gBAAgB;AAE7D,SAAQC,eAAe,QAAO,mBAAmB;AACjD,SAAQC,SAAS,QAAO,yBAAyB;AAEjD,SAAQC,SAAS,EAAEC,YAAY,QAAO,oBAAoB;AAE1D,MAAMC,OAAO,CAAC;EACVC,WAAWA,CAAEC,MAAM,EAAE;IACjB,IAAI,CAACA,MAAM,GAAGA,MAAM;IACpB,IAAI,CAACC,MAAM,GAAG,IAAId,UAAU,CAACa,MAAM,CAAC;IAEpC,IAAI,CAACE,SAAS,GAAG,IAAI,CAACD,MAAM,CAACE,UAAU,CAACN,YAAY,CAAC;IACrD,IAAI,CAACK,SAAS,CAACE,QAAQ,CAAC,CAAC;IAEzB,IAAI,CAACC,UAAU,GAAG,IAAI,CAACJ,MAAM,CAACE,UAAU,CAACP,SAAS,CAAC;IACnD,IAAI,CAACS,UAAU,CAACD,QAAQ,CAAC,CAAC;IAE1B,IAAI,CAACH,MAAM,CAACK,QAAQ,IAAI,IAAI,CAACJ,SAAS,CAACK,cAAc,GAAGX,SAAS,CAACY,IAAI;IAEtE,IAAI,CAACC,UAAU,GAAG,IAAI,CAACR,MAAM,CAACE,UAAU,CAACP,SAAS,CAAC;IACnD,IAAI,CAACa,UAAU,CAACL,QAAQ,CAAC,CAAC;EAC9B;EAEA,IAAIM,IAAIA,CAAA,EAAI;IACR,OAAOf,SAAS,CAAC;MACbgB,IAAI,EAAE,IAAI,CAACA,IAAI,CAAC,CAAC;MACjBC,SAAS,EAAE,IAAI,CAACC,IAAI,CAAC,CAAC;MACtBC,MAAM,EAAE,IAAI,CAACA,MAAM,CAAC,CAAC;MACrBC,MAAM,E