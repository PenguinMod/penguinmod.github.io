       pointer: PropTypes.number.isRequired\n        })\n    };\n\n    const mapStateToProps = state => ({\n        format: state.scratchPaint.format,\n        undoState: state.scratchPaint.undo\n    });\n    const mapDispatchToProps = dispatch => ({\n        setSelectedItems: format => {\n            dispatch(setSelectedItems(getSelectedLeafItems(), isBitmap(format)));\n        },\n        onUndo: format => {\n            dispatch(undo(format));\n        },\n        onRedo: format => {\n            dispatch(redo(format));\n        }\n    });\n\n    return connect(\n        mapStateToProps,\n        mapDispatchToProps\n    )(UndoWrapper);\n};\n\nexport default UndoHOC;\n"],"mappings":";AAAA,OAAOA,OAAO,MAAM,gBAAgB;AACpC,OAAOC,SAAS,MAAM,YAAY;AAClC,OAAOC,KAAK,MAAM,OAAO;AACzB,OAAOC,IAAI,MAAM,aAAa;AAC9B,SAAQC,OAAO,QAAO,aAAa;AAEnC,SAAQC,oBAAoB,QAAO,qBAAqB;AACxD,SAAQC,gBAAgB,IAAhBA,iBAAgB,QAAO,4BAA4B;AAC3D,SACIC,WAAW,EAAEC,WAAW,EAAEC,cAAc,EAAEC,cAAc,QACrD,gBAAgB;AACvB,SAAQC,IAAI,EAAEC,IAAI,QAAO,kBAAkB;AAE3C,OAAOC,OAAO,IAAGC,QAAQ,QAAO,eAAe;AAE/C,MAAMC,OAAO,GAAG,SAAVA,OAAOA,CAAaC,gBAAgB,EAAE;EACxC,MAAMC,WAAW,SAASf,KAAK,CAACgB,SAAS,CAAC;IACtCC,WAAWA,CAAEC,KAAK,EAAE;MAChB,KAAK,CAACA,KAAK,CAAC;MACZpB,OAAO,CAAC,IAAI,EAAE,CACV,YAAY,EACZ,YAAY,EACZ,wBAAwB,EACxB,gBAAgB,EAChB,gBAAgB,CACnB,CAAC;IACN;IACAqB,UAAUA,CAAA,EAAI;MACVd,WAAW,CAAC,IAAI,CAACa,KAAK,CAACE,SAAS,EAAE,IAAI,CAACF,KAAK,CAACG,MAAM,EAAE,IAAI,CAACC,sBAAsB,EAAE,IAAI,CAACJ,KAAK,CAACK,aAAa,CAAC;IAC/G;IACAC,UAAUA,CAAA,EAAI;MACVlB,WAAW,CAAC,IAAI,CAACY,KAAK,CAACE,SAAS,EAAE,IAAI,CAACF,KAAK,CAACO,MAAM,EAAE,IAAI,CAACH,sBAAsB,EAAE,IAAI,CAACJ,KAAK,CAACK,aAAa,CAAC;IAC/G;IACAD,sBAAsBA,CAAA,EAAI;MACtB,IAAI,CAACJ,KAAK,CAACd,gBAAgB,CAAC,IAAI,CAACc,KAAK,CAACQ,MAAM,CAAC;IAClD;IACAnB,cAAcA,CAAA,EAAI;MACd,OAAOA,cAAc,CAAC,IAAI,CAACW,KAAK,CAACE,SAAS,CAAC;IAC/C;IACAZ,cAAcA,CAAA,EAAI;MACd,OAAOA,cAAc,CAAC,IAAI,CAACU,KAAK,CAACE,SAAS,CAAC;IAC/C;IACAO,MAAMA,CAAA,EAAI;MACN,MAAMC,cAAc,GAAG3B,IAAI,CAAC,IAAI,CAACiB,KAAK,EAAE,CACpC,QAAQ,EACR,QAAQ,EACR,QA