coder().encode(fixed).buffer;\n        }\n        return fileData;\n    } catch (e) {\n        return fileData;\n    }\n};\n\nexport default fixSVG;\n"],"mappings":"AAAA,SAAQA,WAAW,EAAEC,WAAW,QAAO,mBAAmB;AAE1D,MAAMC,MAAM,GAAGC,QAAQ,IAAI;EACvB;EACA;EACA;EACA,IAAI;IACA,MAAMC,KAAK,GAAG,IAAIC,UAAU,CAACF,QAAQ,CAAC;IACtC,MAAMG,GAAG,GAAG,IAAIN,WAAW,CAAC,CAAC,CAACO,MAAM,CAACH,KAAK,CAAC;IAC3C,MAAMI,WAAW,GAAG,IAAIC,SAAS,CAAC,CAAC,CAACC,eAAe,CAACJ,GAAG,EAAE,UAAU,CAAC;IACpE,MAAMK,UAAU,GAAGH,WAAW,CAACI,QAAQ,CAAC,CAAC,CAAC;IAC1C,IACID,UAAU,CAACE,MAAM,CAACC,OAAO,CAACC,aAAa,KAAK,MAAM,IAClDJ,UAAU,CAACK,KAAK,CAACF,OAAO,CAACC,aAAa,KAAK,MAAM,EACnD;MACEJ,UAAU,CAACM,eAAe,CAAC,QAAQ,CAAC;MACpCN,UAAU,CAACM,eAAe,CAAC,OAAO,CAAC;MACnC,MAAMC,KAAK,GAAGV,WAAW,CAACW,eAAe,CAACC,SAAS;MACnD,OAAO,IAAInB,WAAW,CAAC,CAAC,CAACoB,MAAM,CAACH,KAAK,CAAC,CAACI,MAAM;IACjD;IACA,OAAOnB,QAAQ;EACnB,CAAC,CAAC,OAAOoB,CAAC,EAAE;IACR,OAAOpB,QAAQ;EACnB;AACJ,CAAC;AAED,eAAeD,MAAM","ignoreList":[]}]}