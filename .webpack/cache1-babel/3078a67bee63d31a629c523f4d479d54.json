/\n    [Symbol.iterator] () {\n        return this;\n    }\n\n    /**\n     * @returns {{value: *, done: boolean}} - Return the next value or indicate\n     * the Iterator has reached its end.\n     */\n    next () {\n        if (this.iter.stream.position >= this.maxPosition) {\n            return {\n                value: null,\n                done: true\n            };\n        }\n\n        return this.iter.next();\n    }\n}\n\nexport {ByteTakeIterator};\n"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAMA,gBAAgB,CAAC;EACnB;AACJ;AACA;AACA;AACA;EACIC,WAAWA,CAAEC,IAAI,EAA0B;IAAA,IAAxBC,WAAW,GAAAC,SAAA,CAAAC,MAAA,QAAAD,SAAA,QAAAE,SAAA,GAAAF,SAAA,MAAGG,QAAQ;IACrC,IAAI,CAACL,IAAI,GAAGA,IAAI;IAChB,IAAI,CAACC,WAAW,GAAGA,WAAW;EAClC;;EAEA;AACJ;AACA;EACI,CAACK,MAAM,CAACC,QAAQ,IAAK;IACjB,OAAO,IAAI;EACf;;EAEA;AACJ;AACA;AACA;EACIC,IAAIA,CAAA,EAAI;IACJ,IAAI,IAAI,CAACR,IAAI,CAACS,MAAM,CAACC,QAAQ,IAAI,IAAI,CAACT,WAAW,EAAE;MAC/C,OAAO;QACHU,KAAK,EAAE,IAAI;QACXC,IAAI,EAAE;MACV,CAAC;IACL;IAEA,OAAO,IAAI,CAACZ,IAAI,CAACQ,IAAI,CAAC,CAAC;EAC3B;AACJ;AAEA,SAAQV,gBAAgB","ignoreList":[]}]}