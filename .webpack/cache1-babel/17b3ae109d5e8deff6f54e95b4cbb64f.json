{"remainingRequest":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js??ref--4-1!C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\scratch-paint\\src\\lib\\tw-color-utils.js","dependencies":[{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\scratch-paint\\src\\lib\\tw-color-utils.js","mtime":1777529319119},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1777526548307},{"path":"C:\\Users\\cryst\\Documents\\GitHub\\gaiamod-main.github.io\\node_modules\\babel-loader\\lib\\index.js","mtime":1777526570497}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["parseColorLib","TRANSPARENT_BLACK","rgba","hex","parseColor","color","test","hexPart","substring","toLowerCase","length","split","map","char","join","red","parseInt","green","blue","alpha","concat","result","makeAlphaComponent","Math","round","toString","padStart","colorToHex","parsed"],"sources":["C:/Users/cryst/Documents/GitHub/gaiamod-main.github.io/node_modules/scratch-paint/src/lib/tw-color-utils.js"],"sourcesContent":["import parseColorLib from 'parse-color';\n\n/**\n * @typedef ParsedColor\n * @property {[number, number, number, number]} rgba red, green, and blue from 0-255, alpha from 0-1\n * @property {string} hex Color in the format \"#abc123\", no alpha channel\n */\n\nconst TRANSPARENT_BLACK = {\n    rgba: [0, 0, 0, 0],\n    hex: '#000000'\n};\n\n/**\n * @param {string} color Color in any format.\n * @returns {ParsedColor} Parsed color object.\n */\nconst parseColor = color => {\n    if (/^#[a-f0-9]{3,8}$/i.test(color)) {\n        // parse-color does not handle opacity well in hex colors, so we will parse them ourselves.\n        let hexPart = color.substring(1).toLowerCase();\n\n        if (hexPart.length === 3 || hexPart.length === 4) {\n            // Double each character, eg. 08A -> 0088AA\n            hexPart = hexPart\n                .split('')\n                .map(char => char + char)\n                .join('');\n        }\n\n        const red = parseInt(hexPart.substring(0, 2), 16);\n        const green = parseInt(hexPart.substring(2, 4), 16);\n        const blue = parseInt(hexPart.substring(4, 6), 16);\n        let alpha = 1;\n        if (hexPart.length === 8) {\n            alpha = parseInt(hexPart.substring(6, 8), 16) / 255;\n        }\n\n        return {\n            rgba: [red, green, blue, alpha],\n            hex: `#${hexPart.substring(0, 6)}`\n        };\n    }\n\n    const result = parseColorLib(color);\n    if (!result.rgba) {\n        return TRANSPARENT_BLACK;\n    }\n    return result;\n};\n\n/**\n * @param {number} alpha Alpha channel from 0-1\n * @returns {string} String to use for creating an 8-digit hex color code.\n */\nconst makeAlphaComponent = alpha => Math.round(alpha * 255)\n    .toString(16)\n    .padStart(2, '0');\n\n/**\n * @param {string} color Color in any format.\n * @returns {string} Color as either a 6-digit hex code or 8-digit hex code if it has an alpha channel.\n */\nconst colorToHex = color => {\n    const parsed = parseColor(color);\n    const hex = parsed.hex;\n    const alpha = parsed.rgba[3];\n    if (alpha < 1) {\n        return `${hex}${makeAlphaComponent(alpha)}`;\n    }\n    return hex;\n};\n\nexport {\n    makeAlphaComponent,\n    colorToHex\n};\n"],"mappings":"AAAA,OAAOA,aAAa,MAAM,aAAa;;AAEvC;AACA;AACA;AACA;AACA;;AAEA,MAAMC,iBAAiB,GAAG;EACtBC,IAAI,EAAE,CAAC,CAAC,EAAE,CAAC,EAAE,CAAC,EAAE,CAAC,CAAC;EAClBC,GAAG,EAAE;AACT,CAAC;;AAED;AACA;AACA;AACA;AACA,MAAMC,UAAU,GAAGC,KAAK,IAAI;EACxB,IAAI,mBAAmB,CAACC,IAAI,CAACD,KAAK,CAAC,EAAE;IACjC;IACA,IAAIE,OAAO,GAAGF,KAAK,CAACG,SAAS,CAAC,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC;IAE9C,IAAIF,OAAO,CAACG,MAAM,KAAK,CAAC,IAAIH,OAAO,CAACG,MAAM,KAAK,CAAC,EAAE;MAC9C;MACAH,OAAO,GAAGA,OAAO,CACZI,KAAK,CAAC,EAAE,CAAC,CACTC,GAAG,CAACC,IAAI,IAAIA,IAAI,GAAGA,IAAI,CAAC,CACxBC,IAAI,CA