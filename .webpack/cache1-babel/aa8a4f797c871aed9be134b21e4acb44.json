s: state.items,\n            pasteOffset: state.pasteOffset + 1\n        };\n    case CLEAR_PASTE_OFFSET:\n        return {\n            items: state.items,\n            pasteOffset: 0\n        };\n    default:\n        return state;\n    }\n};\n\n// Action creators ==================================\nconst setClipboardItems = function (clipboardItems) {\n    return {\n        type: SET,\n        clipboardItems: clipboardItems\n    };\n};\n\nconst incrementPasteOffset = function () {\n    return {\n        type: INCREMENT_PASTE_OFFSET\n    };\n};\n\nconst clearPasteOffset = function () {\n    return {\n        type: CLEAR_PASTE_OFFSET\n    };\n};\n\nexport {\n    reducer as default,\n    setClipboardItems,\n    incrementPasteOffset,\n    clearPasteOffset\n};\n"],"mappings":"AAAA,OAAOA,GAAG,MAAM,YAAY;AAE5B,MAAMC,GAAG,GAAG,6BAA6B;AACzC,MAAMC,sBAAsB,GAAG,gDAAgD;AAC/E,MAAMC,kBAAkB,GAAG,4CAA4C;AACvE,MAAMC,YAAY,GAAG;EACjBC,KAAK,EAAE,EAAE;EACTC,WAAW,EAAE;AACjB,CAAC;AAED,MAAMC,OAAO,GAAG,SAAVA,OAAOA,CAAaC,KAAK,EAAEC,MAAM,EAAE;EACrC,IAAI,OAAOD,KAAK,KAAK,WAAW,EAAEA,KAAK,GAAGJ,YAAY;EACtD,QAAQK,MAAM,CAACC,IAAI;IACnB,KAAKT,GAAG;MACJ,IAAI,CAACQ,MAAM,CAACE,cAAc,IAAI,EAAEF,MAAM,CAACE,cAAc,YAAYC,KAAK,CAAC,IAAIH,MAAM,CAACE,cAAc,CAACE,MAAM,KAAK,CAAC,EAAE;QAC3Gb,GAAG,CAACc,IAAI,gCAAgC,CAAC;QACzC,OAAON,KAAK;MAChB;MACA,OAAO;QACHH,KAAK,EAAEI,MAAM,CAACE,cAAc;QAC5BL,WAAW,EAAE;MACjB,CAAC;IACL,KAAKJ,sBAAsB;MACvB,OAAO;QACHG,KAAK,EAAEG,KAAK,CAACH,KAAK;QAClBC,WAAW,EAAEE,KAAK,CAACF,WAAW,GAAG;MACrC,CAAC;IACL,KAAKH,kBAAkB;MACnB,OAAO;QACHE,KAAK,EAAEG,KAAK,CAACH,KAAK;QAClBC,WAAW,EAAE;MACjB,CAAC;IACL;MACI,OAAOE,KAAK;EAChB;AACJ,CAAC;;AAED;AACA,MAAMO,iBAAiB,GAAG,SAApBA,iBAAiBA,CAAaJ,cAAc,EAAE;EAChD,OAAO;IACHD,IAAI,EAAET,GAAG;IACTU,cAAc,EAAEA;EACpB,CAAC;AACL,CAAC;AAED,MAAMK,oBAAoB,GAAG,SAAvBA,oBAAoBA,CAAA,EAAe;EACrC,OAAO;IACHN,IAAI,EAAER;EACV,CAAC;AACL,CAAC;AAED,MAAMe,gBAAgB,GAAG,SAAnBA,gBAAgBA,CAAA,EAAe;EACjC,OAAO;IACHP,IAAI,EAAEP;EACV,CAAC;AACL,CAAC;AAED,SACII,OAAO,IAAIW,OAAO,EAClBH,iBAAiB,EACjBC,oBAAoB